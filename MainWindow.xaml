<hc:Window x:Class="断面毛刺检测软件.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:断面毛刺检测软件"
        Title="MainWindow"
        Width="1400"
        Height="850"
        Icon="/Resources/logo3.png"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
   
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="75" />
            <RowDefinition />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <!-- 菜单栏 -->
        <Menu Grid.Row="0" MouseMove="Menu_MouseMove">
            <MenuItem Header="工程管理" Foreground="White">
                <MenuItem Width="150" Header="新建工程" />
                <MenuItem Width="150" Header="打开工程" />
                <MenuItem Width="150" Header="保存工程" />
                <MenuItem Width="150" Header="另存工程" />
                <MenuItem Width="150" Header="修改工程" />
                <MenuItem Width="150" Header="最近打开" />
            </MenuItem>
            <MenuItem Header="图片管理" Foreground="White" />
            <MenuItem Header="相机与通讯" Foreground="White" />
        </Menu>
        <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="45"
                    Height="25"
                    Padding="0"
                    hc:BorderElement.CornerRadius="0"
                    Content="－"
                    FontSize="20"
                    BorderThickness="0"
                   
                     Click="MainWindow_Minimum" />
            <hc:Divider Width="1" />
            <Button Width="45"
                    Height="25"
                    Padding="0"
                    hc:BorderElement.CornerRadius="0"
                    Content="□"
                    FontSize="17"
                    BorderThickness="0"
                    
                    Click="MainWindow_Maxmum" />
            <hc:Divider Width="1" />
            <Button Width="45"
                    Height="25"
                    Padding="0"
                    hc:BorderElement.CornerRadius="0"
                    Content="✖"
                    FontSize="10"
                    BorderThickness="0"
                   
                    Click="MainWindow_Close" />
        </StackPanel>
        <TextBlock Grid.Row="0" d:Text="毛刺检测" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFC8CEFF"/>
        <!-- 次菜单栏 -->
        <DockPanel Grid.Row="1">
           
            <StackPanel Width="150" HorizontalAlignment="Left">
                <Image Margin="5" HorizontalAlignment="Left" Source="/Resources/组合-2.png" />
                <TextBlock HorizontalAlignment="Center" Text="Version:1.0.0.0" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1">
                    <TextBlock Margin="5,5,5,0" Text="系统时间" />
                    <TextBlock HorizontalAlignment="Center" Text="09:50:59" />
                    <TextBlock Margin="5,0" Text="运行时间" />
                    <TextBlock HorizontalAlignment="Center" Text="01:20:01" />
                </StackPanel>
                <StackPanel Grid.Column="2" Width="80">
                    <Button Width="50"
                            Height="50"
                            Margin="5"
                           
                            BorderBrush="Red" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                        <TextBlock Text="99" />
                        <TextBlock Text="分钟" />
                        <TextBlock Text="59" />
                        <TextBlock Text="秒" />
                    </StackPanel>
                </StackPanel>
            </Grid>

        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <UniformGrid Grid.Column="0" Rows="2">
                <hc:SimplePanel Background="Orange"/>
                <hc:SimplePanel Background="Yellow"/>
            </UniformGrid>
            <!--中间设置栏-->
            <hc:TabControl Grid.Column="1" SelectedIndex="0" IsAnimationEnabled="True" IsTabFillEnabled="True"  Style="{DynamicResource TabControlInLine}">
                <hc:TabItem Header="检测区">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="质量等级">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="检测设置">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="报警设置">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="打标设置">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="运动控制">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="回放">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
            </hc:TabControl>
            <!--右侧统计栏 消息栏 离线-->
            <hc:TabControl Grid.Column="2"  SelectedIndex="0" IsAnimationEnabled="True" IsTabFillEnabled="True"  Style="{DynamicResource TabControlInLine}">
                <hc:TabItem Header="缺陷统计列表">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="系统消息">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="离线检测">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
            </hc:TabControl>
        </Grid>
        <!-- 状态栏 -->
        <DockPanel Grid.Row="3" >
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="5,0">
                <TextBlock Text="算法:" />
                <TextBlock Margin="2,0" Text="50" />
                <TextBlock Text="ms" />
                <TextBlock Margin="10,0,0,0" Text="过滤:" />
                <TextBlock Margin="2,0" Text="50" />
                <TextBlock Text="ms" />

            </StackPanel>
            <Grid Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="5,0"
                           HorizontalAlignment="Right"
                           Text="项目路径:" />
                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Right"
                           Text="C:\User\AppData\..."
                           Foreground="#FFCAE1FF" />
            </Grid>
        </DockPanel>


    </Grid>
</hc:Window>
