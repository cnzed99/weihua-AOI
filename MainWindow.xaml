<Window x:Class="断面毛刺检测软件.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:断面毛刺检测软件"
        Title="MainWindow"
        Width="1400"
        Height="850"
        Icon="/Resources/logo3.png"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#FF1C1C26"
        Foreground="White"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="75" />
            <RowDefinition />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <!-- 菜单栏 -->
        <Menu Grid.Row="0" Background="#FF6C7CFF" Foreground="White" MouseMove="Menu_MouseMove">
            <MenuItem Header="工程管理" Foreground="White">
                <MenuItem Width="150" Header="新建工程" />
                <MenuItem Width="150" Header="打开工程" />
                <MenuItem Width="150" Header="保存工程" />
                <MenuItem Width="150" Header="另存工程" />
                <MenuItem Width="150" Header="修改工程" />
                <MenuItem Width="150" Header="最近打开" />
            </MenuItem>
            <MenuItem Header="图片管理" Foreground="White" />
            <MenuItem Header="相机与通讯" Foreground="White" />
        </Menu>
        <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="25"
                    Height="25"
                    Padding="0"
                    hc:BorderElement.CornerRadius="0"
                    Content="－"
                    FontSize="20"
                    BorderThickness="0"
                    Background="#FF9EA8FB"
                     Click="MainWindow_Minimum" />
            <hc:Divider Width="1" />
            <Button Width="25"
                    Height="25"
                    Padding="0"
                    hc:BorderElement.CornerRadius="0"
                    Content="□"
                    FontSize="17"
                    BorderThickness="0"
                    Background="#FF9EA8FB"
                    Click="MainWindow_Maxmum" />
            <hc:Divider Width="1" />
            <Button Width="25"
                    Height="25"
                    Padding="0"
                    hc:BorderElement.CornerRadius="0"
                    Content="✖"
                    FontSize="10"
                    BorderThickness="0"
                    Background="#FF9EA8FB"
                    Click="MainWindow_Close" />
        </StackPanel>
        <TextBlock Grid.Row="0" d:Text="毛刺检测" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFC8CEFF"/>
        <!-- 次菜单栏 -->
        <DockPanel Grid.Row="1" Background="#FFC8CEFF">
            <DockPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Black" />
                </Style>
            </DockPanel.Resources>
            <StackPanel Width="150" HorizontalAlignment="Left">
                <Image Margin="5" HorizontalAlignment="Left" Source="/Resources/组合-2.png" />
                <TextBlock HorizontalAlignment="Center" Text="Version:1.0.0.0" Foreground="Black" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1">
                    <TextBlock Margin="5,5,5,0" Text="系统时间" />
                    <TextBlock HorizontalAlignment="Center" Text="09:50:59" />
                    <TextBlock Margin="5,0" Text="运行时间" />
                    <TextBlock HorizontalAlignment="Center" Text="01:20:01" />
                </StackPanel>
                <StackPanel Grid.Column="2" Width="80">
                    <Button Width="50"
                            Height="50"
                            Margin="5"
                            Background="#FF8BE2A0"
                            BorderBrush="Red" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                        <TextBlock Text="99" />
                        <TextBlock Text="分钟" />
                        <TextBlock Text="59" />
                        <TextBlock Text="秒" />
                    </StackPanel>
                </StackPanel>
            </Grid>

        </DockPanel>

        <!-- 状态栏 -->
        <DockPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="算法:" />
                <TextBlock Margin="2,0" Text="50" />
                <TextBlock Text="ms" />
                <TextBlock Margin="10,0,0,0" Text="过滤:" />
                <TextBlock Margin="2,0" Text="50" />
                <TextBlock Text="ms" />

            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="5,0"
                           HorizontalAlignment="Right"
                           Text="项目路径:" />
                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Right"
                           Text="C:\User\AppData\..."
                           Foreground="SkyBlue" />
            </Grid>
        </DockPanel>


    </Grid>
</Window>
