<UserControl
    x:Class="SDFilter.SDFilterCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cov="clr-namespace:ValueConverters;assembly=ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SDFilter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wh="http://whzn.com/rjkf/2024/xaml"
    d:DesignHeight="450"
    d:DesignWidth="550"
    mc:Ignorable="d">
    <d:UserControl.DataContext>
        <local:CSDFilterCtrlVM />
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <cov:BoolToBrushConverter x:Key="BoolToBrushConverterEx" TrueValue="{DynamicResource ExpanderBrush}">
                <cov:BoolToBrushConverter.FalseValue>
                    <LinearGradientBrush MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="Red" />
                        <GradientStop Offset="1" Color="{DynamicResource ExpanderColor}" />
                    </LinearGradientBrush>
                </cov:BoolToBrushConverter.FalseValue>
            </cov:BoolToBrushConverter>
            <cov:BoolToBrushConverter
                x:Key="BoolToBrushConverterBd"
                FalseValue="Red"
                TrueValue="Transparent" />
            <cov:BoolToStringConverter
                x:Key="BoolToStringConverter"
                FalseValue="+"
                TrueValue="-" />
            <local:ColoectionIndexConverter x:Key="ColoectionIndexConverter" />
            <entity:CommMultiParamConverter x:Key="CommMultiParamConverter" />
            <Style
                x:Key="Button"
                BasedOn="{StaticResource ButtonPrimary}"
                TargetType="Button">
                <Setter Property="BorderThickness" Value="1" />

                <Setter Property="Padding" Value="8,5,8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
            </Style>
            <Style
                x:Key="DelButton"
                BasedOn="{StaticResource ButtonDanger}"
                TargetType="Button">
                <Setter Property="BorderThickness" Value="1" />

                <Setter Property="Padding" Value="8,5,8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
            </Style>
            <Style
                x:Key="TextBlock1"
                BasedOn="{StaticResource TextBlockDefault}"
                TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style
                x:Key="TextBlock2"
                BasedOn="{StaticResource TextBlockDefault}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SelectConfig" TargetType="ItemsControl">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="10,7,10,7" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TextBlockDefault}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ColoectionIndexConverter}" ConverterParameter="or">
                                            <Binding />
                                            <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            <Binding Path="SelectParams.Count" />
                                            <Binding Path="ItemsSource.Count" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding SelectParams}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <WrapPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource TextBlockDefault}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource ColoectionIndexConverter}" ConverterParameter="and">
                                                            <Binding />
                                                            <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            <Binding Path="ItemsSource.Count" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource TextBlockDefault}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{5}" UpdateSourceTrigger="PropertyChanged">
                                                            <Binding Path="Character" />
                                                            <Binding Path="Min" />
                                                            <Binding Path="Max" />
                                                            <Binding Path="MaxLimit" />
                                                            <Binding Path="MinLimit" />
                                                            <Binding />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </WrapPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer DataContext="{Binding FilterConfig}" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding SpeciesFilters}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander
                        hc:BorderElement.CornerRadius="0"
                        Background="{Binding Result, Converter={StaticResource BoolToBrushConverterEx}}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        IsExpanded="True"
                        Visibility="{Binding ReadOnly, Converter={StaticResource Boolean2VisibilityReConverter}}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TextBlock1}" Text="{Binding RelativeSource={RelativeSource AncestorType=Expander}, Path=IsExpanded, Converter={StaticResource BoolToStringConverter}}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource TextBlock1}"
                                    Text="{Binding Name}" />
                                <Button
                                    Grid.Column="2"
                                    Margin="2"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.AddFilterCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding [AddDefect], Source={x:Static local:CLang.s_Instance}}"
                                    IsEnabled="{Binding IsTechnologist, Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                                    Style="{DynamicResource Button}" />
                            </Grid>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding RecipeDefects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl Margin="15,0,2,3" ItemsSource="{Binding DefectFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition MinHeight="15" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="70" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="3"
                                                            Height="20"
                                                            Background="{Binding ShowColor.Brush}"
                                                            BorderBrush="{DynamicResource PrimaryTextBrush}"
                                                            BorderThickness="0" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="5,0"
                                                            Style="{DynamicResource TextBlock2}"
                                                            Text="{Binding Name}" />
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <TextBlock
                                                                Margin="15,0,0,0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="Gray">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0}:{1}">
                                                                        <Binding Path="[Algorithm]" Source="{x:Static local:CLang.s_Instance}" />
                                                                        <Binding Path="DataContext.Name" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock
                                                                Margin="15,0,0,0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="Gray">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0}:{1}">
                                                                        <Binding Path="[QualityLevel]" Source="{x:Static local:CLang.s_Instance}" />
                                                                        <Binding Path="QualityLevel.Name" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock
                                                                Margin="15,0,0,0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="Gray">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0}:{1}">
                                                                        <Binding Path="[Priority]" Source="{x:Static local:CLang.s_Instance}" />
                                                                        <Binding Path="Priority" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button
                                                            Grid.Column="3"
                                                            Width="55"
                                                            Margin="5,2,0,0"
                                                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.EditFilterCommand}"
                                                            Content="{Binding [Edit], Source={x:Static local:CLang.s_Instance}}"
                                                            IsEnabled="{Binding IsTechnologist, Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                                                            Style="{DynamicResource Button}">
                                                            <Button.CommandParameter>
                                                                <MultiBinding Converter="{StaticResource CommMultiParamConverter}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl, AncestorLevel=2}" />
                                                                </MultiBinding>
                                                            </Button.CommandParameter>
                                                        </Button>
                                                        <Button
                                                            Grid.Column="4"
                                                            Width="55"
                                                            Margin="5,2,5,0"
                                                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.RemoveFilterCommand}"
                                                            Content="{Binding [Delete], Source={x:Static local:CLang.s_Instance}}"
                                                            IsEnabled="{Binding IsTechnologist, Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                                                            Style="{DynamicResource DelButton}">
                                                            <Button.CommandParameter>
                                                                <MultiBinding Converter="{StaticResource CommMultiParamConverter}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Button.CommandParameter>
                                                        </Button>
                                                    </Grid>
                                                    <Border
                                                        Grid.Row="1"
                                                        Margin="10,0,10,5"
                                                        Padding="0.5">
                                                        <ItemsControl AlternationCount="10000" ItemsSource="{Binding FilterList}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition />
                                                                            <ColumnDefinition />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border
                                                                            Grid.Column="0"
                                                                            Background="{Binding Result, Converter={StaticResource BoolToBrushConverterBd}}"
                                                                            BorderBrush="{DynamicResource SecondaryBorderBrush}"
                                                                            BorderThickness="1">
                                                                            <TextBlock FontSize="12" Style="{DynamicResource TextBlock2}">
                                                                                <TextBlock.Text>
                                                                                    <MultiBinding StringFormat="{}{0}{1}">
                                                                                        <Binding Path="[DefectFilter]" Source="{x:Static local:CLang.s_Instance}" />
                                                                                        <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                                                                                    </MultiBinding>
                                                                                </TextBlock.Text>
                                                                            </TextBlock>
                                                                        </Border>
                                                                        <Border
                                                                            Grid.Column="1"
                                                                            Background="{Binding Result, Converter={StaticResource BoolToBrushConverterBd}}"
                                                                            BorderBrush="{DynamicResource SecondaryBorderBrush}"
                                                                            BorderThickness="1">
                                                                            <ItemsControl
                                                                                FontSize="12"
                                                                                ItemsSource="{Binding Filter}"
                                                                                Style="{DynamicResource SelectConfig}" />
                                                                        </Border>
                                                                        <Border
                                                                            Grid.Column="2"
                                                                            Background="{Binding Result, Converter={StaticResource BoolToBrushConverterBd}}"
                                                                            BorderBrush="{DynamicResource SecondaryBorderBrush}"
                                                                            BorderThickness="1">
                                                                            <ItemsControl
                                                                                FontSize="12"
                                                                                ItemsSource="{Binding SelectList}"
                                                                                Style="{DynamicResource SelectConfig}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
