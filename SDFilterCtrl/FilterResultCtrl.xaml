<UserControl
    x:Class="SDFilter.FilterResultCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SDFilter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="clr-namespace:ValueConverters;assembly=ValueConverters"
    d:DesignHeight="450"
    d:DesignWidth="550"
    mc:Ignorable="d">
    <d:UserControl.DataContext>
        <local:SDFilterCtrlVM />
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <entity:StringAttrEnumConverter x:Key="StringAttrEnumConverter" />
            <local:TextUnitsConverter x:Key="TextUnitsConverter" />
            <local:ValueHalfConverter x:Key="ValueHalfConverter" />
            <conv:BoolToBrushConverter x:Key="BoolToBrushConverterEx" TrueValue="{DynamicResource ThirdlyRegionBrush}" FalseValue="Red"/>
            <conv:BoolToBrushConverter x:Key="BoolToBrushConverterText" TrueValue="{DynamicResource InfoBrush}" FalseValue="Red"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <hc:ScrollViewer IsInertiaEnabled="True" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilterConfig.SpeciesFilters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander
                            Margin="0,0,0,1"
                            hc:BorderElement.CornerRadius="0"
                            Background="{Binding Result, Converter={StaticResource BoolToBrushConverterEx}}"
                            BorderThickness="0"
                            Foreground="White"
                            Header="{Binding Name}"
                            IsExpanded="True">
                            <ItemsControl ItemsSource="{Binding RecipeDefects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Left" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding DefectFilters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Left" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander
                                                        Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualWidth, Converter={StaticResource ValueHalfConverter}, Mode=OneWay}"
                                                        hc:BorderElement.CornerRadius="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=Expander}, Path=DataContext.Result, Converter={StaticResource BoolToBrushConverterText}}">
                                                        <Expander.Header>
                                                            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Expander}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4*" />
                                                                    <ColumnDefinition Width="1*" />
                                                                    <ColumnDefinition Width="3*" />
                                                                    <ColumnDefinition Width="30" />
                                                                    <ColumnDefinition Width="3*" />
                                                                    <ColumnDefinition Width="70" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    Text="{Binding ResultList[0].Value}"
                                                                    TextAlignment="Center" />
                                                                <TextBlock
                                                                    Grid.Column="3"
                                                                    Text="{Binding ResultList[0].Feature, Converter={StaticResource TextUnitsConverter}}"
                                                                    TextAlignment="Center" />
                                                                <TextBlock
                                                                    Grid.Column="4"
                                                                    Text="{Binding ResultList[1].Value}"
                                                                    TextAlignment="Center" />
                                                                <TextBlock
                                                                    Grid.Column="5"
                                                                    Text="{Binding ResultList[1].Feature, Converter={StaticResource TextUnitsConverter}}"
                                                                    TextAlignment="Left" />
                                                            </Grid>
                                                        </Expander.Header>
                                                        <Border
                                                            Margin="4,2"
                                                            Background="Transparent"
                                                            BorderBrush="#FF0C424E"
                                                            BorderThickness="1">
                                                            <ItemsControl
                                                                hc:BorderElement.CornerRadius="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                ItemsSource="{Binding ResultList}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="1.1*" />
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="1*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Label
                                                                                Grid.Column="0"
                                                                                Margin="0,0"
                                                                                HorizontalContentAlignment="Center"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Content="{Binding Feature, Converter={StaticResource StringAttrEnumConverter}}" />
                                                                            <Label
                                                                                Grid.Column="1"
                                                                                Margin="0,0"
                                                                                HorizontalContentAlignment="Center"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Content="{Binding Value}"
                                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=Expander}, Path=Foreground}" />
                                                                            <Label
                                                                                Grid.Column="2"
                                                                                Margin="0,0"
                                                                                HorizontalContentAlignment="Center"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Content="{Binding Feature, Converter={StaticResource TextUnitsConverter}}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </hc:ScrollViewer>
    </Grid>
</UserControl>
