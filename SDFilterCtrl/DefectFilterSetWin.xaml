<hc:Window x:Class="SDFilter.DefectFilterSetWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDFilter"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
        xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
        xmlns:conv="clr-namespace:ValueConverters;assembly=ValueConverters"
        mc:Ignorable="d"
        Title="参数设置"
        Width="810"
        Height="610"
        WindowStartupLocation="CenterScreen"
        Background="#FF1C1C26"
        ResizeMode="NoResize"
        Foreground="White"
        FontSize="12"
        FontFamily="宋体">
    <d:Window.DataContext>
        <local:DefectFilterSetVM/>
    </d:Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToBrushConverter x:Key="BoolToBrushConverterEx" TrueValue="#FF324B64" FalseValue="Red"/>
            <conv:BoolToStringConverter x:Key="BoolToStringConverter" TrueValue="-" FalseValue="+"/>
            <local:TextUnitsConverter x:Key="TextUnitsConverter" />
            <entity:CommMultiParamConverter x:Key="MultiBindingConverter" />
            <local:CmbCharacterConverter x:Key="CmbCharacterConverter" />
            <entity:Enum2CmbConverter x:Key="Enum2CmbConverter"/>
            <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Small}">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="20" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                <Setter Property="Padding" Value="3" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="5" />
                <Setter Property="IsEditable" Value="False" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="20" />
            </Style>
            <Style x:Key="Button" TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="8,5,8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                <Setter Property="Height" Value="25" />
            </Style>
            <Style x:Key="AddNewButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="8,5,8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                <Setter Property="Height" Value="25" />
            </Style>
            <DataTemplate x:Key="Filter">
                <Expander hc:BorderElement.CornerRadius="0"
                          IsExpanded="True"
                          Background="#FF324B64"
                          Foreground="White">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="650" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="White" VerticalAlignment="Center" Text="{Binding RelativeSource={RelativeSource AncestorType=Expander}, Path=IsExpanded, Converter={StaticResource BoolToStringConverter}}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}{1}">
                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="Tag" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(ItemsControl.AlternationIndex)" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Button Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="×"
                                    Style="{DynamicResource Button}"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteSelectConfigCommand}"
                                    >
                                <Button.CommandParameter>
                                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                        <Binding />
                                        <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}" Path="ItemsSource" />
                                    </MultiBinding>
                                </Button.CommandParameter>
                            </Button>
                        </Grid>
                    </Expander.Header>
                    <Border BorderBrush="#FF3F3F45" BorderThickness="1">
                        <StackPanel Margin="12,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        Content="{Binding [Add], Source={x:Static local:Lang.instance}}"
                                        Style="{DynamicResource AddNewButton}"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddOneSelectParamCommand}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Grid.Column="0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding [Type], Source={x:Static local:Lang.instance}}" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding [Unit], Source={x:Static local:Lang.instance}}" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding [UseLow], Source={x:Static local:Lang.instance}}" />
                                <TextBlock Grid.Column="3"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding [LowLimit], Source={x:Static local:Lang.instance}}" />
                                <TextBlock Grid.Column="4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding [UseUp], Source={x:Static local:Lang.instance}}" />
                                <TextBlock Grid.Column="5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding [UpLimit], Source={x:Static local:Lang.instance}}" />
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectParams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Resources>
                                                <local:BindingProxy x:Key="BindingProxy" Data="{Binding}"/>
                                            </Grid.Resources>
                                            <ComboBox Name="CmbCharacter"
                                                      Grid.Column="1"
                                                      Margin="10,3,10,3"
                                                      SelectedItem="{Binding Character, Converter={StaticResource Enum2CmbConverter}}">
                                                <ComboBox.ItemsSource>
                                                    <MultiBinding Converter="{StaticResource CmbCharacterConverter}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}, AncestorLevel=2}" Path="Tag" />
                                                    </MultiBinding>
                                                </ComboBox.ItemsSource>
                                            </ComboBox>
                                            <TextBox Grid.Column="2"
                                                     Margin="10,0,10,0"
                                                     Text="{Binding Character, Mode=OneWay, Converter={StaticResource TextUnitsConverter}}"
                                                     IsReadOnly="True" />
                                            <CheckBox Grid.Column="3"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding MinLimit}" />
                                            <TextBox Grid.Column="4" Margin="10,0,10,0">
                                                <TextBox.Text>
                                                    <Binding Path="Min" UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <local:MinMaxValidation isGreater="False">
                                                                <local:MinMaxValidation.ValidationParams>
                                                                    <local:ValidationParams Data="{StaticResource BindingProxy}"/>
                                                                </local:MinMaxValidation.ValidationParams>
                                                            </local:MinMaxValidation>
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <CheckBox Grid.Column="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding MaxLimit}" />
                                            <TextBox Grid.Column="6" Margin="10,0,10,0" >
                                                <TextBox.Text>
                                                    <Binding Path="Max" UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <local:MinMaxValidation isGreater="True">
                                                                <local:MinMaxValidation.ValidationParams>
                                                                    <local:ValidationParams Data="{StaticResource BindingProxy}"/>
                                                                </local:MinMaxValidation.ValidationParams>
                                                            </local:MinMaxValidation>
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <Button Grid.Column="7"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Content="×"
                                                    Style="{DynamicResource Button}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteOneSelectParamCommand}"
                                                    >
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                                        <Binding />
                                                        <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}" Path="ItemsSource" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Expander>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <UniformGrid Rows="2" Margin="0,0,30,0">
            <TextBlock Text="{Binding [DefectName], Source={x:Static local:Lang.instance}}"/>
            <TextBox Text="{Binding DefectName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding [Priority], Source={x:Static local:Lang.instance}}"/>
            <TextBox Text="{Binding DefectFilter.Priority, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock/>
            <TextBlock/>
            <TextBlock Text="{Binding [Algorithm], Source={x:Static local:Lang.instance}}"/>
            <ComboBox ItemsSource="{Binding RecipeDefects}" SelectedItem="{Binding RecipeDefect}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding [QualityLevel], Source={x:Static local:Lang.instance}}" />
            <ComboBox ItemsSource="{Binding Qualities}">
                <ComboBox.SelectedItem>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <local:QualitySelectConverter/>
                        </MultiBinding.Converter>
                        <Binding Path="DefectFilter.QualityLevel"/>
                        <Binding Path="Qualities"/>
                    </MultiBinding>
                </ComboBox.SelectedItem>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding [ShowColor], Source={x:Static local:Lang.instance}}" />
            <wh:ColorComboBox SelectColor="{Binding DefectFilter.ShowColor, Mode=TwoWay}"/>
        </UniformGrid>
        <Border Grid.Row="1"
                Margin="1,5,1,5"
                BorderBrush="#FF58585A"
                BorderThickness="1">
            <Button Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Content="{Binding [AddSelect],Source={x:Static local:Lang.instance}}"
                    Style="{DynamicResource AddNewButton}"
                    Command="{Binding AddFilterConfigCommand}" />
        </Border>
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding DefectFilter.FilterList}" AlternationCount="10000">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander hc:BorderElement.CornerRadius="0" IsExpanded="True" Background="{Binding Result, Converter={StaticResource BoolToBrushConverterEx}}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="550" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="77" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="White" VerticalAlignment="Center" Text="{Binding RelativeSource={RelativeSource AncestorType=Expander}, Path=IsExpanded, Converter={StaticResource BoolToStringConverter}}"/>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}{1}">
                                                <Binding Source="{x:Static local:Lang.instance}" Path="[DefectFilter]" />
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="(ItemsControl.AlternationIndex)" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <ComboBox Grid.Column="2" Margin="2" SelectedItem="{Binding UnionOrConnect}">
                                        <ComboBox.Items>
                                            <sys:String>区域打散</sys:String>
                                            <sys:String>区域合并</sys:String>
                                            <sys:String>不打散不合并</sys:String>
                                        </ComboBox.Items>
                                    </ComboBox>
                                    <Button Name="btn_DeleteFilter"
                                            Grid.Column="3"
                                            Margin="5,0,5,0"
                                            HorizontalAlignment="Right"
                                            Content="{Binding [Delete], Source={x:Static local:Lang.instance}}"
                                            Style="{DynamicResource Button}"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteFilterConfigCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Margin="20,1,30,1">
                                <Border BorderBrush="#FF3F3F45" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition Height="15" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="5,5,15,5" Text="{Binding [Filter], Source={x:Static local:Lang.instance}}" Foreground="Cyan" />
                                            <Button Padding="8,2,8,2"
                                                    Content="+"
                                                    Style="{DynamicResource AddNewButton}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddSelectConfigCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <ItemsControl Grid.Row="1"
                                                      Margin="15,0,0,0"
                                                      ItemsSource="{Binding Filter}"
                                                      ItemTemplate="{StaticResource Filter}" AlternationCount="10000"  Tag="{Binding [Filter], Source={x:Static local:Lang.instance}}"/>
                                    </Grid>
                                </Border>
                                <Border Margin="0,10,0,0" BorderBrush="#FF3F3F45" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition Height="15" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="5,5,15,5" Text="{Binding [Select], Source={x:Static local:Lang.instance}}" Foreground="Cyan" />
                                            <Button Padding="8,2,8,2"
                                                    Content="+"
                                                    Style="{DynamicResource AddNewButton}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddSelectConfig2Command}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <ItemsControl Grid.Row="1"
                                                      Margin="15,0,0,0"
                                                      ItemsSource="{Binding SelectList}"
                                                      ItemTemplate="{StaticResource Filter}" AlternationCount="10000" Tag="{Binding [Select], Source={x:Static local:Lang.instance}}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</hc:Window>
