<hc:Window
    x:Class="SDFilter.DefectFilterSetWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ValueConverters;assembly=ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:entityproxy="clr-namespace:WH.Entity;assembly=WH.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SDFilter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
    Title="参数设置"
    Width="810"
    Height="610"
    Background="#FF1C1C26"
    FontFamily="宋体"
    FontSize="12"
    Foreground="White"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <d:Window.DataContext>
        <local:DefectFilterSetVM />
    </d:Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <entityproxy:BindingProxy x:Key="scroll" Data="{Binding ElementName=scroll,Path=DataContext.FilterCharacters}"/>
            <conv:BoolToBrushConverter
                x:Key="BoolToBrushConverterEx"
                FalseValue="Red"
                TrueValue="#FF324B64" />
            <conv:BoolToStringConverter
                x:Key="BoolToStringConverter"
                FalseValue="+"
                TrueValue="-" />
            <entity:CommMultiParamConverter x:Key="CommMultiParamConverter"/>
            <local:TextUnitsConverter x:Key="TextUnitsConverter" />
            <entity:CommMultiParamConverter x:Key="MultiBindingConverter" />
            <entity:EnumProviderConverter x:Key="EnumProviderConverter" />
            <entity:Enums2StringsConverter x:Key="Enums2StringsConverter"/>
            <entity:StringAttrEnumConverter x:Key="StringAttrEnumConverter" />
            <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource TextBox.Small}" TargetType="TextBox">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="20" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                <Setter Property="Padding" Value="3" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="5" />
                <Setter Property="IsEditable" Value="False" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="20" />
            </Style>
            <Style
                x:Key="Button"
                BasedOn="{StaticResource ButtonDanger}"
                TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="8,5,8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                <Setter Property="Height" Value="25" />
            </Style>
            <Style
                x:Key="AddNewButton"
                BasedOn="{StaticResource ButtonPrimary}"
                TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="8,5,8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                <Setter Property="Height" Value="25" />
            </Style>
            <DataTemplate x:Key="Filter">
                <Expander
                    hc:BorderElement.CornerRadius="0"
                    Background="#FF324B64"
                    Foreground="White"
                    IsExpanded="True">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="650" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="{Binding RelativeSource={RelativeSource AncestorType=Expander}, Path=IsExpanded, Converter={StaticResource BoolToStringConverter}}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="White">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}{1}">
                                        <Binding Path="Tag[0]" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteSelectConfigCommand}"
                                Content="×"
                                Style="{DynamicResource Button}">
                                <Button.CommandParameter>
                                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                        <Binding />
                                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </Button.CommandParameter>
                            </Button>
                        </Grid>
                    </Expander.Header>
                    <Border BorderBrush="#FF3F3F45" BorderThickness="1">
                        <StackPanel Margin="12,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddOneSelectParamCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding [Add], Source={x:Static local:Lang.s_Instance}}"
                                    Style="{DynamicResource AddNewButton}" />
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [Type], Source={x:Static local:Lang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [Unit], Source={x:Static local:Lang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [UseLow], Source={x:Static local:Lang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [LowLimit], Source={x:Static local:Lang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [UseUp], Source={x:Static local:Lang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [UpLimit], Source={x:Static local:Lang.s_Instance}}" />
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectParams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="local:OneSelectParams">
                                        <Grid Height="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Resources>
                                                <local:ValidationParams x:Key="BindingProxy" Data="{Binding}" />
                                            </Grid.Resources>
                                            <ComboBox
                                                Name="CmbCharacter"
                                                Grid.Column="1"
                                                Margin="10,3,10,3"
                                                SelectedItem="{Binding Character, Converter={StaticResource StringAttrEnumConverter}}"
                                                ItemsSource="{Binding Tag[1],RelativeSource={RelativeSource AncestorType=ItemsControl,AncestorLevel=2}}">
                                                <!--ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:DefectFilterSetWin},Path=DataContext.FilterCharacters,Converter={StaticResource Enums2StringsConverter}}">-->
                                                <!--<ComboBox.ItemsSource>
                                                    <MultiBinding Converter="{StaticResource ItemSourceCharacterConverter}">
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}, AncestorLevel=2}" />
                                                    </MultiBinding>
                                                </ComboBox.ItemsSource>-->
                                            </ComboBox>
                                            <TextBox
                                                Grid.Column="2"
                                                Margin="10,0,10,0"
                                                IsReadOnly="True"
                                                Text="{Binding Character, Mode=OneWay, Converter={StaticResource TextUnitsConverter}}" />
                                            <CheckBox
                                                Grid.Column="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding MinLimit}" />
                                            <TextBox Grid.Column="4" Margin="10,0,10,0">
                                                <TextBox.Text>
                                                    <Binding Path="Min" UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <local:MinMaxValidation IsGreater="False" ValidationParams="{StaticResource BindingProxy}" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <CheckBox
                                                Grid.Column="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding MaxLimit}" />
                                            <TextBox Grid.Column="6" Margin="10,0,10,0">
                                                <TextBox.Text>
                                                    <Binding Path="Max" UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <local:MinMaxValidation IsGreater="True" ValidationParams="{StaticResource BindingProxy}" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <Button
                                                Grid.Column="7"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteOneSelectParamCommand}"
                                                Content="×"
                                                Style="{DynamicResource Button}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                                        <Binding />
                                                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Expander>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <UniformGrid Margin="0,0,30,0" Rows="2">
            <TextBlock Text="{Binding [DefectName], Source={x:Static local:Lang.s_Instance}}" />
            <TextBox Text="{Binding DefectName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding [Priority], Source={x:Static local:Lang.s_Instance}}" />
            <TextBox Text="{Binding DefectFilter.Priority, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock />
            <TextBlock />
            <TextBlock Text="{Binding [Algorithm], Source={x:Static local:Lang.s_Instance}}" />
            <ComboBox ItemsSource="{Binding RecipeDefects}" SelectedItem="{Binding RecipeDefect}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding [QualityLevel], Source={x:Static local:Lang.s_Instance}}" />
            <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding DefectFilter.QualityLevel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding [ShowColor], Source={x:Static local:Lang.s_Instance}}" />
            <wh:ColorComboBox SelectColor="{Binding DefectFilter.ShowColor, Mode=TwoWay}" />
        </UniformGrid>
        <Border
            Grid.Row="1"
            Margin="1,5,1,5"
            BorderBrush="#FF58585A"
            BorderThickness="1">
            <Button
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Command="{Binding AddFilterConfigCommand}"
                Content="{Binding [AddSelect], Source={x:Static local:Lang.s_Instance}}"
                Style="{DynamicResource AddNewButton}" />
        </Border>
        <ScrollViewer Grid.Row="2" x:Name="scroll">
            <ItemsControl AlternationCount="10000" ItemsSource="{Binding DefectFilter.FilterList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander
                            hc:BorderElement.CornerRadius="0"
                            Background="{Binding Result, Converter={StaticResource BoolToBrushConverterEx}}"
                            IsExpanded="True">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="550" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="77" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="{Binding RelativeSource={RelativeSource AncestorType=Expander}, Path=IsExpanded, Converter={StaticResource BoolToStringConverter}}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Foreground="White">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}{1}">
                                                <Binding Path="[DefectFilter]" Source="{x:Static local:Lang.s_Instance}" />
                                                <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <ComboBox
                                        Grid.Column="2"
                                        Margin="2"
                                        SelectedItem="{Binding UnionOrConnect}">
                                        <ComboBox.Items>
                                            <sys:String>区域打散</sys:String>
                                            <sys:String>区域合并</sys:String>
                                            <sys:String>不打散不合并</sys:String>
                                        </ComboBox.Items>
                                    </ComboBox>
                                    <Button
                                        Name="btn_DeleteFilter"
                                        Grid.Column="3"
                                        Margin="5,0,5,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteFilterConfigCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding [Delete], Source={x:Static local:Lang.s_Instance}}"
                                        Style="{DynamicResource Button}" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Margin="20,1,30,1">
                                <Border BorderBrush="#FF3F3F45" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition Height="15" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,5,15,5"
                                                Foreground="Cyan"
                                                Text="{Binding [Filter], Source={x:Static local:Lang.s_Instance}}" />
                                            <Button
                                                Padding="8,2,8,2"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddSelectConfigCommand}"
                                                CommandParameter="{Binding}"
                                                Content="+"
                                                Style="{DynamicResource AddNewButton}" />
                                        </StackPanel>
                                        <ItemsControl
                                            Grid.Row="1"
                                            Margin="15,0,0,0"
                                            AlternationCount="10000"
                                            ItemTemplate="{StaticResource Filter}"
                                            ItemsSource="{Binding Filter}"
                                            >
                                            <ItemsControl.Tag>
                                                <MultiBinding Converter="{StaticResource CommMultiParamConverter}">
                                                    <Binding Path="[Filter]" Source="{x:Static local:Lang.s_Instance}"/>
                                                    <Binding RelativeSource="{RelativeSource AncestorType=local:DefectFilterSetWin}" Path="DataContext.FilterCharacters" Converter="{StaticResource Enums2StringsConverter}"/>
                                                </MultiBinding>
                                            </ItemsControl.Tag>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                <Border
                                    Margin="0,10,0,0"
                                    BorderBrush="#FF3F3F45"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition Height="15" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="5,5,15,5"
                                                Foreground="Cyan"
                                                Text="{Binding [Select], Source={x:Static local:Lang.s_Instance}}" />
                                            <Button
                                                Padding="8,2,8,2"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddSelectConfig2Command}"
                                                CommandParameter="{Binding}"
                                                Content="+"
                                                Style="{DynamicResource AddNewButton}" />
                                        </StackPanel>
                                        <ItemsControl
                                            Grid.Row="1"
                                            Margin="15,0,0,0"
                                            AlternationCount="10000"
                                            ItemTemplate="{StaticResource Filter}"
                                            ItemsSource="{Binding SelectList}"
                                            >
                                            <ItemsControl.Tag>
                                                <MultiBinding Converter="{StaticResource CommMultiParamConverter}">
                                                    <Binding Path="[Select]" Source="{x:Static local:Lang.s_Instance}"/>
                                                    <Binding Path="Filter[0].SelectParams[0].Character" Converter="{StaticResource EnumProviderConverter}"/>
                                                </MultiBinding>
                                            </ItemsControl.Tag>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</hc:Window>
