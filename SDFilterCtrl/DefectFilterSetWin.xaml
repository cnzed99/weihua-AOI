<hc:Window
    x:Class="SDFilter.DefectFilterSetWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ValueConverters;assembly=ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:entityproxy="clr-namespace:WH.Entity;assembly=WH.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SDFilter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
    Title=""
    Width="810"
    Height="610"
    d:DataContext="{d:DesignInstance local:CDefectFilterSetVM}"
    Icon="/SDFilter;component/Resources/检测设置.png"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <entityproxy:CBindingProxy x:Key="scroll" Data="{Binding ElementName=scroll, Path=DataContext.FilterCharacters}" />
            <conv:BoolToBrushConverter
                x:Key="BoolToBrushConverterEx"
                FalseValue="Red"
                TrueValue="#FF324B64" />
            <conv:BoolToStringConverter
                x:Key="BoolToStringConverter"
                FalseValue="+"
                TrueValue="-" />
            <entity:CommMultiParamConverter x:Key="CommMultiParamConverter" />
            <local:TextUnitsConverter x:Key="TextUnitsConverter" />
            <entity:CommMultiParamConverter x:Key="MultiBindingConverter" />
            <entity:EnumProviderConverter x:Key="EnumProviderConverter" />
            <entity:Enums2StringsConverter x:Key="Enums2StringsConverter" />
            <entity:StringAttrEnumConverter x:Key="StringAttrEnumConverter" />
            <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style BasedOn="{StaticResource TextBoxExtend.Small}" TargetType="TextBox">
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
                <Setter Property="Padding" Value="3" />
            </Style>
            <Style BasedOn="{StaticResource ComboBoxExtend.Small}" TargetType="ComboBox">
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="IsEditable" Value="False" />
                <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />

            </Style>
            <Style
                x:Key="Button"
                BasedOn="{StaticResource ButtonDanger}"
                TargetType="Button">

                <Setter Property="Padding" Value="8,5,8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                <Setter Property="Height" Value="25" />
            </Style>
            <Style
                x:Key="AddNewButton"
                BasedOn="{StaticResource ButtonPrimary}"
                TargetType="Button">

                <Setter Property="Padding" Value="8,5,8,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                <Setter Property="Height" Value="25" />
            </Style>
            <DataTemplate x:Key="Filter">
                <Border
                    Margin="0,2"
                    BorderBrush="{StaticResource ThirdlyRegionBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <Expander Background="{StaticResource ThirdlyRegionBrush}" IsExpanded="True">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="690" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{Binding RelativeSource={RelativeSource AncestorType=Expander}, Path=IsExpanded, Converter={StaticResource BoolToStringConverter}}" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} : {1}">
                                            <Binding Path="Tag[0]" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=local:DefectFilterSetWin}, Path=DataContext.DeleteSelectConfigCommand}"
                                    Content="×"
                                    Style="{DynamicResource Button}">
                                    <Button.CommandParameter>
                                        <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                            <Binding />
                                            <Binding Path="ItemsSource" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Button.CommandParameter>
                                </Button>
                            </Grid>
                        </Expander.Header>
                        <StackPanel Margin="12,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddOneSelectParamCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding [Add], Source={x:Static local:CLang.s_Instance}}"
                                    Style="{DynamicResource AddNewButton}" />
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [Type], Source={x:Static local:CLang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [Unit], Source={x:Static local:CLang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [UseLow], Source={x:Static local:CLang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [LowLimit], Source={x:Static local:CLang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [UseUp], Source={x:Static local:CLang.s_Instance}}" />
                                <TextBlock
                                    Grid.Column="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [UpLimit], Source={x:Static local:CLang.s_Instance}}" />
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectParams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="local:OneSelectParams">
                                        <Grid Height="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Resources>
                                                <local:ValidationParams x:Key="BindingProxy" Data="{Binding}" />
                                            </Grid.Resources>
                                            <ComboBox
                                                Name="CmbCharacter"
                                                Grid.Column="1"
                                                Margin="10,3,10,3"
                                                ItemsSource="{Binding Tag[1], RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                SelectedItem="{Binding Character, Converter={StaticResource StringAttrEnumConverter}}">
                                                <!--  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:DefectFilterSetWin},Path=DataContext.FilterCharacters,Converter={StaticResource Enums2StringsConverter}}">  -->
                                                <!--<ComboBox.ItemsSource>
                            <MultiBinding Converter="{StaticResource ItemSourceCharacterConverter}">
                                <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}, AncestorLevel=2}" />
                            </MultiBinding>
                        </ComboBox.ItemsSource>-->
                                            </ComboBox>
                                            <TextBox
                                                Grid.Column="2"
                                                Margin="10,0,10,0"
                                                IsReadOnly="True"
                                                Text="{Binding Character, Mode=OneWay, Converter={StaticResource TextUnitsConverter}}" />
                                            <CheckBox
                                                Grid.Column="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding MinLimit}" />
                                            <TextBox Grid.Column="4" Margin="10,0,10,0">
                                                <TextBox.Text>
                                                    <Binding Path="Min" UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <local:MinMaxValidation IsGreater="False" ValidationParams="{StaticResource BindingProxy}" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <CheckBox
                                                Grid.Column="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding MaxLimit}" />
                                            <TextBox Grid.Column="6" Margin="10,0,10,0">
                                                <TextBox.Text>
                                                    <Binding Path="Max" UpdateSourceTrigger="PropertyChanged">
                                                        <Binding.ValidationRules>
                                                            <local:MinMaxValidation IsGreater="True" ValidationParams="{StaticResource BindingProxy}" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <Button
                                                Grid.Column="7"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteOneSelectParamCommand}"
                                                Content="×"
                                                Style="{DynamicResource Button}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                                        <Binding />
                                                        <Binding Path="ItemsSource" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </Expander>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <UniformGrid
            Margin="30,0,30,0"
            Columns="3"
            Rows="2">

            <TextBox hc:TitleElement.Title="{Binding [DefectName], Source={x:Static local:CLang.s_Instance}}" Text="{Binding DefectName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox hc:TitleElement.Title="{Binding [Priority], Source={x:Static local:CLang.s_Instance}}" Text="{Binding DefectFilter.Priority, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                hc:TitleElement.Title="{Binding [Algorithm], Source={x:Static local:CLang.s_Instance}}"
                ItemsSource="{Binding RecipeDefects}"
                SelectedItem="{Binding RecipeDefect}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox
                hc:TitleElement.Title="{Binding [QualityLevel], Source={x:Static local:CLang.s_Instance}}"
                ItemsSource="{Binding Qualities}"
                SelectedItem="{Binding DefectFilter.QualityLevel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <wh:ColorComboBox
                Margin="6,0"
                hc:TitleElement.Title="{Binding [ShowColor], Source={x:Static local:CLang.s_Instance}}"
                hc:TitleElement.TitlePlacement="Left"
                SelectColor="{Binding DefectFilter.ShowColor, Mode=TwoWay}"
                Style="{StaticResource ComboBoxExtend.Small}" />
        </UniformGrid>
        <StackPanel Grid.Row="1">
            <Button
                Margin="5,0,0,5"
                HorizontalAlignment="Left"
                Command="{Binding AddFilterConfigCommand}"
                Content="{Binding [AddSelect], Source={x:Static local:CLang.s_Instance}}"
                Style="{DynamicResource AddNewButton}" />
            <hc:Divider
                Margin="1"
                LineStroke="{StaticResource SecondaryBorderBrush}"
                LineStrokeThickness="1"
                Orientation="Horizontal" />
        </StackPanel>

        <ScrollViewer x:Name="scroll" Grid.Row="2">
            <ItemsControl AlternationCount="10000" ItemsSource="{Binding DefectFilter.FilterList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BorderBrush="{Binding Result, Converter={StaticResource BoolToBrushConverterEx}}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <Expander Background="{Binding Result, Converter={StaticResource BoolToBrushConverterEx}}" IsExpanded="True">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="310" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="77" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="{Binding RelativeSource={RelativeSource AncestorType=Expander}, Path=IsExpanded, Converter={StaticResource BoolToStringConverter}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Foreground="White">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} : {1}">
                                                    <Binding Path="[DefectFilter]" Source="{x:Static local:CLang.s_Instance}" />
                                                    <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource TemplatedParent}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <CheckBox Content="{Binding [Enable], Source={x:Static local:CLang.s_Instance}}"
                                                  Grid.Column="2" 
                                                  IsChecked="{Binding FilterSelectEnable}" Foreground="White"/>
                                        <ComboBox
                                            Grid.Column="4"
                                            Width="180"
                                            Margin="2"
                                            ItemsSource="{Binding UnionMethod, Converter={StaticResource EnumProviderConverter}}"
                                            SelectedItem="{Binding UnionMethod, Converter={StaticResource StringAttrEnumConverter}}"
                                            Style="{StaticResource ComboBoxExtend}" />
                                        <Button
                                            Name="btn_DeleteFilter"
                                            Grid.Column="5"
                                            Margin="5,0,5,0"
                                            HorizontalAlignment="Right"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteFilterConfigCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding [Delete], Source={x:Static local:CLang.s_Instance}}"
                                            Style="{DynamicResource Button}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="1">
                                    <Border
                                        BorderBrush="{StaticResource SecondaryBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition Height="15" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="5,5,15,5"
                                                    Foreground="{StaticResource DarkInfoBrush}"
                                                    Text="{Binding [Filter], Source={x:Static local:CLang.s_Instance}}" />
                                                <Button
                                                    Padding="8,2,8,2"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddSelectConfigCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="+"
                                                    Style="{DynamicResource AddNewButton}" />
                                            </StackPanel>
                                            <ItemsControl
                                                Grid.Row="1"
                                                Margin="15,0,0,0"
                                                AlternationCount="10000"
                                                ItemTemplate="{StaticResource Filter}"
                                                ItemsSource="{Binding Filter}">
                                                <ItemsControl.Tag>
                                                    <MultiBinding Converter="{StaticResource CommMultiParamConverter}">
                                                        <Binding Path="[Filter]" Source="{x:Static local:CLang.s_Instance}" />
                                                        <Binding
                                                            Converter="{StaticResource Enums2StringsConverter}"
                                                            Path="DataContext.FilterCharacters"
                                                            RelativeSource="{RelativeSource AncestorType=local:DefectFilterSetWin}" />
                                                    </MultiBinding>
                                                </ItemsControl.Tag>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                    <Border
                                        Margin="1"
                                        BorderBrush="{StaticResource SecondaryBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition Height="15" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="5,5,15,5"
                                                    Foreground="{StaticResource DarkInfoBrush}"
                                                    Text="{Binding [Select], Source={x:Static local:CLang.s_Instance}}" />
                                                <Button
                                                    Padding="8,2,8,2"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddSelectConfig2Command}"
                                                    CommandParameter="{Binding}"
                                                    Content="+"
                                                    Style="{DynamicResource AddNewButton}" />
                                            </StackPanel>
                                            <ItemsControl
                                                Grid.Row="1"
                                                Margin="15,0,0,0"
                                                AlternationCount="10000"
                                                ItemTemplate="{StaticResource Filter}"
                                                ItemsSource="{Binding SelectList}">
                                                <ItemsControl.Tag>
                                                    <MultiBinding Converter="{StaticResource CommMultiParamConverter}">
                                                        <Binding Path="[Select]" Source="{x:Static local:CLang.s_Instance}" />
                                                        <Binding Converter="{StaticResource EnumProviderConverter}" Path="Filter[0].SelectParams[0].Character" />
                                                    </MultiBinding>
                                                </ItemsControl.Tag>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</hc:Window>
