<UserControl
    x:Class="UDPIP.TestControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:UDPIP"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <d:UserControl.DataContext>
        <local:TestControlVM />
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.Row="0"
            Header="{Binding [SendData], Source={x:Static local:CLang.s_Instance}}"
            Style="{StaticResource GroupBoxTab}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="0.5*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="txt_send"
                    Grid.RowSpan="2"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Width="100"
                    Height="40"
                    Command="{Binding SendCommand}"
                    CommandParameter="{Binding ElementName=txt_send, Path=Text}"
                    Content="{Binding [Send], Source={x:Static local:CLang.s_Instance}}"
                    IsEnabled="{Binding Server.IsConnected}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Width="100"
                    Height="40"
                    Command="{Binding PingCommand}"
                    Content="Ping" />
            </Grid>
        </GroupBox>
        <GroupBox
            Grid.Row="1"
            Header="{Binding [RecvData], Source={x:Static local:CLang.s_Instance}}"
            Style="{StaticResource GroupBoxTab}">
            <TextBox IsReadOnly="True" Text="{Binding TxtRecv}" />
        </GroupBox>
        <GroupBox
            Grid.Row="2"
            Header="{Binding [Tips], Source={x:Static local:CLang.s_Instance}}"
            Style="{StaticResource GroupBoxTab}">
            <ListBox ItemsSource="{Binding ListTips}" />
        </GroupBox>
    </Grid>
</UserControl>
