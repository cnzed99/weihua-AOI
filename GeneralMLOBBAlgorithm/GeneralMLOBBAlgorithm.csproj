<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  
  <ItemGroup>
    <None Include="bin\dll\net48\TensorRtSharp.dll" />
    <None Include="bin\dll\net8.0\TensorRtSharp.dll" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.Extensions" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="OpenVINO.CSharp.API.Extensions" />
    <PackageReference Include="OpenVINO.CSharp.API.Extensions.OpenCvSharp" />
    <PackageReference Include="OpenVINO.CSharp.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlgorithmDll\AlgorithmDll.csproj" />
    <ProjectReference Include="..\WH.RunCell\WH.RunCell.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="TensorRtSharp">
      <HintPath>bin\dll\net48\TensorRtSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<Reference Include="TensorRtSharp">
			<HintPath>bin\dll\net8.0\TensorRtSharp.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
	  <None Update="TensorRtExtern.dll">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
