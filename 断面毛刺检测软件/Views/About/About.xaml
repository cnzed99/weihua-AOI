            <RowDefinition Height="auto" />

            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">

            <StackPanel Margin="10,0" DockPanel.Dock="Right">
                <TextBlock
                    Margin="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockSubTitleBold}"
                    Text="{Binding SubTitle}" />
                <TextBlock
                    Margin="10,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockDefault}"
                    Text="{Binding Version, StringFormat='{}版本:{0}'}" />
                <TextBlock
                    Margin="10,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockDefault}"
                    Text="{Binding Right}" />
            </StackPanel>
            <Image
                Height="70"
                Margin="5"
                HorizontalAlignment="Left"
                DockPanel.Dock="Left"
                Source="/Resources/组合-2.png"
                Stretch="Uniform" />
        </DockPanel>
        <RichTextBox
            Grid.Row="1"
            Margin="5"
            Background="{StaticResource BorderBrush}"
            Style="{StaticResource RichTextBoxBaseStyle}">
