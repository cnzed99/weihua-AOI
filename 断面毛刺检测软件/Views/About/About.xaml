<hc:Window
    x:Class="断面毛刺检测软件.Views.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:断面毛刺检测软件.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:WH.DetectSystem.ViewModels;assembly=WH.DetectSystem"
    Title="{Binding Title}"
    Width="600"
    Height="450"
    d:DataContext="{d:DesignInstance sys:AboutVM}"
    Icon="/Resources/图片/帮助/关于.png"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />

            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">

            <StackPanel Margin="10,0" DockPanel.Dock="Right">
                <TextBlock
                    Margin="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockSubTitleBold}"
                    Text="{Binding SubTitle}" />
                <TextBlock
                    Margin="10,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockDefault}"
                    Text="{Binding Version, StringFormat='{}版本:{0}'}" />
                <TextBlock
                    Margin="10,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource TextBlockDefault}"
                    Text="{Binding Right}" />
            </StackPanel>
            <Image
                Height="70"
                Margin="5"
                HorizontalAlignment="Left"
                DockPanel.Dock="Left"
                Source="/Resources/组合-2.png"
                Stretch="Uniform" />
        </DockPanel>
        <RichTextBox
            Grid.Row="1"
            Margin="5"
            Style="{StaticResource RichTextBoxBaseStyle}" />
        <DockPanel Grid.Row="2" Background="{StaticResource RegionBrush}">
            <Button
                Width="80"
                Margin="5"
                
                Content="确认"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonInfo}" >
                
            </Button>
            <TextBlock
                Margin="2"
                Style="{StaticResource TextBlockDefault}"
                Text="{Binding Warning}"
                TextWrapping="Wrap" />
        </DockPanel>

    </Grid>
</hc:Window>
