        <DockPanel Grid.Row="2" Background="{StaticResource RegionBrush}">
            <Button
                Width="80"
                Margin="5"
                Command="{x:Static hc:ControlCommands.CloseWindow}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=hc:Window}}"
                Content="确认"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonInfo}" />
            <TextBlock
                Margin="2"
                Style="{StaticResource TextBlockDefault}"
                Text="{Binding Warning}"
                TextWrapping="Wrap" />
        </DockPanel>

    </Grid>
</hc:Window>
