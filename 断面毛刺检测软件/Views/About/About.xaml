    Width="600"
    Height="450"
    d:DataContext="{d:DesignInstance sys:AboutVM}"
    Icon="/Resources/图片/帮助/关于.png"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
