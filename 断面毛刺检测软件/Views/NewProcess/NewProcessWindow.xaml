<hc:Window
    x:Class="断面毛刺检测软件.Views.NewProcessWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:alg="clr-namespace:AlgorithmDll;assembly=AlgorithmDll"
    xmlns:cam="clr-namespace:CameraModule;assembly=CameraModule"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:focus="clr-namespace:FocusControl;assembly=FocusControl"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:断面毛刺检测软件.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:motion="clr-namespace:Motion;assembly=Motion"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:WH.DetectSystem.ViewModels;assembly=WH.DetectSystem"
    xmlns:wh="http://whzn.com/rjkf/2024/xaml"
    Width="450"
    Height="330"
    d:DataContext="{d:DesignInstance vm:CNewProcessVM}"
    d:Title="增加制程"
    Background="{DynamicResource RegionBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:Window.Resources>
        <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <wh:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
    </hc:Window.Resources>
    <Grid IsEnabled="{Binding IsOperator, Source={x:Static wh:CLoginViewModel.SloinPerson}}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="10">
            <TextBox
                hc:TitleElement.Title="{Binding [Name], Source={x:Static local:CLang.NewProcess}}"
                hc:TitleElement.TitleWidth="80"
                Text="{Binding Name}" />
            <ComboBox
                Margin="5"
                hc:TitleElement.Title="{Binding [Cam], Source={x:Static local:CLang.NewProcess}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="80"
                ItemsSource="{Binding Cams}"
                SelectedItem="{Binding CameraSerial}"
                Style="{StaticResource ComboBoxExtend}" />
            <ComboBox
                Margin="5"
                hc:TitleElement.Title="{Binding [Algorithm], Source={x:Static local:CLang.NewProcess}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="80"
                ItemsSource="{Binding Source={x:Static alg:CAlgorithmManagement.AlgorithmHeper}, Path=Keys}"
                SelectedItem="{Binding Algorithm}"
                Style="{StaticResource ComboBoxExtend}" />
            <ComboBox
                Margin="5"
                hc:TitleElement.Title="{Binding [Focus], Source={x:Static local:CLang.NewProcess}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="80"
                ItemsSource="{Binding Source={x:Static focus:CFocusManagement.FocusHeper}, Path=Keys}"
                SelectedItem="{Binding Focus}"
                Style="{StaticResource ComboBoxExtend}"
                Visibility="{Binding Source={x:Static focus:CFocusManagement.FocusHeper}, Converter={StaticResource EmptyToVisibilityConverter}}" />
            <ComboBox
                Margin="5"
                hc:TitleElement.Title="{Binding [Motion], Source={x:Static local:CLang.NewProcess}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="80"
                ItemsSource="{Binding Source={x:Static motion:CMotionManagement.MotionHeper}, Path=Keys}"
                SelectedItem="{Binding Motion}"
                Style="{StaticResource ComboBoxExtend}"
                Visibility="{Binding Source={x:Static motion:CMotionManagement.MotionHeper}, Converter={StaticResource EmptyToVisibilityConverter}}" />
            <ComboBox
                Margin="5"
                hc:TitleElement.Title="{Binding [Group], Source={x:Static local:CLang.NewProcess}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="80"
                ItemsSource="{Binding MainModelVM.CMainMModel.CProcessGroups}"
                SelectedItem="{Binding GroupVM}"
                Style="{StaticResource ComboBoxExtend}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <hc:ElementGroup Grid.Row="1" Margin="10">
            <Button
                Width="100"
                Command="{Binding SureCommand}"
                Content="{Binding [Sure], Source={x:Static local:CLang.NewProcess}}"
                Style="{StaticResource ButtonPrimary}" />
            <Button
                Width="100"
                Command="{Binding CancelCommand}"
                Content="{Binding [Cancel], Source={x:Static local:CLang.NewProcess}}"
                Style="{StaticResource ButtonDanger}" />
        </hc:ElementGroup>
    </Grid>

</hc:Window>
