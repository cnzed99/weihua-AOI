<hc:Window
    x:Class="断面毛刺检测软件.Views.NewProjWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:断面毛刺检测软件.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:断面毛刺检测软件.ViewModels"
    Title="{Binding [Title], Source={x:Static local:Lang.newProj}}"
    Width="450"
    Height="330"
    d:DataContext="{d:DesignInstance vm:NewProjVM}"
    Background="{DynamicResource RegionBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:Window.Resources>
        <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
            <Setter Property="Margin" Value="5" />
        </Style>

    </hc:Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="10">
            <TextBox hc:TitleElement.Title="{Binding [ProjName], Source={x:Static local:Lang.newProj}}" Text="{Binding Name}" />
            <TextBox
                x:Name="tb_path"
                hc:InfoElement.Placeholder="{Binding [SelectPath], Source={x:Static local:Lang.newProj}}"
                hc:TitleElement.Title="{Binding [Path], Source={x:Static local:Lang.newProj}}"
                IsReadOnly="True"
                PreviewMouseDoubleClick="SelectPath_DoubleClick"
                Text="{Binding ProjPath}" />

        </StackPanel>
        <hc:ElementGroup Grid.Row="1" Margin="10">
            <Button
                Width="100"
                Command="{Binding SureCommand}"
                Content="{Binding [Sure], Source={x:Static local:Lang.newProj}}"
                Style="{StaticResource ButtonPrimary}" />
            <Button
                Width="100"
                Command="{Binding CancelCommand}"
                Content="{Binding [Cancel], Source={x:Static local:Lang.newProj}}"
                Style="{StaticResource ButtonDanger}" />
        </hc:ElementGroup>
    </Grid>

</hc:Window>
