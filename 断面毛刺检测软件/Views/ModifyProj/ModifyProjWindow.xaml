<hc:Window
    x:Class="断面毛刺检测软件.Views.ModifyProjWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cam="clr-namespace:CameraModule;assembly=CameraModule"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:断面毛刺检测软件.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WH.DetectSystem.ViewModels;assembly=WH.DetectSystem"
    xmlns:wh="http://whzn.com/rjkf/2024/xaml"
    Title="{Binding [Title], Source={x:Static local:CLang.ModifyProj}}"
    Width="450"
    Height="430"
    d:DataContext="{d:DesignInstance vm:CModifyProjVM}"
    Background="{DynamicResource RegionBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:Window.Resources>
        <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
            <Setter Property="Margin" Value="5" />
        </Style>

    </hc:Window.Resources>
    <Grid IsEnabled="{Binding IsOperator, Source={x:Static wh:CLoginViewModel.SloinPerson}}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="10">
            <TextBox
            hc:TitleElement.Title="{Binding [ProjName], Source={x:Static local:CLang.NewProj}}"
            hc:TitleElement.TitleWidth="60"
            Text="{Binding Name}"
            ToolTip="{Binding [Enterprojectname], Source={x:Static local:CLang.NewProj}}" />
            <TextBox
            x:Name="tb_path"
            hc:InfoElement.Placeholder="{Binding [SelectPath], Source={x:Static local:CLang.NewProj}}"
            hc:TitleElement.Title="{Binding [Path], Source={x:Static local:CLang.NewProj}}"
            hc:TitleElement.TitleWidth="60"
            IsReadOnly="True"
            PreviewMouseDoubleClick="SelectPath_DoubleClick"
            Text="{Binding ProjPath}"
            ToolTip="{Binding [SelectPath], Source={x:Static local:CLang.NewProj}}" />
            <GroupBox Style="{StaticResource GroupBoxTab}" Margin="0,10">
                <GroupBox.Header>
                    <DockPanel Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type GroupBox}}, Path=ActualWidth}" LastChildFill="False">
                        <TextBlock Text="{Binding [Group], Source={x:Static local:CLang.NewProj}}" VerticalAlignment="Center"/>
                        <Button
                        Width="80"
                        Margin="20,2"
                        Command="{Binding DelCommand}"
                        CommandParameter="{Binding ElementName=dataGrid1, Path=SelectedItem}"
                        Content="{Binding [Del], Source={x:Static local:CLang.NewProj}}"
                        DockPanel.Dock="Right"
                        IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                        Style="{DynamicResource ButtonDanger}" />
                        <Button
                        Width="80"
                        Margin="10,2"
                        Command="{Binding AddCommand}"
                        Content="{Binding [Add], Source={x:Static local:CLang.NewProj}}"
                        DockPanel.Dock="Right"
                        IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                        Style="{DynamicResource ButtonPrimary}" />
                    </DockPanel>
                </GroupBox.Header>
                <DataGrid
                x:Name="dataGrid1"
                MinHeight="100"
                hc:DataGridAttach.ShowRowNumber="True"
                AutoGenerateColumns="False"
                HeadersVisibility="All"
                ItemsSource="{Binding CProcessGroups}"
                RowHeaderWidth="30"
                Style="{StaticResource DataGrid.Small}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                        Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                        Header="{Binding [GroupName], Source={x:Static local:CLang.NewProj}}"
                        Width="150"
                        IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                        <DataGridTextColumn
                        Binding="{Binding Description, UpdateSourceTrigger=LostFocus}"
                        Header="{Binding [GroupDesc], Source={x:Static local:CLang.NewProj}}"
                        IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </StackPanel>
        <hc:ElementGroup Grid.Row="1" Margin="10">
            <Button
            Width="100"
            Command="{Binding SureCommand}"
            Content="{Binding [Sure], Source={x:Static local:CLang.NewProj}}"
            Style="{StaticResource ButtonPrimary}" />
            <Button
            Width="100"
            Command="{Binding CancelCommand}"
            Content="{Binding [Cancel], Source={x:Static local:CLang.NewProj}}"
            Style="{StaticResource ButtonDanger}" />
        </hc:ElementGroup>
    </Grid>

</hc:Window>
