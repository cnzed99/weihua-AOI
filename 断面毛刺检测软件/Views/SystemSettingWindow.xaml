<hc:Window
    x:Class="断面毛刺检测软件.Views.SystemSettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:断面毛刺检测软件.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:断面毛刺检测软件.Models"
    Title="系统设置"
    Width="650"
    Height="330"
    d:DataContext="{d:DesignInstance Type=models:SystemSettingsModel}"
    Background="{StaticResource RegionBrush}"
    Icon="/Resources/图片/系统设置/系统设置.png"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">
    <Window.Resources>
        <Style BasedOn="{StaticResource GroupBoxTab}" TargetType="GroupBox" />
        <Style BasedOn="{StaticResource ToggleButtonSwitch}" TargetType="ToggleButton">
            <Setter Property="Background" Value="Gray" />
            <Setter Property="Margin" Value="2,5" />
            <Setter Property="hc:ToggleButtonAttach.ShowLabel" Value="True" />
        </Style>
        <Style BasedOn="{StaticResource CheckBoxBaseStyle}" TargetType="CheckBox">
            <Setter Property="Margin" Value="2,0" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownExtend}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="Minimum" Value="1" />
        </Style>
        <Style BasedOn="{StaticResource TimePickerExtend}" TargetType="hc:TimePicker">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource RadioButtonBaseStyle}" TargetType="RadioButton">
            <Setter Property="Margin" Value="7,2" />
        </Style>
        <entity:CheckConverter x:Key="checkconverter" />
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding CloseCommand}" PassEventArgsToCommand="True"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel>
        <GroupBox
            Width="250"
            DockPanel.Dock="Left"
            Header="通用设置">
            <StackPanel>

                <ToggleButton Content="离线存图和数据" IsChecked="{Binding OfflineSave}" />
                <ToggleButton Content="是否存数据库" IsChecked="{Binding IsToMysql}" />


            </StackPanel>

        </GroupBox>
        <GroupBox Header="数据清零设置">
            <StackPanel>
                <hc:ElementGroup>
                    <CheckBox Content="启用自动清零" IsChecked="{Binding AutoClearEnable}" />
                    <TextBlock d:Text="2024年3月27日 白班" Text="{Binding NowShift}" />
                </hc:ElementGroup>
                <DockPanel>
                    <hc:TimePicker
                        Name="ucdpe_DayShift"
                        hc:TitleElement.Title="白班"
                        DockPanel.Dock="Left"
                        SelectedTime="{Binding DayShift}"
                        TimeFormat="HH:mm" />
                    <hc:ElementGroup>
                        <RadioButton
                            x:Name="ucrb_EveryShift"
                            Content="每班次"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding ClearEveryDay, Converter={StaticResource checkconverter}, ConverterParameter=1}" />
                        <RadioButton
                            x:Name="ucrb_EveryDay"
                            Content="每天"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding ClearEveryDay, Converter={StaticResource checkconverter}, ConverterParameter=2}" />
                        <RadioButton
                            x:Name="ucrb_EveryWeeks"
                            Content="每周"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding ClearEveryDay, Converter={StaticResource checkconverter}, ConverterParameter=3}" />
                    </hc:ElementGroup>
                </DockPanel>
                <DockPanel>
                    <hc:TimePicker
                        Name="ucdpe_NightShift"
                        hc:TitleElement.Title="夜班"
                        SelectedTime="{Binding NightShift}"
                        TimeFormat="HH:mm" />
                    <TextBox
                        hc:TitleElement.Title="下次清零时间"
                        hc:TitleElement.TitlePlacement="Left"
                        IsReadOnly="True"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding NextClearTime, StringFormat=yyyy/MM/dd HH:mm:ss}" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

    </DockPanel>
</hc:Window>
