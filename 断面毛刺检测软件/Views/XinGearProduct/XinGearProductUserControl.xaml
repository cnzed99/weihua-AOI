<UserControl x:Class="断面毛刺检测软件.Views.XinGearProduct.XinGearProductUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:断面毛刺检测软件.Views.XinGearProduct"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:XinGearProductVM}"
             d:DesignHeight="380" d:DesignWidth="200">
    <StackPanel>
        <TextBlock Margin="15,8,0,0" Text="盘齿型号" VerticalAlignment="Center" FontSize="22" Foreground="White"/>
        <hc:ComboBox Margin="15,4,15,8"
                     Height="28"
                     Padding="6,0"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     IsEnabled="{Binding IsCatalogAvailable}"
                     ItemsSource="{Binding Models}"
                     DisplayMemberPath="Id"
                     SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <UniformGrid Rows="1" Columns="2">
            <TextBlock Margin="15,0,0,0" Text="齿数" VerticalAlignment="Center" FontSize="22" Foreground="White"/>
            <TextBlock Margin="5" Text="{Binding ToothCount}" VerticalAlignment="Center" FontSize="24" Foreground="White"/>
        </UniformGrid>
        <UniformGrid Rows="1" Columns="2">
            <TextBlock Margin="15,0,0,0" Text="侧面拍照张数" VerticalAlignment="Center" FontSize="18" Foreground="White"/>
            <TextBlock Margin="5" Text="{Binding SidePhotoCount}" VerticalAlignment="Center" FontSize="24" Foreground="White"/>
        </UniformGrid>
        <TextBlock Margin="15,8,15,0"
                   Foreground="OrangeRed"
                   TextWrapping="Wrap"
                   Text="{Binding CatalogError}"
                   ToolTip="{Binding CatalogErrorDetail}"/>
    </StackPanel>
</UserControl>
