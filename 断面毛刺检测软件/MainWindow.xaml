<hc:Window
    x:Class="断面毛刺检测软件.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:al="clr-namespace:AlgorithmDll;assembly=AlgorithmDll"
    xmlns:alarm="clr-namespace:AlarmSetCtrl;assembly=AlarmSetCtrl"
    xmlns:cov="clr-namespace:ValueConverters;assembly=ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filter="clr-namespace:SDFilter;assembly=SDFilter"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:history="clr-namespace:HistoryPlayback;assembly=HistoryPlayback"
    xmlns:local="clr-namespace:断面毛刺检测软件"
    xmlns:mark="clr-namespace:MarkControl;assembly=MarkControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:motion="clr-namespace:MotionControl;assembly=MotionControl"
    xmlns:pro="clr-namespace:ProjProduceData;assembly=ProjProduceData"
    xmlns:qua="clr-namespace:QualityGrade;assembly=QualityGrade"
    xmlns:svg1="https://github.com/dotnetprojects/SVGImage"
    xmlns:viewmodels="clr-namespace:WH.DetectSystem.ViewModels;assembly=WH.DetectSystem"
    xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
    Title=""
    Width="1400"
    Height="850"
    d:DataContext="{d:DesignInstance Type=viewmodels:CMainModelsModelVM}"
    Closing="Window_Closing"
    Icon="/Resources/logo1.png"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:Window.Resources>
        <cov:BoolToBrushConverter
            x:Key="AlarmToBrushConverter"
            FalseValue="{x:Null}"
            TrueValue="{DynamicResource DangerBrush}" />
    </hc:Window.Resources>
    <!--  菜单栏  -->
    <hc:Window.NonClientAreaContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu
                Grid.Column="0"
                hc:MenuAttach.PopupHorizontalOffset="-125"
                hc:WindowAttach.IsDragElement="True">
                <MenuItem Header="{Binding [ProjManagement], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.ItemContainerStyle>
                        <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Width" Value="100" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/文件/主页.svg" />
                    </MenuItem.Icon>
                    <MenuItem Click="NewProj_Click" Header="{Binding [NewProj], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/新建工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="OpenProj_Click" Header="{Binding [OpenProj], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/打开工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="SaveCurrentProj_Click" Header="{Binding [SaveProj], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/保存工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="SaveAs_Click" Header="{Binding [Saveas], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/另存工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="ModifyProj_Click" Header="{Binding [ModifyProj], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/修改工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Header="{Binding [RecentProj], Source={x:Static local:CLang.Instance}}"
                        ItemsSource="{Binding SystemSettings.RecentProjs}"
                        MenuItem.Click="Recent_Click">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/最近打开.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <!--<MenuItem Header="{Binding [ImageManagement], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/图片设置/图片设置.svg" />
                    </MenuItem.Icon>

                </MenuItem>-->

                <MenuItem Header="{Binding [CamCom], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/相机通讯/相机通讯.svg" />
                    </MenuItem.Icon>
                    <MenuItem
                        Width="100"
                        Click="CamSet_Click"
                        Header="{Binding [Camera], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/相机通讯/相机.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="CommSet_Click"
                        Header="{Binding [Communication], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/相机通讯/通讯.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding [SystemSettings], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/系统设置/系统设置.svg" />
                    </MenuItem.Icon>
                    <MenuItem
                        Width="100"
                        Click="SystemSetting_Click"
                        Header="{Binding [SystemSettings], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/系统设置/系统设置.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="Mysql_Click"
                        Header="{Binding [Statistics], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/数据统计/数据库设置.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="SaveImageSetting_Click"
                        Header="{Binding [ImageSave], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/图片设置/图片.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding [DataStatistics], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/数据统计/数据统计.svg" />
                    </MenuItem.Icon>
                    <MenuItem
                        Width="100"
                        Click="DataQuery_Click"
                        Header="{Binding [DataStatistics], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/数据统计/数据查询.svg" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem
                        Width="100"
                        Click="DataClear_Click"
                        Header="{Binding [DataClear], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/数据统计/数据清空.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding [Tools], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/工具/工具.svg" />
                    </MenuItem.Icon>
                    <MenuItem
                        Width="100"
                        Click="OffLineTest_Click"
                        Header="{Binding [Offline], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/工具/离线检测.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="LightControl_Click"
                        Header="{Binding [LightControl], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/工具/光源.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="Screenshot_Click"
                        Header="{Binding [ScreenShot], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/图片设置/截屏保存.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding [Help], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/帮助/帮助.svg" />
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="{Binding [HelpDoc], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/帮助/帮助文档.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Header="{Binding [Lang], Source={x:Static local:CLang.Instance}}"
                        IsCheckable="True"
                        IsChecked="{Binding SystemSettings.IsEnglish}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/语言/语言.svg" />
                        </MenuItem.Icon>
                        <!--<MenuItem.ItemContainerStyle>
                            <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                                <Setter Property="Width" Value="100" />
                            </Style>
                        </MenuItem.ItemContainerStyle>-->
                        <!--<CheckBox
                            Name="cbLang"
                            Checked="Lang_Checked"
                            Content="en_US"
                            IsChecked="{Binding SystemSettings.IsEnglish}"
                            Unchecked="Lang_Checked" />-->
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="About_Click"
                        Header="{Binding [About], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/帮助/关于.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

            </Menu>
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                hc:WindowAttach.IsDragElement="True"
                FontSize="20"
                Text="{Binding CMainVMs[0].Name}" />
            <hc:SimplePanel Grid.Column="2" HorizontalAlignment="Right">

                <ToggleButton
                    Checked="cbSkin_Checked"
                    IsChecked="True"
                    Style="{StaticResource ToggleButtonGorgeousThemeSwitchStyle}"
                    Unchecked="cbSkin_Checked" />
            </hc:SimplePanel>
        </Grid>
    </hc:Window.NonClientAreaContent>
    <!--  中间内容  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <!--  次菜单栏  -->
        <DockPanel Grid.Row="0">

            <StackPanel Width="150" HorizontalAlignment="Left">
                <Image
                    Margin="5"
                    HorizontalAlignment="Left"
                    Source="/Resources/组合-2.png" />
                <TextBlock HorizontalAlignment="Center" Text="{Binding version, StringFormat='{}Version:{0}'}" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Margin="5"
                    Background="{DynamicResource ThirdlyRegionBrush}"
                    CornerRadius="10">
                    <pro:ProduceData DataContext="{Binding CMainVMs[0].DefectsDataVM}" FontSize="15" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <UniformGrid Columns="1">
                        <Label
                            Width="80"
                            Background="{Binding CMainVMs[0].MotionCtrlVM.IsAlarmAxis, Converter={StaticResource AlarmToBrushConverter}}"
                            Content="{Binding [轴报警], Source={x:Static local:CLang.Instance}}" />
                        <Label
                            Width="80"
                            Background="{Binding CMainVMs[0].MotionCtrlVM.IsDriveAlarm, Converter={StaticResource AlarmToBrushConverter}}"
                            Content="{Binding [驱动器报警], Source={x:Static local:CLang.Instance}}" />
                    </UniformGrid>
                    <Button
                        Height="70"
                        Margin="10,0"
                        Click="ClearGrowlMessage_Click"
                        Content="清空报警"
                        Style="{StaticResource ButtonDashedInfo}" />
                    <!--  启停按钮  -->
                    <ToggleButton
                        x:Name="Btn_StartStop"
                        Grid.Column="2"
                        Width="70"
                        Height="70"
                        Margin="10,0"
                        IsChecked="{Binding CMainVMs[0].StartStop, Mode=OneWayToSource}"
                        Style="{DynamicResource ToggleButtonFlip}">
                        <hc:StatusSwitchElement.CheckedElement>
                            <Border Margin="-2" Background="{DynamicResource DangerBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [Stop], Source={x:Static local:CLang.Instance}}" />
                            </Border>
                        </hc:StatusSwitchElement.CheckedElement>
                        <Border Margin="-2" Background="{DynamicResource SuccessBrush}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding [Start], Source={x:Static local:CLang.Instance}}" />
                        </Border>
                    </ToggleButton>
                    <!--  系统时间  -->
                    <StackPanel
                        Grid.Column="3"
                        Margin="10,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,3"
                            HorizontalAlignment="Center"
                            DockPanel.Dock="Right"
                            Text="{Binding [SystemTime], Source={x:Static local:CLang.Instance}}" />
                        <TextBlock
                            d:Text="2024-04-02"
                            DockPanel.Dock="Right"
                            Text="{Binding SystemTime}"
                            TextAlignment="Center" />

                    </StackPanel>
                    <!--  用户登录  -->
                    <StackPanel Grid.Column="4" Width="80">
                        <Button
                            x:Name="btn_UserLogin"
                            Width="50"
                            Height="50"
                            Margin="5"
                            Padding="0"
                            BorderBrush="#FFC6C6C6"
                            Click="btn_UserLogin_Click">
                            <Button.Background>
                                <ImageBrush
                                    x:Name="btn_UserLoginImg"
                                    d:ImageSource="pack://application:,,,/WH.Controls;component/Controls/UserLogin/Imgs/未登录.png"
                                    ImageSource="{Binding LoginViewModel.LoginPerson.LogoImage}"
                                    Stretch="Uniform" />
                            </Button.Background>
                            <Button.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding LoginViewModel.LoginPerson.UserName}" />
                                    <TextBlock Text="{Binding LoginViewModel.LoginPerson.PrivileageLevel, Converter={StaticResource StringAttrEnumConverter}}" />
                                </StackPanel>
                            </Button.ToolTip>
                        </Button>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                            <TextBlock d:Text="00" Text="{Binding LoginViewModel.ILoginLeftTimeMinute}" />
                            <TextBlock Text="{Binding [Minute], Source={x:Static local:CLang.Instance}}" />
                            <TextBlock d:Text="00" Text="{Binding LoginViewModel.ILoginLeftTimeSecond}" />
                            <TextBlock Text="{Binding [Second], Source={x:Static local:CLang.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>


            </Grid>

        </DockPanel>
        <!--  中间内容  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <UniformGrid Grid.Column="0" Rows="2">
                <Border
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{Binding CMainVMs[0].ModelBrush}"
                    BorderThickness="3">
                    <wh:ImageView Operator="{Binding CMainVMs[0].CurView, Mode=OneWayToSource}" Source="{Binding CMainVMs[0].ModelImage}" />
                </Border>
                <Border
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{Binding CMainVMs[0].LastBrush}"
                    BorderThickness="3">
                    <wh:ImageView
                        d:Source="D://铝极.png"
                        Operator="{Binding CMainVMs[0].LastView, Mode=OneWayToSource}"
                        Source="{Binding CMainVMs[0].LastImage}" />
                </Border>

            </UniformGrid>
            <!--  中间设置栏  -->
            <hc:TabControl
                Grid.Column="1"
                IsAnimationEnabled="True"
                IsTabFillEnabled="True"
                SelectedIndex="0"
                Style="{DynamicResource TabControlInLine}">
                <hc:TabItem Header="{Binding [DetectArea], Source={x:Static local:CLang.Instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <filter:FilterResultCtrl DataContext="{Binding CMainVMs[0].SDFilterVM}" />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="{Binding [Quality], Source={x:Static local:CLang.Instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <qua:QualityGradeCtrl DataContext="{Binding CMainVMs[0].QualityVM}" />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="{Binding [AlgorParam], Source={x:Static local:CLang.Instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <al:MaociAlgorParamCtrl DataContext="{Binding CMainVMs[0].MaociAlgorVM}" />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="{Binding [DetectConfig], Source={x:Static local:CLang.Instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <filter:SDFilterCtrl DataContext="{Binding CMainVMs[0].SDFilterVM}" />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="{Binding [AlarmConfig], Source={x:Static local:CLang.Instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <alarm:AlarmSetCtrl DataContext="{Binding CMainVMs[0].AlarmSetVM}" />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="{Binding [MarkConfig], Source={x:Static local:CLang.Instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <mark:MarkCtrl DataContext="{Binding CMainVMs[0].MarkCtrlVM}" />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="{Binding [MotionControl], Source={x:Static local:CLang.Instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <motion:MotionCtrl DataContext="{Binding CMainVMs[0].MotionCtrlVM}" />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="{Binding [History], Source={x:Static local:CLang.Instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <history:HistoryCtrl x:Name="histable" DataContext="{Binding CMainVMs[0].HistoryVM}" />
                    </hc:SimplePanel>
                </hc:TabItem>
            </hc:TabControl>
            <!--  右侧统计栏 消息栏 离线  -->
            <hc:SimplePanel Grid.Column="2">
                <hc:TabControl
                    Grid.Row="2"
                    IsAnimationEnabled="True"
                    IsTabFillEnabled="True"
                    SelectedIndex="0"
                    Style="{DynamicResource TabControlInLine}">
                    <hc:TabItem Header="{Binding [DefectList], Source={x:Static local:CLang.Instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <pro:DefectsDataV DataContext="{Binding CMainVMs[0].DefectsDataVM}" />
                        </hc:SimplePanel>
                    </hc:TabItem>
                    <hc:TabItem Header="{Binding [Message], Source={x:Static local:CLang.Instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <hc:TabControl
                                Grid.Column="2"
                                IsAnimationEnabled="True"
                                IsTabFillEnabled="True"
                                SelectedIndex="0"
                                Style="{DynamicResource TabControlInLine}">
                                <!--  运行日志  -->
                                <hc:TabItem Background="{DynamicResource RegionBrush}" Header="{Binding [RuningLog], Source={x:Static local:CLang.Instance}}">
                                    <wh:LogCtrl LogMessage="{Binding SysLog.InfoMessage}" />
                                </hc:TabItem>
                                <!--  报警错误日志  -->
                                <hc:TabItem Background="{DynamicResource RegionBrush}" Header="{Binding [WarningLog], Source={x:Static local:CLang.Instance}}">
                                    <wh:LogCtrl LogMessage="{Binding SysLog.ErrorMessage}" />
                                </hc:TabItem>
                                <!--  操作记录  -->
                                <hc:TabItem Background="{DynamicResource RegionBrush}" Header="{Binding [OperateRecord], Source={x:Static local:CLang.Instance}}">
                                    <wh:LogCtrl LogMessage="{Binding OperateLog.AllMessage}" />
                                </hc:TabItem>
                            </hc:TabControl>
                        </hc:SimplePanel>
                    </hc:TabItem>

                </hc:TabControl>

            </hc:SimplePanel>

        </Grid>

        <!--<hc:Drawer Dock="Right" ShowMode="Cover" IsOpen="{Binding ElementName=Btn_StartStop,Path=IsChecked}" ShowMask="False" MaskCanClose="False">
            <hc:SimplePanel  Width="300" Background="{DynamicResource RegionBrush}">
                <TextBlock Text="抽屉窗口"/>
                <Button Style="{DynamicResource ButtonIcon}" Command="hc:ControlCommands.Close" hc:IconElement.Geometry="{DynamicResource DeleteFillCircleGeometry}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </hc:SimplePanel>

        </hc:Drawer>-->
        <!--  状态栏  -->
        <DockPanel Grid.Row="2">
            <StackPanel
                Margin="5,0"
                DockPanel.Dock="Left"
                Orientation="Horizontal">
                <TextBlock Text="{Binding [Algorithm], Source={x:Static local:CLang.Instance}}" />
                <TextBlock Margin="2,0" Text="{Binding CMainVMs[0].AlgorithmTime}" />
                <TextBlock Text="ms" />
                <TextBlock Margin="10,0,0,0" Text="{Binding [Filter], Source={x:Static local:CLang.Instance}}" />
                <TextBlock Margin="2,0" Text="{Binding CMainVMs[0].FilterTime}" />
                <TextBlock Text="ms" />

            </StackPanel>
            <DockPanel LastChildFill="True">
                <TextBlock
                    d:Text="02:22:22"
                    DockPanel.Dock="Right"
                    Text="{Binding RuningTime}" />
                <TextBlock
                    Margin="5,0"
                    DockPanel.Dock="Right"
                    Text="{Binding [RunTime], Source={x:Static local:CLang.Instance}}" />



                <TextBlock
                    Margin="5,0"
                    DockPanel.Dock="Right"
                    Foreground="{StaticResource DarkInfoBrush}"
                    Text="{Binding ProjPath}" />
                <TextBlock
                    Margin="5,0"
                    DockPanel.Dock="Right"
                    Text="{Binding [ProjPath], Source={x:Static local:CLang.Instance}}" />
                <TextBlock
                    x:Name="lb_UserName"
                    DockPanel.Dock="Right"
                    Foreground="{StaticResource InfoBrush}"
                    Text="{Binding LoginViewModel.LoginPerson.PrivileageLevel, Converter={StaticResource StringAttrEnumConverter}}" />
                <hc:Divider Width="5" DockPanel.Dock="Right" />
                <TextBlock
                    x:Name="lb_UserPrivalige"
                    DockPanel.Dock="Right"
                    Foreground="{StaticResource InfoBrush}"
                    Text="{Binding LoginViewModel.LoginPerson.UserName}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding [CurrentUser], Source={x:Static local:CLang.Instance}}" />
                <hc:SimplePanel DockPanel.Dock="Left" />
            </DockPanel>

        </DockPanel>
        <!--  消息弹窗  -->
        <ScrollViewer
            Grid.Row="1"
            Grid.RowSpan="2"
            MaxHeight="500"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel
                Margin="0,10,0,20"
                VerticalAlignment="Bottom"
                hc:Growl.GrowlParent="True" />
        </ScrollViewer>
        <hc:CircleProgressBar
            Name="LoadProgressBar"
            Grid.Row="1"
            Width="200"
            Height="200"
            d:Visibility="Hidden"
            ArcThickness="10"
            FontSize="20"
            Style="{DynamicResource ProgressBarInfoCircle}"
            Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}"
            Value="50" />
    </Grid>
</hc:Window>
