<hc:Window x:Class="断面毛刺检测软件.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:svg1="https://github.com/dotnetprojects/SVGImage"
           xmlns:local="clr-namespace:断面毛刺检测软件"
           xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
           xmlns:viewmodels="clr-namespace:断面毛刺检测软件.ViewModels"
          
           Title=""
           Width="1400"
           Height="850"
           d:DataContext="{d:DesignInstance Type=viewmodels:MainVM}"
           Icon="/Resources/logo1.png"
           WindowStartupLocation="CenterScreen"
           Loaded="Window_Loaded"
           Closing="Window_Closing"
           mc:Ignorable="d">
    <!-- 菜单栏 -->
    <hc:Window.NonClientAreaContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu Grid.Column="0" hc:MenuAttach.PopupHorizontalOffset="-125" hc:WindowAttach.IsDragElement="True">
                <MenuItem Header="{Binding [ProjManagement], Source={x:Static local:Lang.instance}}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Width" Value="100" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/主页.svg" />
                    </MenuItem.Icon>
                    <MenuItem Header="{Binding [NewProj], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/添加.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [OpenProj], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/书籍.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [SaveProj], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/保存.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [Saveas], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/复制另存.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [ModifyProj], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/设置面板.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding [RecentProj], Source={x:Static local:Lang.instance}}" ItemsSource="{Binding SystemSettings.RecentProjs}" MenuItem.Click="Recent_Click">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/最近打开.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding [ImageManagement], Source={x:Static local:Lang.instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/图片设置.svg" />
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="{Binding [ImageSave], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/图片.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="{Binding [ScreenShot], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/桌面.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="{Binding [CamCom], Source={x:Static local:Lang.instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/拍照.svg" />
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="{Binding [Camera], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/相机.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="{Binding [Communication], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/通讯.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding [SystemSettings], Source={x:Static local:Lang.instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/系统设置.svg" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding [DataStatistics], Source={x:Static local:Lang.instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/政府银行.svg" />
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="{Binding [Statistics], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/实时监控.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="{Binding [DataClear], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/垃圾桶.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding [Tools], Source={x:Static local:Lang.instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/工具.svg" />
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="{Binding [Offline], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/离线检测.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="{Binding [LightControl], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/光源.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding [Help], Source={x:Static local:Lang.instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/微笑.svg" />
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="{Binding [HelpDoc], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/书本.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="{Binding [About], Source={x:Static local:Lang.instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/圆形问号.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{Binding [Lang], Source={x:Static local:Lang.instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/地球.svg" />
                    </MenuItem.Icon>
                    <CheckBox Name="cbLang"
                              Content="en_US"
                              Checked="Lang_Checked"
                              Unchecked="Lang_Checked" />
                </MenuItem>
            </Menu>
            <TextBlock Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       hc:WindowAttach.IsDragElement="True"
                       Text="{Binding Name}"
                       FontSize="20" />
            <hc:SimplePanel Grid.Column="2" HorizontalAlignment="Right">
                <!--<Button Click="ButtonConfig_OnClick" Name="ButtonConfig" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource ConfigGeometry}"/>
                <Popup AllowsTransparency="True" PlacementTarget="{Binding ElementName=ButtonConfig}" Placement="Center"  Name="PopupConfig" VerticalOffset="80" StaysOpen="False">
                    <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="4" Margin="16" Effect="{StaticResource EffectShadow2}">
                        <StackPanel Orientation="Horizontal">

                            <hc:Divider LineStrokeDashArray="2,2" Orientation="Vertical" Margin="0,20" LineStrokeThickness="1"/>
                            <StackPanel Button.Click="ButtonSkins_OnClick"  Margin="10,10,10,10">
                                <Button Tag="{x:Static hc:SkinType.Default}" Style="{StaticResource ButtonCustom}">
                                    <Border Background="White" Width="32" Height="21" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                                </Button>
                                <Button Tag="{x:Static hc:SkinType.Dark}" Style="{StaticResource ButtonCustom}" Margin="0,10,0,0">
                                    <Border Background="Black" Width="32" Height="21" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                                </Button>
                                <Button Tag="{x:Static hc:SkinType.Violet}" Style="{StaticResource ButtonCustom}" Margin="0,10,0,0">
                                    <Border Background="DarkViolet" Width="32" Height="21" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>-->
                <ToggleButton Style="{StaticResource ToggleButtonGorgeousThemeSwitchStyle}"
                              Checked="cbSkin_Checked"
                              Unchecked="cbSkin_Checked"
                              IsChecked="True" />
            </hc:SimplePanel>
        </Grid>
    </hc:Window.NonClientAreaContent>
    <!-- 中间内容 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <!-- 次菜单栏 -->
        <DockPanel Grid.Row="0">

            <StackPanel Width="150" HorizontalAlignment="Left">
                <Image Margin="5" HorizontalAlignment="Left" Source="/Resources/组合-2.png" />
                <TextBlock HorizontalAlignment="Center" Text="Version:1.0.0.0" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 启停按钮 -->
                <ToggleButton x:Name="Btn_StartStop"
                              Grid.Column="1"
                              Width="70"
                              Height="70"
                              Margin="10,0"
                              Style="{DynamicResource ToggleButtonFlip}"
                              IsChecked="{Binding StartStop, Mode=OneWayToSource}">
                    <hc:StatusSwitchElement.CheckedElement>
                        <Border Margin="-1" Background="{DynamicResource DangerBrush}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding [Stop], Source={x:Static local:Lang.instance}}" />
                        </Border>
                    </hc:StatusSwitchElement.CheckedElement>
                    <Border Margin="-1" Background="{DynamicResource SuccessBrush}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding [Start], Source={x:Static local:Lang.instance}}" />
                    </Border>
                </ToggleButton>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Margin="5,5,5,0" HorizontalAlignment="Center" Text="{Binding [SystemTime], Source={x:Static local:Lang.instance}}" />
                    <TextBlock HorizontalAlignment="Center"
                               d:Text="2024-04-02"
                               TextAlignment="Center"
                               Text="{Binding SystemTime}" />
                    <TextBlock Margin="5,0" TextAlignment="Center" Text="{Binding [RunTime], Source={x:Static local:Lang.instance}}" />
                    <TextBlock HorizontalAlignment="Center" d:Text="02:22:22" Text="{Binding RuningTime}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Width="80">
                    <Button x:Name="btn_UserLogin" Width="50"
                            Height="50"
                            Margin="5"
                            Padding="0"
                            BorderBrush="#FFC6C6C6"
                            Click="btn_UserLogin_Click">
                        <Button.Background>
                            <ImageBrush x:Name="btn_UserLoginImg" Stretch="Uniform" ImageSource="/Resources/图片/风险盾牌安全.png" />
                        </Button.Background>

                    </Button>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                        <TextBlock Text="{Binding MinuteLeft}" />
                        <TextBlock Text="{Binding [Minute], Source={x:Static local:Lang.instance}}" />
                        <TextBlock Text="{Binding SecondLeft}" />
                        <TextBlock Text="{Binding [Second], Source={x:Static local:Lang.instance}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

        </DockPanel>
        <!-- 中间内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <UniformGrid Grid.Column="0" Rows="2">
                <hc:SimplePanel Background="#FF181A1C">
                    <wh:ImageView />
                </hc:SimplePanel>
                <hc:SimplePanel Background="#FF10100F">
                    <wh:ImageView />
                </hc:SimplePanel>
            </UniformGrid>
            <!-- 中间设置栏 -->
            <hc:TabControl Grid.Column="1"
                           SelectedIndex="0"
                           IsAnimationEnabled="True"
                           IsTabFillEnabled="True"
                           Style="{DynamicResource TabControlInLine}">
                <hc:TabItem Header="{Binding [DetectArea], Source={x:Static local:Lang.instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}" />
                </hc:TabItem>
                <hc:TabItem Header="{Binding [Quality], Source={x:Static local:Lang.instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}" />
                </hc:TabItem>
                <hc:TabItem Header="{Binding [DetectConfig], Source={x:Static local:Lang.instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}" />
                </hc:TabItem>
                <hc:TabItem Header="{Binding [AlarmConfig], Source={x:Static local:Lang.instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}" />
                </hc:TabItem>
                <hc:TabItem Header="{Binding [MarkConfig], Source={x:Static local:Lang.instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}" />
                </hc:TabItem>
                <hc:TabItem Header="{Binding [MotionControl], Source={x:Static local:Lang.instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}" />
                </hc:TabItem>
                <hc:TabItem Header="{Binding [History], Source={x:Static local:Lang.instance}}">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}" />
                </hc:TabItem>
            </hc:TabControl>
            <!-- 右侧统计栏 消息栏 离线 -->
            <hc:SimplePanel Grid.Column="2">
                <hc:TabControl Grid.Row="2"
                               SelectedIndex="0"
                               IsAnimationEnabled="True"
                               IsTabFillEnabled="True"
                               Style="{DynamicResource TabControlInLine}">
                    <hc:TabItem Header="{Binding [DefectList], Source={x:Static local:Lang.instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}" />
                    </hc:TabItem>
                    <hc:TabItem Header="{Binding [Message], Source={x:Static local:Lang.instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <hc:TabControl Grid.Column="2"
                                           SelectedIndex="0"
                                           IsAnimationEnabled="True"
                                           IsTabFillEnabled="True"
                                           Style="{DynamicResource TabControlInLine}">
                                <hc:TabItem Header="{Binding [RuningLog], Source={x:Static local:Lang.instance}}" Background="{DynamicResource RegionBrush}" />
                                <hc:TabItem Header="{Binding [WarningLog], Source={x:Static local:Lang.instance}}" Background="{DynamicResource RegionBrush}" />
                            </hc:TabControl>
                        </hc:SimplePanel>
                    </hc:TabItem>

                </hc:TabControl>

            </hc:SimplePanel>

        </Grid>
        <!--<hc:Drawer Dock="Right" ShowMode="Cover" IsOpen="{Binding ElementName=Btn_StartStop,Path=IsChecked}" ShowMask="False" MaskCanClose="False">
            <hc:SimplePanel  Width="300" Background="{DynamicResource RegionBrush}">
                <TextBlock Text="抽屉窗口"/>
                <Button Style="{DynamicResource ButtonIcon}" Command="hc:ControlCommands.Close" hc:IconElement.Geometry="{DynamicResource DeleteFillCircleGeometry}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </hc:SimplePanel>

        </hc:Drawer>-->
        <!-- 状态栏 -->
        <DockPanel Grid.Row="2">
            <StackPanel Margin="5,0" Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="{Binding [Algorithm], Source={x:Static local:Lang.instance}}" />
                <TextBlock Margin="2,0" Text="50" />
                <TextBlock Text="ms" />
                <TextBlock Margin="10,0,0,0" Text="{Binding [Filter], Source={x:Static local:Lang.instance}}" />
                <TextBlock Margin="2,0" Text="50" />
                <TextBlock Text="ms" />

            </StackPanel>
            <Grid Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="5,0"
                           HorizontalAlignment="Right"
                           Text="{Binding [ProjPath], Source={x:Static local:Lang.instance}}" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding ProjPath}" />
            </Grid>
        </DockPanel>
        <!-- 消息弹窗 -->
        <ScrollViewer Grid.Row="1"
                      Grid.RowSpan="2"
                      MaxHeight="500"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="0,10,0,20" VerticalAlignment="Bottom" hc:Growl.GrowlParent="True" />
        </ScrollViewer>

    </Grid>
</hc:Window>
