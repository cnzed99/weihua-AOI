<hc:Window
    x:Class="断面毛刺检测软件.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:al="clr-namespace:AlgorithmDll;assembly=AlgorithmDll"
    xmlns:alarm="clr-namespace:AlarmSetCtrl;assembly=AlarmSetCtrl"
    xmlns:cov="clr-namespace:ValueConverters;assembly=ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:filter="clr-namespace:SDFilter;assembly=SDFilter"
    xmlns:focus="clr-namespace:FocusControl;assembly=FocusControl"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:history="clr-namespace:HistoryPlayback;assembly=HistoryPlayback"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:light="clr-namespace:WH.LightControl;assembly=WH.LightControl"
    xmlns:local="clr-namespace:断面毛刺检测软件"
    xmlns:mark="clr-namespace:MarkControl;assembly=MarkControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mo="clr-namespace:Motion;assembly=Motion"
    xmlns:pro="clr-namespace:ProjProduceData;assembly=ProjProduceData"
    xmlns:qua="clr-namespace:QualityGrade;assembly=QualityGrade"
    xmlns:svg1="https://github.com/dotnetprojects/SVGImage"
    xmlns:viewmodels="clr-namespace:WH.DetectSystem.ViewModels;assembly=WH.DetectSystem"
    xmlns:wh="http://whzn.com/rjkf/2024/xaml"
    Title=""
    Width="1400"
    Height="850"
    d:DataContext="{d:DesignInstance Type=viewmodels:CMainModelsModelVM}"
    Closing="Window_Closing"
    Icon="/Resources/logo1.png"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:Window.Resources>
        <cov:BoolToBrushConverter
            x:Key="AlarmToBrushConverter"
            FalseValue="{StaticResource BorderBrush}"
            TrueValue="Red" />
        <cov:SubtractConverter x:Key="SubtractConverter" />
        <local:ColumnCountConverter x:Key="ColumnCountConverter" />
        <entity:String2VisiblityReConverter x:Key="Count2VisiblityReConverter" />
        <wh:CBindingProxy x:Key="CurUser" Data="{Binding LoginViewModel.LoginPerson}" />
        <wh:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
    </hc:Window.Resources>
    <!--  菜单栏  -->
    <hc:Window.NonClientAreaContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu
                x:Name="MainMenu"
                Grid.Column="0"
                hc:MenuAttach.PopupHorizontalOffset="-125"
                hc:WindowAttach.IsDragElement="True">
                <MenuItem Name="ProjMenu" Header="{Binding [ProjManagement], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.ItemContainerStyle>
                        <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="MenuItem">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Width" Value="100" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/文件/主页.svg" />
                    </MenuItem.Icon>
                    <MenuItem Click="NewProj_Click" Header="{Binding [NewProj], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/新建工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="OpenProj_Click" Header="{Binding [OpenProj], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/打开工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="SaveCurrentProj_Click" Header="{Binding [SaveProj], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/保存工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="SaveAs_Click" Header="{Binding [Saveas], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/另存工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="ModifyProj_Click" Header="{Binding [ModifyProj], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/修改工程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="AddProcess_Click" Header="{Binding [AddProc], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/增加制程.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Header="{Binding [RecentProj], Source={x:Static local:CLang.Instance}}"
                        IsEnabled="{Binding IsOperator, Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                        ItemsSource="{Binding SystemSettings.RecentProjs}"
                        MenuItem.Click="Recent_Click">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/文件/最近打开.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Name="CamComMenu" Header="{Binding [CamCom], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/相机通讯/相机通讯.svg" />
                    </MenuItem.Icon>
                    <MenuItem
                        Width="100"
                        Click="CamSet_Click"
                        Header="{Binding [Camera], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/相机通讯/相机.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        ItemsSource="{Binding ListCommSetParam}"
                        MenuItem.Click="CommInstance_Click">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/相机通讯/通讯.svg" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock PreviewMouseLeftButtonDown="CommSet_Click" Text="{Binding [Communication], Source={x:Static local:CLang.Instance}}" />
                        </MenuItem.Header>
                    </MenuItem>
                </MenuItem>
                <MenuItem Name="SetMenu" Header="{Binding [SystemSettings], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/系统设置/系统设置.svg" />
                    </MenuItem.Icon>
                    <MenuItem
                        Width="100"
                        Click="SystemSetting_Click"
                        Header="{Binding [SystemSettings], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/系统设置/系统设置.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="Mysql_Click"
                        Header="{Binding [Statistics], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/数据统计/数据库设置.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="SaveImageSetting_Click"
                        Header="{Binding [ImageSave], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/图片设置/图片.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Name="DataMenu" Header="{Binding [DataStatistics], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/数据统计/数据统计.svg" />
                    </MenuItem.Icon>
                    <MenuItem
                        Width="100"
                        Click="DataQuery_Click"
                        Header="{Binding [DataStatistics], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/数据统计/数据查询.svg" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem
                        Width="100"
                        Click="DataClear_Click"
                        Header="{Binding [DataClear], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/数据统计/数据清空.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Name="ToolMenu" Header="{Binding [Tools], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/工具/工具.svg" />
                    </MenuItem.Icon>
                    <MenuItem
                        Width="100"
                        Click="OffLineTest_Click"
                        Header="{Binding [Offline], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/工具/离线检测.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="ManualDebug_Click"
                        Header="{Binding [手动调试], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/工具/手动调试.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        ItemsSource="{Binding LightNames}"
                        MenuItem.Click="LightItem_Click">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/工具/光源.svg" />
                        </MenuItem.Icon>
                        <MenuItem.Header>
                            <TextBlock PreviewMouseLeftButtonDown="lightControl_Cilck" Text="{Binding [LightControl], Source={x:Static local:CLang.Instance}}" />
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="Screenshot_Click"
                        Header="{Binding [ScreenShot], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/图片设置/截屏保存.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="MotionPlug_Click"
                        Visibility="{Binding Source={x:Static mo:CMotionManagement.MotionHeper}, Converter={StaticResource EmptyToVisibilityConverter}}"
                        Header="{Binding [Motion], Source={x:Static local:CLang.Instance}}">
                    </MenuItem>
                </MenuItem>
                <MenuItem Name="HelpMenu" Header="{Binding [Help], Source={x:Static local:CLang.Instance}}">
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/帮助/帮助.svg" />
                    </MenuItem.Icon>
                    <MenuItem
                        Width="100"
                        Command="{Binding HelpLocalHostCommand}"
                        Header="{Binding [HelpDoc], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/帮助/帮助文档.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Header="{Binding [Lang], Source={x:Static local:CLang.Instance}}"
                        IsCheckable="True"
                        IsChecked="{Binding SystemSettings.IsEnglish}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/语言/语言.svg" />
                        </MenuItem.Icon>

                    </MenuItem>
                    <MenuItem
                        Width="100"
                        Click="About_Click"
                        Header="{Binding [About], Source={x:Static local:CLang.Instance}}">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/帮助/关于.svg" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

            </Menu>
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                hc:WindowAttach.IsDragElement="True"
                FontSize="20"
                Text="{Binding CMainMModel.Name}" />
            <hc:SimplePanel Grid.Column="2" HorizontalAlignment="Right">
                <ToggleButton IsChecked="{Binding IsDark, Source={x:Static local:GlobalData.Config}}" Style="{StaticResource ToggleButtonGorgeousThemeSwitchStyle}" />
            </hc:SimplePanel>
        </Grid>
    </hc:Window.NonClientAreaContent>
    <!--  中间内容  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <!--  次菜单栏  -->
        <DockPanel Grid.Row="0">
            <StackPanel Width="150" HorizontalAlignment="Left">
                <Image
                    Margin="5"
                    HorizontalAlignment="Left"
                    Source="/Resources/组合-2.png" />
                <TextBlock HorizontalAlignment="Center" Text="{Binding version, StringFormat='{}Version:{0}'}" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Margin="5"
                    Background="{DynamicResource ThirdlyRegionBrush}"
                    CornerRadius="10">
                    <pro:ProduceData DataContext="{Binding SelectedProcess.DefectsDataVM}" FontSize="15" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <!--<UniformGrid Columns="1">
                        <Label
                            Width="100"
                            wh:StatusDotElement.DotBrush="{Binding SelectedProcess.MotionCtrlVM.IsAlarmAxis, Converter={StaticResource AlarmToBrushConverter}}"
                            wh:StatusDotElement.Radius="10"
                            Content="{Binding [轴报警], Source={x:Static local:CLang.Instance}}"
                            Style="{StaticResource StatusDotLabel.Small}" />
                        <Label
                            Width="100"
                            wh:StatusDotElement.DotBrush="{Binding SelectedProcess.MotionCtrlVM.IsDriveAlarm, Converter={StaticResource AlarmToBrushConverter}}"
                            wh:StatusDotElement.Radius="10"
                            Content="{Binding [驱动器报警], Source={x:Static local:CLang.Instance}}"
                            Style="{StaticResource StatusDotLabel.Small}" />
                    </UniformGrid>-->
                    <Button
                        Height="70"
                        Margin="10,0"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="3"
                        Click="ClearGrowlMessage_Click"
                        Command="{Binding ResetAlarmCommand}"
                        Content="{Binding [清空报警], Source={x:Static local:CLang.Instance}}"
                        Style="{StaticResource ButtonDashedPrimary}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <ToggleButton
                        Width="70"
                        Height="70"
                        Margin="10,0"
                        FontSize="6"
                        IsChecked="{Binding ElementName=DrawerRightInContainer, Path=IsOpen}"
                        Style="{DynamicResource ToggleButtonFlip}"
                        Visibility="{Binding CMainVMs.Count, Converter={StaticResource Count2VisiblityReConverter}, ConverterParameter=1}">
                        <hc:StatusSwitchElement.CheckedElement>
                            <Border Margin="-2" Background="{DynamicResource WarningBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [CloseSum], Source={x:Static local:CLang.Instance}}" />
                            </Border>
                        </hc:StatusSwitchElement.CheckedElement>
                        <Border Margin="-2" Background="{DynamicResource PrimaryBrush}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding [OpenSum], Source={x:Static local:CLang.Instance}}" />
                        </Border>
                    </ToggleButton>
                    <!--  启停按钮  -->
                    <ToggleButton
                        x:Name="Btn_StartStop"
                        Grid.Column="2"
                        Width="70"
                        Height="70"
                        Margin="10,0"
                        FontSize="8"
                        IsChecked="{Binding StartStop}"
                        Style="{DynamicResource ToggleButtonFlip}">
                        <hc:StatusSwitchElement.CheckedElement>
                            <Border Margin="-2" Background="{DynamicResource DangerBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding [AllStop], Source={x:Static local:CLang.Instance}}" />
                            </Border>
                        </hc:StatusSwitchElement.CheckedElement>
                        <Border Margin="-2" Background="{DynamicResource SuccessBrush}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding [AllStart], Source={x:Static local:CLang.Instance}}" />
                        </Border>
                    </ToggleButton>
                    <!--  系统时间  -->
                    <StackPanel
                        Grid.Column="3"
                        Margin="10,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,3"
                            HorizontalAlignment="Center"
                            DockPanel.Dock="Right"
                            Text="{Binding [SystemTime], Source={x:Static local:CLang.Instance}}" />
                        <TextBlock
                            d:Text="2024-04-02"
                            DockPanel.Dock="Right"
                            Text="{Binding SystemTime}"
                            TextAlignment="Center" />

                    </StackPanel>
                    <!--  用户登录  -->
                    <StackPanel Grid.Column="4" Width="80">
                        <Button
                            x:Name="btn_UserLogin"
                            Width="50"
                            Height="50"
                            Margin="5"
                            Padding="0"
                            BorderBrush="#FF0DD647"
                            Click="btn_UserLogin_Click">
                            <Button.Background>
                                <ImageBrush
                                    x:Name="btn_UserLoginImg"
                                    d:ImageSource="pack://application:,,,/WH.Controls;component/Controls/UserLogin/Imgs/未登录.png"
                                    ImageSource="{Binding LoginViewModel.LoginPerson.LogoImage}"
                                    Stretch="Uniform" />
                            </Button.Background>
                            <Button.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding LoginViewModel.LoginPerson.UserName}" />
                                    <TextBlock Text="{Binding LoginViewModel.LoginPerson.PrivileageLevel, Converter={StaticResource StringAttrEnumConverter}}" />
                                </StackPanel>
                            </Button.ToolTip>
                        </Button>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                            <TextBlock d:Text="00" Text="{Binding LoginViewModel.ILoginLeftTimeMinute}" />
                            <TextBlock Text="{Binding [Minute], Source={x:Static local:CLang.Instance}}" />
                            <TextBlock d:Text="00" Text="{Binding LoginViewModel.ILoginLeftTimeSecond}" />
                            <TextBlock Text="{Binding [Second], Source={x:Static local:CLang.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>


            </Grid>

        </DockPanel>
        <!--  中间内容  -->
        <hc:DrawerContainer Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.6*" />
                    <ColumnDefinition Width="0.45*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <hc:Drawer
                    Name="DrawerRightInContainer"
                    Dock="Right"
                    MaskCanClose="False"
                    ShowMask="False"
                    ShowMode="Cover">
                    <Border
                        Width="400"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TextBlockTitle}"
                                Text="{Binding [缺陷统计汇总], Source={x:Static local:CLang.Instance}}" />
                            <Button
                                Grid.Row="0"
                                HorizontalAlignment="Right"
                                hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                                Command="hc:ControlCommands.Close"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Style="{StaticResource ButtonIcon}" />
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding CMainMModel.CProcessGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <GroupBox
                                                Margin="5"
                                                Header="{Binding Name}"
                                                Style="{StaticResource GroupBoxTab}">
                                                <pro:SummaryCtrl DataContext="{Binding CDefectsDataVM}" />
                                            </GroupBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </hc:Drawer>
                <ListBox
                    Padding="0"
                    hc:BorderElement.CornerRadius="0"
                    ItemsSource="{Binding CMainVMs}"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedProcess}">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="DarkTurquoise" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=ItemsSource.Count, Converter={StaticResource ColumnCountConverter}}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Tag="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext}">
                                <Grid.ContextMenu>
                                    <ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.Tag}">
                                        <MenuItem
                                            Click="ProcessEdit_Click"
                                            Header="{Binding [Edit], Source={x:Static local:CLang.Instance}}"
                                            IsEnabled="{Binding IsEngineer, Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                                            Tag="{Binding SelectedProcess}" />
                                        <MenuItem
                                            Command="{Binding RemoveProcessCommand}"
                                            Header="{Binding [Del], Source={x:Static local:CLang.Instance}}"
                                            IsEnabled="{Binding IsEngineer, Source={x:Static wh:CLoginViewModel.SloinPerson}}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Border
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{Binding ModelBrush}"
                                    BorderThickness="2">
                                    <wh:ImageView Operator="{Binding CurView, Mode=OneWayToSource}" Source="{Binding ModelImage}" />
                                </Border>
                                <TextBlock
                                    Margin="10,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Foreground="Red"
                                    Style="{StaticResource TextBlockDefault}"
                                    Text="{Binding FocusCtrlVM.InfoAlarm}" />
                                <TextBlock
                                    Margin="10,10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource TextBlockDefault}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{1}-{0}">
                                            <Binding Path="Name" />
                                            <Binding Path="ProcessGroup.Name" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ToggleButton
                                    Margin="0,7,90,7"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    IsChecked="{Binding IsStart}"
                                    IsEnabled="{Binding Source={StaticResource CurUser}, Path=Data.IsOperator}"
                                    Style="{DynamicResource ToggleButtonCustom}">
                                    <hc:StatusSwitchElement.CheckedElement>
                                        <Border
                                            Padding="20,3"
                                            Background="{DynamicResource DangerBrush}"
                                            CornerRadius="3">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding [Stop], Source={x:Static local:CLang.Instance}}" />
                                        </Border>
                                    </hc:StatusSwitchElement.CheckedElement>
                                    <Border
                                        Padding="20,3"
                                        Background="{DynamicResource SuccessBrush}"
                                        CornerRadius="3">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding [Start], Source={x:Static local:CLang.Instance}}" />
                                    </Border>
                                </ToggleButton>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!--  中间设置栏  -->
                <hc:TabControl
                    Grid.Column="1"
                    IsAnimationEnabled="True"
                    IsTabFillEnabled="True"
                    SelectedIndex="0"
                    Style="{DynamicResource TabControlInLine}"
                    Visibility="{Binding SelectedProcess, Converter={StaticResource EmptyToVisibilityConverter}}">
                    <hc:TabItem Padding="0" Header="{Binding [DetectArea], Source={x:Static local:CLang.Instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <filter:FilterResultCtrl DataContext="{Binding SelectedProcess.SDFilterVM}" />
                        </hc:SimplePanel>
                    </hc:TabItem>
                    <hc:TabItem Padding="0" Header="{Binding [Quality], Source={x:Static local:CLang.Instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <qua:QualityGradeCtrl DataContext="{Binding SelectedProcess.QualityVM}" />
                        </hc:SimplePanel>
                    </hc:TabItem>
                    <hc:TabItem Padding="0" Header="{Binding [AlgorParam], Source={x:Static local:CLang.Instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <al:MaociAlgorParamCtrl DataContext="{Binding SelectedProcess.MaociAlgorVM}" />
                        </hc:SimplePanel>
                    </hc:TabItem>
                    <hc:TabItem Padding="0" Header="{Binding [DetectConfig], Source={x:Static local:CLang.Instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <filter:SDFilterCtrl DataContext="{Binding SelectedProcess.SDFilterVM}" />
                        </hc:SimplePanel>
                    </hc:TabItem>
                    <hc:TabItem Padding="0" Header="{Binding [AlarmConfig], Source={x:Static local:CLang.Instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <alarm:AlarmSetCtrl DataContext="{Binding SelectedProcess.AlarmSetVM}" />
                        </hc:SimplePanel>
                    </hc:TabItem>
                    <hc:TabItem
                        Padding="0"
                        Header="{Binding [MarkConfig], Source={x:Static local:CLang.Instance}}"
                        Visibility="{Binding SelectedProcess.MarkCtrlVM, Converter={StaticResource EmptyToVisibilityConverter}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <mark:MarkCtrl DataContext="{Binding SelectedProcess.MarkCtrlVM}" />
                        </hc:SimplePanel>
                    </hc:TabItem>
                    <hc:TabItem
                        Padding="0"
                        Header="{Binding [FocusControl], Source={x:Static local:CLang.Instance}}"
                        Visibility="{Binding SelectedProcess.FocusCtrlVM, Converter={StaticResource EmptyToVisibilityConverter}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <ContentControl Content="{Binding SelectedProcess.FocusCtrlVM.TestControl}" />
                        </hc:SimplePanel>
                    </hc:TabItem>
                    <hc:TabItem Padding="0" Header="{Binding [History], Source={x:Static local:CLang.Instance}}">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <history:HistoryCtrl x:Name="histable" DataContext="{Binding SelectedProcess.HistoryVM}" />
                        </hc:SimplePanel>
                    </hc:TabItem>
                </hc:TabControl>
                <!--  右侧统计栏 消息栏 离线  -->
                <hc:SimplePanel Grid.Column="2">
                    <hc:TabControl
                        Grid.Row="2"
                        IsAnimationEnabled="True"
                        IsTabFillEnabled="True"
                        SelectedIndex="0"
                        Style="{DynamicResource TabControlInLine}">
                        <hc:TabItem Header="{Binding [DefectList], Source={x:Static local:CLang.Instance}}">
                            <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                                <pro:DefectsDataV DataContext="{Binding SelectedProcess.DefectsDataVM}" />
                            </hc:SimplePanel>
                        </hc:TabItem>
                        <hc:TabItem Header="{Binding [Message], Source={x:Static local:CLang.Instance}}">
                            <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                                <hc:TabControl
                                    Grid.Column="2"
                                    IsAnimationEnabled="True"
                                    IsTabFillEnabled="True"
                                    SelectedIndex="0"
                                    Style="{DynamicResource TabControlInLine}">
                                    <!--  运行日志  -->
                                    <hc:TabItem Background="{DynamicResource RegionBrush}" Header="{Binding [RuningLog], Source={x:Static local:CLang.Instance}}">
                                        <RichTextBox wh:ClogRecElement.LogMessage="{Binding InfoMessage, Source={x:Static wh:CLogRec.Default}}" />
                                    </hc:TabItem>
                                    <!--  报警错误日志  -->
                                    <hc:TabItem Background="{DynamicResource RegionBrush}" Header="{Binding [WarningLog], Source={x:Static local:CLang.Instance}}">
                                        <RichTextBox wh:ClogRecElement.LogMessage="{Binding ErrorMessage, Source={x:Static wh:CLogRec.Default}}" />
                                    </hc:TabItem>
                                    <!--  操作记录  -->
                                    <hc:TabItem Background="{DynamicResource RegionBrush}" Header="{Binding [OperateRecord], Source={x:Static local:CLang.Instance}}">
                                        <RichTextBox wh:ClogRecElement.LogMessage="{Binding OperateLog.AllMessage}" />
                                    </hc:TabItem>
                                </hc:TabControl>
                            </hc:SimplePanel>
                        </hc:TabItem>

                    </hc:TabControl>

                </hc:SimplePanel>

            </Grid>
        </hc:DrawerContainer>


        <!--<hc:Drawer Dock="Right" ShowMode="Cover" IsOpen="{Binding ElementName=Btn_StartStop,Path=IsChecked}" ShowMask="False" MaskCanClose="False">
            <hc:SimplePanel  Width="300" Background="{DynamicResource RegionBrush}">
                <TextBlock Text="抽屉窗口"/>
                <Button Style="{DynamicResource ButtonIcon}" Command="hc:ControlCommands.Close" hc:IconElement.Geometry="{DynamicResource DeleteFillCircleGeometry}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </hc:SimplePanel>

        </hc:Drawer>-->
        <!--  状态栏  -->
        <DockPanel Grid.Row="2">
            <StackPanel
                Margin="5,0"
                DockPanel.Dock="Left"
                Orientation="Horizontal">
                <TextBlock Text="{Binding [Algorithm], Source={x:Static local:CLang.Instance}}" />
                <TextBlock Margin="2,0" Text="{Binding SelectedProcess.AlgorithmTime}" />
                <TextBlock Text="ms" />
                <TextBlock Margin="10,0,0,0" Text="{Binding [Filter], Source={x:Static local:CLang.Instance}}" />
                <TextBlock Margin="2,0" Text="{Binding SelectedProcess.FilterTime}" />
                <TextBlock Text="ms" />

            </StackPanel>
            <DockPanel LastChildFill="True">
                <TextBlock
                    d:Text="02:22:22"
                    DockPanel.Dock="Right"
                    Text="{Binding RuningTime}" />
                <TextBlock
                    Margin="5,0"
                    DockPanel.Dock="Right"
                    Text="{Binding [RunTime], Source={x:Static local:CLang.Instance}}" />



                <TextBlock
                    Margin="5,0"
                    DockPanel.Dock="Right"
                    Foreground="{StaticResource DarkInfoBrush}"
                    Text="{Binding ProjPath}" />
                <TextBlock
                    Margin="5,0"
                    DockPanel.Dock="Right"
                    Text="{Binding [ProjPath], Source={x:Static local:CLang.Instance}}" />
                <TextBlock
                    x:Name="lb_UserName"
                    DockPanel.Dock="Right"
                    Foreground="{StaticResource InfoBrush}"
                    Text="{Binding LoginViewModel.LoginPerson.PrivileageLevel, Converter={StaticResource StringAttrEnumConverter}}" />
                <hc:Divider Width="5" DockPanel.Dock="Right" />
                <TextBlock
                    x:Name="lb_UserPrivalige"
                    DockPanel.Dock="Right"
                    Foreground="{StaticResource InfoBrush}"
                    Text="{Binding LoginViewModel.LoginPerson.UserName}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding [CurrentUser], Source={x:Static local:CLang.Instance}}" />
                <hc:SimplePanel DockPanel.Dock="Left" />
            </DockPanel>

        </DockPanel>
        <!--  消息弹窗  -->
        <ScrollViewer
            Grid.Row="1"
            Grid.RowSpan="2"
            MaxHeight="500"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel
                Margin="0,10,0,20"
                VerticalAlignment="Bottom"
                hc:Growl.GrowlParent="True" />
        </ScrollViewer>
        <StackPanel
            Grid.Row="1"
            Width="400"
            VerticalAlignment="Center"
            d:Visibility="visible"
            Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
            <hc:AnimationPath
                Width="300"
                Data="{DynamicResource logo}"
                IsPlaying="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}"
                PathLength="400"
                Stretch="Uniform"
                Stroke="{DynamicResource LoadingPathBrush}"
                StrokeThickness="1"
                Duration="00:00:5" />
            <TextBlock
                Name="LoadProgressBar"
                Margin="0,10"
                d:Text="loading"
                Foreground="{DynamicResource LoadingPathBrush}"
                Style="{StaticResource TextBlockDefault}"
                TextWrapping="Wrap" />
        </StackPanel>

    </Grid>
</hc:Window>
