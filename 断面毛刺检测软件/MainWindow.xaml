<hc:Window x:Class="断面毛刺检测软件.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:svg1="https://github.com/dotnetprojects/SVGImage"
        xmlns:local="clr-namespace:断面毛刺检测软件" 
        xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
        xmlns:viewmodels="clr-namespace:断面毛刺检测软件.ViewModels" 
        d:DataContext="{d:DesignInstance Type=viewmodels:MainVM}"
        Title=""
        Width="1400"
        Height="850"
        Icon="/Resources/logo1.png"

        WindowStartupLocation="CenterScreen"

        mc:Ignorable="d" Loaded="Window_Loaded">
    <!-- 菜单栏 -->
    <hc:Window.NonClientAreaContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Menu MouseMove="Menu_MouseMove" Grid.Column="0">
                <MenuItem Header="工程管理">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Width" Value="100"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/主页.svg"/>
                    </MenuItem.Icon>
                    <MenuItem  Header="新建工程" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/添加.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem  Header="打开工程" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/书籍.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem  Header="保存工程" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/保存.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem  Header="另存工程" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/复制另存.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem  Header="修改工程" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/设置面板.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem  Header="最近打开" ItemsSource="{Binding SystemSettings.RecentProjs}" MenuItem.Click="Recent_Click">
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/最近打开.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="图片管理"  >
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/图片设置.svg"/>
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="存图设置" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/图片.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="截屏保存" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/桌面.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="相机与通讯" >
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/拍照.svg"/>
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="相机" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/相机.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="通讯" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/通讯.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="系统设置"  >
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/系统设置.svg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="数据统计" >
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/政府银行.svg"/>
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="数据统计" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/实时监控.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="数据清空" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/垃圾桶.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="工具"  >
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/工具.svg"/>
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="离线检测" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/离线检测.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="光源控制" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/光源.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="帮助" >
                    <MenuItem.Icon>
                        <svg1:SVGImage Source="/Resources/图标/微笑.svg"/>
                    </MenuItem.Icon>
                    <MenuItem Width="100" Header="帮助文档" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/书本.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Width="100" Header="关于" >
                        <MenuItem.Icon>
                            <svg1:SVGImage Source="/Resources/图标/圆形问号.svg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
            <TextBlock Text="{Binding Name}" hc:WindowAttach.IsDragElement="True" Grid.Column="1" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <hc:SimplePanel Grid.Column="2" HorizontalAlignment="Right">
                <Button Click="ButtonConfig_OnClick" Name="ButtonConfig" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource ConfigGeometry}"/>
                <Popup AllowsTransparency="True" PlacementTarget="{Binding ElementName=ButtonConfig}" Placement="Center"  Name="PopupConfig" VerticalOffset="80" StaysOpen="False">
                    <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="4" Margin="16" Effect="{StaticResource EffectShadow2}">
                        <StackPanel Orientation="Horizontal">

                            <hc:Divider LineStrokeDashArray="2,2" Orientation="Vertical" Margin="0,20" LineStrokeThickness="1"/>
                            <StackPanel Button.Click="ButtonSkins_OnClick"  Margin="10,10,10,10">
                                <Button Tag="{x:Static hc:SkinType.Default}" Style="{StaticResource ButtonCustom}">
                                    <Border Background="White" Width="32" Height="21" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                                </Button>
                                <Button Tag="{x:Static hc:SkinType.Dark}" Style="{StaticResource ButtonCustom}" Margin="0,10,0,0">
                                    <Border Background="Black" Width="32" Height="21" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                                </Button>
                                <Button Tag="{x:Static hc:SkinType.Violet}" Style="{StaticResource ButtonCustom}" Margin="0,10,0,0">
                                    <Border Background="DarkViolet" Width="32" Height="21" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </hc:SimplePanel>
        </Grid>
    </hc:Window.NonClientAreaContent>
    <!--中间内容-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition />
            <RowDefinition Height="15" />
        </Grid.RowDefinitions>
        <!-- 次菜单栏 -->
        <DockPanel Grid.Row="0">

            <StackPanel Width="150" HorizontalAlignment="Left">
                <Image Margin="5" HorizontalAlignment="Left" Source="/Resources/组合-2.png" />
                <TextBlock HorizontalAlignment="Center" Text="Version:1.0.0.0" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--启停按钮-->
                <ToggleButton x:Name="Btn_StartStop" Grid.Column="1" Margin="10,0" Width="70" Height="70" Style="{DynamicResource ToggleButtonFlip}" IsChecked="{Binding StartStop,Mode=OneWayToSource}">
                    <hc:StatusSwitchElement.CheckedElement>
                        <Border Background="{DynamicResource DangerBrush}" Margin="-1">
                            <TextBlock Text="停止" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </hc:StatusSwitchElement.CheckedElement>
                    <Border Background="{DynamicResource SuccessBrush}" Margin="-1">
                        <TextBlock Text="启动" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ToggleButton>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Margin="5,5,5,0" HorizontalAlignment="Center" Text="系统时间" />
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding SystemTime}" d:Text="2024-04-02"/>
                    <TextBlock Margin="5,0" TextAlignment="Center" Text="运行时间" />
                    <TextBlock HorizontalAlignment="Center" Text="{Binding RuningTime}" d:Text="02:22:22"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Width="80">
                    <Button Width="50"
                            Height="50"
                            Margin="5"
                            BorderBrush="#FFC6C6C6">
                        <Button.Background>
                            <ImageBrush ImageSource="/Resources/图片/风险盾牌安全.png"/>
                        </Button.Background>
                       
                    </Button>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                        <TextBlock Text="99" />
                        <TextBlock Text="分钟" />
                        <TextBlock Text="59" />
                        <TextBlock Text="秒" />
                    </StackPanel>
                </StackPanel>
            </Grid>

        </DockPanel>
        <!--中间内容-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <UniformGrid Grid.Column="0" Rows="2">
                <hc:SimplePanel Background="#FF181A1C">
                    <wh:ImageView/>
                </hc:SimplePanel>
                <hc:SimplePanel Background="#FF10100F">
                    <wh:ImageView/>
                </hc:SimplePanel>
            </UniformGrid>
            <!--中间设置栏-->
            <hc:TabControl Grid.Column="1" SelectedIndex="0" IsAnimationEnabled="True" IsTabFillEnabled="True"  Style="{DynamicResource TabControlInLine}">
                <hc:TabItem Header="检测区">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="质量等级">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="检测设置">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="报警设置">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="打标设置">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="运动控制">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
                <hc:TabItem Header="回放">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                </hc:TabItem>
            </hc:TabControl>
            <!--右侧统计栏 消息栏 离线-->
            <hc:SimplePanel Grid.Column="2">
                <hc:TabControl Grid.Row="2"  SelectedIndex="0" IsAnimationEnabled="True" IsTabFillEnabled="True"  Style="{DynamicResource TabControlInLine}">
                    <hc:TabItem Header="缺陷统计列表">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}"/>
                    </hc:TabItem>
                    <hc:TabItem Header="系统消息">
                        <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                            <hc:TabControl Grid.Column="2"  SelectedIndex="0"  IsAnimationEnabled="True" IsTabFillEnabled="True"  Style="{DynamicResource TabControlInLine}">
                                <hc:TabItem Header="运行日志" Background="{DynamicResource RegionBrush}"/>
                                <hc:TabItem Header="报警日志" Background="{DynamicResource RegionBrush}"/>
                            </hc:TabControl>
                        </hc:SimplePanel>
                    </hc:TabItem>

                </hc:TabControl>

            </hc:SimplePanel>
           
        </Grid>
        <!--<hc:Drawer Dock="Right" ShowMode="Cover" IsOpen="{Binding ElementName=Btn_StartStop,Path=IsChecked}" ShowMask="False" MaskCanClose="False">
            <hc:SimplePanel  Width="300" Background="{DynamicResource RegionBrush}">
                <TextBlock Text="抽屉窗口"/>
                <Button Style="{DynamicResource ButtonIcon}" Command="hc:ControlCommands.Close" hc:IconElement.Geometry="{DynamicResource DeleteFillCircleGeometry}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </hc:SimplePanel>

        </hc:Drawer>-->
        <!-- 状态栏 -->
        <DockPanel Grid.Row="2" >
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="5,0">
                <TextBlock Text="算法:" />
                <TextBlock Margin="2,0" Text="50" />
                <TextBlock Text="ms" />
                <TextBlock Margin="10,0,0,0" Text="过滤:" />
                <TextBlock Margin="2,0" Text="50" />
                <TextBlock Text="ms" />

            </StackPanel>
            <Grid Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="5,0"
                           HorizontalAlignment="Right"
                           Text="项目路径:" />
                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Right"
                           Text="{Binding ProjPath}"
                            />
            </Grid>
        </DockPanel>
        <!--消息弹窗-->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Row="1" Grid.RowSpan="2" MaxHeight="500">
            <StackPanel hc:Growl.GrowlParent="True" VerticalAlignment="Bottom" Margin="0,10,0,20"/>
        </ScrollViewer>

    </Grid>
</hc:Window>
