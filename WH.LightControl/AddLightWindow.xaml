<hc:Window x:Class="WH.LightControl.AddLightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:WH.LightControl"
        mc:Ignorable="d"
           WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance local:AddLightVM}"
        Title="{Binding [添加光源], Source={x:Static local:CLang.LSWLightLang}}" Height="300" Width="500">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <ListBox
            x:Name="listBox"
            Grid.RowSpan="2"
            Margin="5"
            ItemsSource="{Binding BrandNames}" SelectedItem="{Binding SelectBrand, Mode=TwoWay}"/>
            
            <TextBox
            x:Name="textBox"
            Grid.Column="1"
            Margin="15"
            VerticalAlignment="Center"
            hc:TitleElement.Title=""
            hc:TitleElement.TitlePlacement="Left"
            hc:TitleElement.TitleWidth="80"
            Style="{StaticResource TextBoxExtend}"
                Text="{Binding LightName}"/>

            <Button
            Grid.Row="1"
            Grid.Column="1"
            Width="120"
            Command="{Binding AddCommand}"
            Content="添加"
            Style="{DynamicResource ButtonPrimary}">
                <!--<Button.CommandParameter>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <entity:CommMultiParamConverter />
                        </MultiBinding.Converter>
                        <Binding ElementName="listBox" Path="SelectedItem" />
                        <Binding ElementName="textBox" Path="Text" />
                    </MultiBinding>
                </Button.CommandParameter>-->
            </Button>
        </Grid>
    </Grid>
</hc:Window>
