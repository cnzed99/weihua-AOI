<hc:Window
    x:Class="WH.LightControl.LightSetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ValueConverters;assembly=ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WH.LightControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wh="http://whzn.com/rjkf/2024/xaml"
    Title="光源控制"
    Width="800"
    Height="550"
    d:DataContext="{d:DesignInstance local:CLightControlBase}"
    Icon="/WH.LightControl;component/Resources/光源.png"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:Window.Resources>
        <Style BasedOn="{StaticResource GroupBoxTab.Small}" TargetType="GroupBox" />
        <Style BasedOn="{StaticResource TextBoxExtend.Small}" TargetType="TextBox">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus.Small}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend.Small}" TargetType="wh:EnumComboBox">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource RadioButtonIcon.Small}" TargetType="RadioButton">
            <Setter Property="Margin" Value="5,0" />
        </Style>
        <Style BasedOn="{StaticResource TextBlockDefault}" TargetType="TextBlock">
            <Setter Property="Margin" Value="2" />
        </Style>
        <DataTemplate DataType="{x:Type local:CLight}">
            <DockPanel Margin="5">
                <TextBox
                    Width="50"
                    hc:TitleElement.Title="{Binding Channel, StringFormat={}{0}:}"
                    hc:TitleElement.TitlePlacement="Left"
                    Text="{Binding ElementName=slider, Path=Value}" />
                <Slider
                    Name="slider"
                    AutoToolTipPlacement="TopLeft"
                    Maximum="999"
                    SmallChange="1"
                    TickFrequency="50"
                    TickPlacement="BottomRight"
                    Value="{Binding Value}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="ValueChanged">
                            <hc:InvokeCommandAction Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SetChannelValueCommand}" CommandParameter="{Binding}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </Slider>
            </DockPanel>
        </DataTemplate>
        <entity:CheckConverter x:Key="CheckConverter" />
        <conv:BoolToBrushConverter
            x:Key="StatusBool2BrushConverter"
            FalseValue="{StaticResource BorderBrush}"
            TrueValue="LimeGreen" />
    </hc:Window.Resources>

    <DockPanel>
        <GroupBox Width="auto" Header="{Binding [基本参数], Source={x:Static local:CLang.LSWLightLang}}">
            <hc:ScrollViewer IsInertiaEnabled="True">
                <StackPanel>
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Width="100"
                                Margin="10,0"
                                wh:StatusDotElement.DotBrush="{Binding IsSerialPortOpen, Converter={StaticResource StatusBool2BrushConverter}}"
                                Command="{Binding OpenCommand}"
                                Content="{Binding [连接控制器], Source={x:Static local:CLang.LSWLightLang}}"
                                Style="{StaticResource StatusDotButtonPrimary.Small}" />
                        </StackPanel>


                        <Button
                            Width="100"
                            Margin="10,0"
                            Command="{Binding SaveCommand}"
                            Content="{Binding [保存配置], Source={x:Static local:CLang.LSWLightLang}}"
                            Style="{StaticResource ButtonPrimary.Small}" />
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding [光源品牌], Source={x:Static local:CLang.LSWLightLang}}" Margin="5"/>
                        <TextBlock Grid.Column="1" Text="{Binding BaseConfig.LightBrandName}" Margin="5"/>
                        <TextBlock Grid.Column="2" Text="{Binding [工位名称], Source={x:Static local:CLang.LSWLightLang}}" Margin="5"/>
                        <TextBlock Grid.Column="3" Text="{Binding BaseConfig.LightStationName}" Margin="5"/>
                    </Grid>

                    <wh:CPropertyGridLang
                        Background="{x:Null}"
                        SelectedObject="{Binding BaseConfig}" />
          
                    

                        <Button Grid.Column="0"                    
                          Margin="10"
                          Command="{Binding ReSetCommand}"
                          Content="{Binding [恢复出厂], Source={x:Static local:CLang.LSWLightLang}}"
                          Style="{StaticResource ButtonDanger.Small}" />

                        <!--<Button Grid.Column="1"                        
                           Margin="10"
                           Command="{Binding AddCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                           Content="{Binding [新增], Source={x:Static local:CLang.LSWLightLang}}"
                           Style="{StaticResource StatusDotButtonInfo.Small}" />-->
                                          

                           <!--<Button Grid.Column="2"                    
                           Margin="10"
                           Command="{Binding DeleteCommand}" CommandParameter="{Binding BaseConfig}"
                           Content="{Binding [删除], Source={x:Static local:CLang.LSWLightLang}}"
                           Style="{StaticResource ButtonDanger.Small}" />-->

                </StackPanel>
            </hc:ScrollViewer>


        </GroupBox>
        <StackPanel>
            <hc:ElementGroup Margin="5">
                <TextBlock HorizontalAlignment="Right" Text="{Binding [高低电平], Source={x:Static local:CLang.LSWLightLang}}" />
                <RadioButton Content="{Binding [高电平], Source={x:Static local:CLang.LSWLightLang}}" IsChecked="{Binding Config.TriggerMode}" />
                <RadioButton Content="{Binding [低电平], Source={x:Static local:CLang.LSWLightLang}}" IsChecked="{Binding Config.TriggerMode, Converter={StaticResource Boolean2BooleanReConverter}}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="Checked">
                            <hc:InvokeCommandAction Command="{Binding TriggerModeChangedCommand}" />
                        </hc:EventTrigger>
                        <hc:EventTrigger EventName="Unchecked">
                            <hc:InvokeCommandAction Command="{Binding TriggerModeChangedCommand}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </RadioButton>
            </hc:ElementGroup>
            <hc:ElementGroup Margin="5">
                <TextBlock HorizontalAlignment="Right" Text="{Binding [边沿触发], Source={x:Static local:CLang.LSWLightLang}}" />
                <RadioButton Content="{Binding [上升沿], Source={x:Static local:CLang.LSWLightLang}}" IsChecked="{Binding Config.TriggerEdge}" />
                <RadioButton Content="{Binding [下降沿], Source={x:Static local:CLang.LSWLightLang}}" IsChecked="{Binding Config.TriggerEdge, Converter={StaticResource Boolean2BooleanReConverter}}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="Checked">
                            <hc:InvokeCommandAction Command="{Binding TriggerEdgeChangedCommand}" />
                        </hc:EventTrigger>
                        <hc:EventTrigger EventName="Unchecked">
                            <hc:InvokeCommandAction Command="{Binding TriggerEdgeChangedCommand}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </RadioButton>
            </hc:ElementGroup>
            <hc:ElementGroup Margin="5">
                <TextBlock HorizontalAlignment="Right" Text="{Binding [工作模式], Source={x:Static local:CLang.LSWLightLang}}" />
                <RadioButton Content="{Binding [增亮], Source={x:Static local:CLang.LSWLightLang}}" IsChecked="{Binding Config.WorkMode}" />
                <RadioButton Content="{Binding [调试], Source={x:Static local:CLang.LSWLightLang}}" IsChecked="{Binding Config.WorkMode, Converter={StaticResource Boolean2BooleanReConverter}}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="Checked">
                            <hc:InvokeCommandAction Command="{Binding WorkModeChangedCommand}" />
                        </hc:EventTrigger>
                        <hc:EventTrigger EventName="Unchecked">
                            <hc:InvokeCommandAction Command="{Binding WorkModeChangedCommand}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </RadioButton>
            </hc:ElementGroup>
            <GroupBox Header="{Binding [通道亮度], Source={x:Static local:CLang.LSWLightLang}}">
                <ItemsControl ItemsSource="{Binding Config.LightChannelList}" />
            </GroupBox>
            <hc:RunningBlock
                BorderThickness="0"
                IsRunning="{Binding IsMouseOver, RelativeSource={RelativeSource Self}, Converter={StaticResource Boolean2BooleanReConverter}}"
                Duration="0:0:10">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextBlockDefaultDanger}"/>
            </hc:RunningBlock>
        </StackPanel>

    </DockPanel>
</hc:Window>
