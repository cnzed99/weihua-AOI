<UserControl
    x:Class="PlcControl.HomePageShowCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cov="clr-namespace:ValueConverters;assembly=ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:PlcControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wh="http://whzn.com/rjkf/2024/xaml"
    d:DesignHeight="80"
    d:DesignWidth="600"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <cov:BoolToBrushConverter
                x:Key="PLCStatusConverter"
                FalseValue="Gray"
                TrueValue="Lime" />
            <cov:BoolToBrushConverter
                x:Key="StatusReConverter"
                FalseValue="Gray"
                TrueValue="Red" />
            <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
                <Setter Property="hc:TitleElement.VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <d:UserControl.DataContext>
        <local:CMotionCtrlVM />
    </d:UserControl.DataContext>
    <UniformGrid Rows="2">
        <Label
            Width="100"
            Height="30"
            HorizontalContentAlignment="Right"
            
            wh:StatusDotElement.DotBrush="{Binding PlcIsRun, Converter={StaticResource PLCStatusConverter}}"
            wh:StatusDotElement.Radius="20"
            Content="下位机状态"
            Style="{DynamicResource StatusDotLabel}" />

        <Button
            Width="100"
            Height="30"
            Margin="2"
            wh:StatusDotElement.DotBrush="{Binding IsBinFull, Converter={StaticResource StatusReConverter}}"
            wh:StatusDotElement.Radius="20"
            Command="{Binding ClearInBinCommand}"
            Content="满料清料"
            HorizontalContentAlignment="Right"
            IsEnabled="{Binding ClearInBinCommand.IsRunning, Converter={StaticResource Boolean2BooleanReConverter}}"
            Style="{DynamicResource StatusDotButtonPrimary}" />

        <Label
            Width="100"
            Height="30"
            Margin="2"
            HorizontalContentAlignment="Right"
            wh:StatusDotElement.DotBrush="{Binding IsError, Converter={StaticResource StatusReConverter}}"
            wh:StatusDotElement.Radius="20"
            Content="卡料"
            Style="{DynamicResource StatusDotLabel}" />
        <TextBox
            Height="30"
            hc:TitleElement.Title="入口料仓:"
            IsReadOnly="True"
            Text="{Binding InBinNumber}" />

        <TextBox
            Height="30"
            hc:TitleElement.Title="出口料仓:"
            IsReadOnly="True"
            Text="{Binding OutBinNumber}" />
        <hc:ElementGroup>
            <hc:ElementGroup.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </hc:ElementGroup.ItemsPanel>
            <TextBox
                Height="30"
                hc:TitleElement.Title="料仓容量:"
                DockPanel.Dock="Left"
                Text="{Binding MotionConfig.BinCapcity, Mode=OneWay}" />
            <Button
                Name="CapcityBtn"
                Grid.Column="1"
                Width="50"
                HorizontalAlignment="Right"
                Command="{Binding WriteBinCapcityCommand}"
                Content="确认"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonPrimary}" />
        </hc:ElementGroup>
    </UniformGrid>
</UserControl>