<UserControl
    x:Class="HistoryPlayback.HistoryCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:HistoryPlayback"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
    d:DataContext="{d:DesignInstance Type=local:CHistoryVM}"
    d:DesignHeight="800"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>

            <Style BasedOn="{StaticResource GroupBoxTab}" TargetType="GroupBox" />
            <local:FileNameConverter x:Key="FileNameConverter" />
            <entity:CheckConverter x:Key="CheckConverter" />
            <Style BasedOn="{StaticResource TextBoxExtend.Small}" TargetType="TextBox">
                <Setter Property="hc:TitleElement.TitlePlacement" Value="Top" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="2,0" />
            </Style>
            <Style x:Key="ab" TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{StaticResource RegionBrush}" />
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource SecondaryRegionBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource DarkPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition />
            <RowDefinition Height="9*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ListBox
                AlternationCount="2"
                Foreground="White"
                ItemsSource="{Binding FileNames, Mode=OneWay}"
                SelectedIndex="{Binding FileIndex}"
                SelectedItem="{Binding SelectedItem}"
                ItemContainerStyle="{StaticResource ab}"
                SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="5" Text="{Binding Converter={StaticResource FileNameConverter}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding ItemSelectedCommand}" CommandParameter="{Binding SelectedItem}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>

            </ListBox>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />

                </Grid.RowDefinitions>
                <DockPanel>
                    <RadioButton
                        Grid.Column="0"
                        d:IsChecked="True"
                        Content="{Binding [byTime], Source={x:Static local:CLang.instance}}"
                        GroupName="Options"
                        IsChecked="{Binding SelectClassify, Converter={StaticResource CheckConverter}, ConverterParameter=0}" />
                    <RadioButton
                        Margin="2"
                        Content="{Binding [byDefect], Source={x:Static local:CLang.instance}}"
                        GroupName="Options"
                        IsChecked="{Binding SelectClassify, Converter={StaticResource CheckConverter}, ConverterParameter=1}" />
                    <ComboBox
                        Height="20"
                        Margin="2"
                        ItemsSource="{Binding HistoryModel.DefectList}"
                        SelectedItem="{Binding SelectedDefect}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <!--  上一张 下一张  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="100"
                        Height="40"
                        Command="{Binding FrontImageCommand}">
                        <Button.Content>
                            <Image Source="/HistoryPlayback;component/Resources/上一张.png" />
                        </Button.Content>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Width="100"
                        Height="40"
                        Command="{Binding NextImageCommand}">
                        <Button.Content>
                            <Image Source="/HistoryPlayback;component/Resources/下一张.png" />
                        </Button.Content>
                    </Button>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal" />
            </Grid>
        </Grid>
        <!--  产品检测信息  -->
        <Grid Grid.Row="1" DataContext="{Binding SelectedCellInfo}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                hc:InfoElement.Title="{Binding [ID], Source={x:Static local:CLang.instance}}"
                Text="{Binding ID, Mode=OneWay}" />
            <TextBox
                Grid.Column="1"
                hc:InfoElement.Title="{Binding [Time], Source={x:Static local:CLang.instance}}"
                Text="{Binding CreateTime, Mode=OneWay}" />
            <TextBox
                Grid.Column="2"
                hc:InfoElement.Title="{Binding [TakeTime], Source={x:Static local:CLang.instance}}"
                Text="{Binding TakeTime, Mode=OneWay}" />
            <TextBox
                Grid.Column="3"
                hc:InfoElement.Title="{Binding [QualityLev], Source={x:Static local:CLang.instance}}"
                Text="{Binding Level, Mode=OneWay}" />
            <TextBox
                Grid.Column="4"
                hc:InfoElement.Title="{Binding [DefectName], Source={x:Static local:CLang.instance}}"
                Text="{Binding DefectName, Mode=OneWay}" />

        </Grid>
        <!--  产品图像  -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <!--<RowDefinition/>-->
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"  Margin="10,5" 
             Foreground="AliceBlue"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"/>

            <Border   BorderBrush="DarkGray" Margin="1"
             Grid.Row="0"
             BorderThickness="1">
                <wh:ImageView Source="{Binding ReadImage}" />
            </Border>
            <!--<TextBlock Grid.Row="1"  Margin="10,10" 
             Foreground="AliceBlue"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"/>-->
            <!--<Border 
            Grid.Row="1" Margin="1"
            BorderBrush="DarkGray"
            BorderThickness="1">
                <wh:ImageView Source="{Binding ReadImage}" />
            </Border>-->
        </Grid>
    </Grid>
</UserControl>
