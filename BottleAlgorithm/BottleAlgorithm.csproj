    <Exec Command="xcopy $(OutDir)GeneralMLOBBAlgorithm.dll $(SolutionDir)断面毛刺检测软件\bin\Debug\$(TargetFramework)\AlgorithmPlug\$(TargetName)\ /d /y" />
    <Exec Command="xcopy $(OutDir)halcondotnetxl.dll $(SolutionDir)断面毛刺检测软件\bin\Debug\$(TargetFramework)\AlgorithmPlug\$(TargetName)\ /d /y" />
