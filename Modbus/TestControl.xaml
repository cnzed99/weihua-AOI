<UserControl
    x:Class="Modbus.TestControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Modbus"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <d:UserControl.DataContext>
        <local:TestControlVM />
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <GroupBox Style="{StaticResource GroupBoxTab}">
            <GroupBox.Header>
                <DockPanel Width="{Binding RelativeSource={RelativeSource AncestorType=GroupBox}, Path=ActualWidth}" LastChildFill="False">
                    <TextBlock Text="{Binding [RegisterInfo], Source={x:Static local:CLang.s_Instance}}" />
                    <Button
                        Width="80"
                        Margin="10,2"
                        Command="{Binding WriteCommand}"
                        Content="{Binding [Write], Source={x:Static local:CLang.s_Instance}}"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource ButtonPrimary}" />
                    <Button
                        Width="80"
                        Margin="10,2"
                        Command="{Binding AddCommand}"
                        Content="{Binding [Add], Source={x:Static local:CLang.s_Instance}}"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource ButtonPrimary}" />

                </DockPanel>
            </GroupBox.Header>
            <DataGrid
                Name="dataGrid"
                hc:DataGridAttach.ShowRowNumber="True"
                AutoGenerateColumns="False"
                HeadersVisibility="All"
                ItemsSource="{Binding Config.TestElems}"
                RowHeaderWidth="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Header="{Binding [Name], Source={x:Static local:CLang.s_Instance}}" />
                    <DataGridTextColumn Binding="{Binding Addr, UpdateSourceTrigger=PropertyChanged}" Header="{Binding [Addr], Source={x:Static local:CLang.s_Instance}}" />
                    <DataGridTemplateColumn Header="{Binding [Type], Source={x:Static local:CLang.s_Instance}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <wh:EnumComboBox SelectEnumValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Binding="{Binding ReadValue}"
                        Header="{Binding [ReadVal], Source={x:Static local:CLang.s_Instance}}"
                        IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding WriteValue, UpdateSourceTrigger=LostFocus}" Header="{Binding [WriteVal], Source={x:Static local:CLang.s_Instance}}" />
                    <DataGridTemplateColumn MinWidth="70" Header="{Binding [Write], Source={x:Static local:CLang.s_Instance}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding ElementName=dataGrid, Path=DataContext.WriteSingleCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding [Write], Source={x:Static local:CLang.s_Instance}}"
                                    Style="{DynamicResource ButtonSuccess}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn MinWidth="70" Header="{Binding [Del], Source={x:Static local:CLang.s_Instance}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding ElementName=dataGrid, Path=DataContext.DelCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding [Del], Source={x:Static local:CLang.s_Instance}}"
                                    Style="{DynamicResource ButtonDanger}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        Header="{Binding [Description], Source={x:Static local:CLang.s_Instance}}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
