<hc:Window
    x:Class="DataQuery.DataQueryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:DataQuery"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prop="clr-namespace:DataQuery.Properties"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="{Binding [DataQuery], Source={x:Static local:CLang.instance}}"
    Width="700"
    Height="700"
    d:DataContext="{d:DesignInstance Type=local:CDataQueryVM}"
    Icon="/DataQuery;component/Resources/数据查询.png"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <Style BasedOn="{StaticResource TimePickerExtend}" TargetType="hc:TimePicker">
                <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
            </Style>
            <entity:CheckConverter x:Key="CheckConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <RadioButton
                    Margin="5"
                    d:IsChecked="True"
                    Content="{Binding [QueryToday], Source={x:Static local:CLang.instance}}"
                    IsChecked="{Binding SelectQueryMode, Converter={StaticResource CheckConverter}, ConverterParameter=0}" />
                <RadioButton
                    Grid.Column="1"
                    Margin="5"
                    Content="{Binding [QueryHistory], Source={x:Static local:CLang.instance}}"
                    IsChecked="{Binding SelectQueryMode, Converter={StaticResource CheckConverter}, ConverterParameter=1}" />
                <ComboBox
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    hc:TitleElement.Title="{Binding [制程组], Source={x:Static local:CLang.instance}}"
                    hc:TitleElement.TitlePlacement="Left"
                    hc:TitleElement.TitleWidth="70"
                    ItemsSource="{Binding DictSqls.Keys}"
                    SelectedItem="{Binding SelectGroup}"
                    Style="{StaticResource ComboBoxExtend}" />
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <hc:ElementGroup Grid.Row="0" VerticalAlignment="Center">
                    <hc:DatePicker
                        Margin="5"
                        hc:InfoElement.ShowClearButton="False"
                        hc:InfoElement.Title="{Binding [StartDate], Source={x:Static local:CLang.instance}}"
                        hc:InfoElement.TitlePlacement="Left"
                        SelectedDate="{Binding StartDate}" />
                    <hc:DatePicker
                        Margin="5"
                        hc:InfoElement.ShowClearButton="False"
                        hc:InfoElement.Title="{Binding [EndDate], Source={x:Static local:CLang.instance}}"
                        hc:InfoElement.TitlePlacement="Left"
                        SelectedDate="{Binding EndDate}" />
                </hc:ElementGroup>
                <hc:ElementGroup Grid.Row="1" VerticalAlignment="Center">
                    <hc:TimePicker
                        Margin="5"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:TitleElement.Title="{Binding [StartTime], Source={x:Static local:CLang.instance}}"
                        SelectedTime="{Binding StartTime}"
                        Style="{StaticResource TimePickerPlus}"
                        TimeFormat="HH:mm">
                        <hc:TimePicker.Clock>
                            <hc:ListClock />
                        </hc:TimePicker.Clock>
                    </hc:TimePicker>
                    <hc:TimePicker
                        Margin="5"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:TitleElement.Title="{Binding [EndTime], Source={x:Static local:CLang.instance}}"
                        SelectedTime="{Binding EndTime}"
                        Style="{StaticResource TimePickerPlus}"
                        TimeFormat="HH:mm">
                        <hc:TimePicker.Clock>
                            <hc:ListClock />
                        </hc:TimePicker.Clock>
                    </hc:TimePicker>
                </hc:ElementGroup>
            </Grid>

            <ToggleButton
                Grid.Column="2"
                Width="100"
                Height="40"
                Command="{Binding SearchCommand}"
                Content="{Binding [Query], Source={x:Static local:CLang.instance}}"
                IsChecked="{Binding SearchCommand.IsRunning, Mode=OneWay}"
                Style="{StaticResource ToggleButtonLoadingPrimary}" />

        </Grid>

        <TextBlock
            Grid.Row="1"
            Text="{Binding MessageText}"
            TextWrapping="Wrap" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding DataViews}">
            <!--<ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="150"
                        DisplayMemberBinding="{Binding Path=时段}"
                        Header="{x:Static prop:Resources.Hours}" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding Path=生产数}"
                        Header="{x:Static prop:Resources.Total}" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding Path=OK数量}"
                        Header="{x:Static prop:Resources.OKCount}" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding Path=NG数量}"
                        Header="{x:Static prop:Resources.NGCount}" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding Path=总缺陷占比}"
                        Header="{x:Static prop:Resources.Percent}" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding Path=划伤数量}"
                        Header="划伤数量" />
                </GridView>
            </ListView.View>-->
        </DataGrid>


    </Grid>
</hc:Window>
