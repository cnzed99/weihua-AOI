<hc:Window x:Class="DataQuery.DataQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataQuery"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:sys="clr-namespace:System;assembly=mscorlib" 
        mc:Ignorable="d"
            xmlns:prop="clr-namespace:DataQuery.Properties"
        xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
        Title="数据查询" Height="900" Width="700"
           WindowStartupLocation="CenterScreen"
             d:DataContext="{d:DesignInstance Type=local:CDataQueryVM}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource TimePickerExtend}" TargetType="hc:TimePicker">
                <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
            </Style>
            <entity:CheckConverter x:Key="CheckConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DockPanel HorizontalAlignment="Left" >
                <RadioButton Grid.Column="0" d:IsChecked="True"  Content="{x:Static prop:Resources.QueryToday}"
                             IsChecked="{Binding SelectQueryMode , Converter={StaticResource CheckConverter}, ConverterParameter=0}" Margin="5">
                    <!--<i:Interaction.Triggers >
                        <i:EventTrigger  EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding RbCheckCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>-->
                </RadioButton>
                <RadioButton Grid.Column="0" Content="{x:Static prop:Resources.QueryHistory}"
                             IsChecked="{Binding SelectQueryMode , Converter={StaticResource CheckConverter}, ConverterParameter=1}" Margin="5">
                    <!--<i:Interaction.Triggers >
                        <i:EventTrigger  EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding RbCheckCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>-->

                </RadioButton>
            </DockPanel>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <hc:ElementGroup Grid.Row="0" VerticalAlignment="Center">

                    <hc:DatePicker  hc:InfoElement.Title="{x:Static prop:Resources.StartDate}" hc:InfoElement.ShowClearButton="True" SelectedDate="{Binding StartDate}" Margin="5" hc:InfoElement.TitlePlacement="Left"  />
                    <hc:DatePicker  hc:InfoElement.Title="{x:Static prop:Resources.EndDate}" hc:InfoElement.ShowClearButton="True" SelectedDate="{Binding EndDate}" Margin="5" hc:InfoElement.TitlePlacement="Left"  />
                </hc:ElementGroup>
                <hc:ElementGroup Grid.Row="1" VerticalAlignment="Center">
                    <hc:TimePicker  hc:TitleElement.Title="{x:Static prop:Resources.StartTime}" Style="{StaticResource TimePickerPlus}"  SelectedTime="{Binding StartTime}" TimeFormat="HH:mm" Margin="5" hc:InfoElement.TitlePlacement="Left">
                        <hc:TimePicker.Clock>
                            <hc:ListClock/>
                        </hc:TimePicker.Clock>
                    </hc:TimePicker>
                    <hc:TimePicker  hc:TitleElement.Title="{x:Static prop:Resources.EndTime}"  Style="{StaticResource TimePickerPlus}" SelectedTime="{Binding EndTime}" TimeFormat="HH:mm" Margin="5" hc:InfoElement.TitlePlacement="Left">
                        <hc:TimePicker.Clock>
                            <hc:ListClock/>
                        </hc:TimePicker.Clock>
                    </hc:TimePicker>
                </hc:ElementGroup>
            </Grid>

            <Button Grid.Column="2" Content="{x:Static prop:Resources.Query}" Style="{StaticResource ButtonPrimary}" Width="70" Height="40"  Command="{Binding SearchCommand}"/>
           
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding MessageText}" />

        <ListView Grid.Row="2" ItemsSource="{Binding DataViews}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="150" Header="{x:Static prop:Resources.Hours}" DisplayMemberBinding="{Binding Path=时段}"/>
                    <GridViewColumn Width="100" Header="{x:Static prop:Resources.Total}"  DisplayMemberBinding="{Binding Path=生产数}" />
                    <GridViewColumn Width="100" Header="{x:Static prop:Resources.OKCount}"  DisplayMemberBinding="{Binding Path=OK数量}" />
                    <GridViewColumn Width="100" Header="{x:Static prop:Resources.NGCount}"  DisplayMemberBinding="{Binding Path=NG数量}" />
                    <GridViewColumn Width="100" Header="{x:Static prop:Resources.Percent}"  DisplayMemberBinding="{Binding Path=总缺陷占比}" />
                    <GridViewColumn Width="100" Header="划伤数量" DisplayMemberBinding="{Binding Path=划伤数量}" />
                </GridView>
            </ListView.View>
        </ListView>


    </Grid>
</hc:Window>
