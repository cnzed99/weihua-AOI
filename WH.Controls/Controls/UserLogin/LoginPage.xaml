<Window
    x:Class="WH.Controls.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WH.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prop="clr-namespace:WH.Controls.Properties"
    x:Name="window"
    Title="{Binding [LoginTitle], Source={x:Static prop:LangManager.instance}}"
    Width="400"
    Height="300"
    d:DataContext="{d:DesignInstance Type=local:CLoginViewModel}"
    AllowsTransparency="True"
    Background="{x:Null}"
    MouseLeftButtonDown="WinMove_LeftButtonDown"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WH.Controls;component/ControlDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource lbText}" TargetType="TextBlock" />
            <Style BasedOn="{StaticResource PageButton}" TargetType="Button" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard x:Name="OnLoaded1_BeginStoryboard" Storyboard="{StaticResource OnLoaded1}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="UIElement.MouseEnter" SourceName="btn_Close">
            <BeginStoryboard x:Name="OnMouseEnter1_BeginStoryboard" Storyboard="{StaticResource OnMouseEnter1}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="UIElement.MouseLeave" SourceName="btn_Close">
            <BeginStoryboard x:Name="OnMouseLeave1_BeginStoryboard" Storyboard="{StaticResource OnMouseLeave1}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="grid">
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/WH.Controls;component/Controls/UserLogin/Imgs/欢迎页.png" />
        </Grid.Background>
        <TextBlock
            Margin="30"
            VerticalAlignment="Top"
            FontFamily="Yu Gothic UI Semibold"
            FontSize="20"
            Foreground="White"
            Text="{Binding [LoginTitle], Source={x:Static prop:LangManager.instance}}" />
        <Button
            x:Name="btn_Close"
            Margin="0,10,15,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{x:Null}"
            BorderThickness="0"
            Click="btn_Close_Click"
            Content="✖"
            FontSize="12.5"
            Foreground="Cyan"
            RenderTransformOrigin="0.5,0.5"
            Style="{StaticResource CloseButton}">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Button.RenderTransform>
        </Button>

        <hc:UniformSpacingPanel
            Width="250"
            Margin="0,80,0,0"
            Orientation="Vertical"
            VerticalSpacing="10">
            <DockPanel>
                <TextBlock
                    FontStretch="Expanded"
                    Foreground="White"
                    Style="{StaticResource TextBlockDefault}"
                    Text="{Binding [UserName], Source={x:Static prop:LangManager.instance}}" />
                <ComboBox
                    Margin="5,0"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    Background="#CC135D7F"
                    BorderBrush="Cyan"
                    ItemsSource="{Binding ItemList}"
                    SelectedItem="{Binding LoginPerson.UserName}"
                    Style="{StaticResource ComboBoxExtend}" />
            </DockPanel>
            <DockPanel>
                <TextBlock
                    Foreground="White"
                    Style="{StaticResource TextBlockDefault}"
                    Text="{Binding [PassWord], Source={x:Static prop:LangManager.instance}}" />
                <hc:PasswordBox
                    Margin="5,0"
                    HorizontalContentAlignment="Center"
                    Background="#CC135D7F"
                    BorderBrush="Cyan"
                    Foreground="White"
                    IsSafeEnabled="false"
                    ShowEyeButton="True"
                    UnsafePassword="{Binding LoginPerson.PassWord}">
                    <hc:PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoginButtonCommand}" />
                    </hc:PasswordBox.InputBindings>
                </hc:PasswordBox>
            </DockPanel>
            <DockPanel>
                <TextBlock
                    Foreground="White"
                    Style="{StaticResource TextBlockDefault}"
                    Text="{Binding [LoginPeriod], Source={x:Static prop:LangManager.instance}}" />
                <hc:TextBox
                    Margin="5,0"
                    HorizontalContentAlignment="Center"
                    hc:InfoElement.ShowClearButton="True"
                    Background="#CC135D7F"
                    BorderBrush="Cyan"
                    Foreground="White"
                    Style="{DynamicResource TextBoxPlusBaseStyle}"
                    Text="{Binding LoginLeftTimeMinute, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoginButtonCommand}" />
                    </TextBox.InputBindings>
                </hc:TextBox>
            </DockPanel>
            <UniformGrid Columns="2">
                <Button
                    Name="btn_LoginButton"
                    Width="120"
                    Background="#CC135D7F"
                    BorderBrush="Cyan"
                    Command="{Binding LoginButtonCommand}"
                    Content="{Binding [Login], Source={x:Static prop:LangManager.instance}}" />
                <Button
                    Name="btn_Exit"
                    Width="120"
                    Background="#CC135D7F"
                    BorderBrush="Cyan"
                    Command="{Binding LogoutButtonCommand}"
                    Content="{Binding [Logout], Source={x:Static prop:LangManager.instance}}" />
            </UniformGrid>
        </hc:UniformSpacingPanel>

        <Image
            Height="42"
            Margin="20,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Source="/WH.Controls;component/Controls/UserLogin/Imgs/汇通.png" />

        <TextBlock
            Width="200"
            Margin="0,0,40,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Foreground="Cyan"
            LineHeight="22"
            Text="{Binding ErrorMsg}"
            TextAlignment="Right"
            TextWrapping="Wrap" />
    </Grid>
</Window>