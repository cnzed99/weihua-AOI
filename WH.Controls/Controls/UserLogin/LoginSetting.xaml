<Window
    x:Class="WH.Controls.LoginSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entity="clr-namespace:WH.Entity.Converter;assembly=WH.Entity"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WH.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prop="clr-namespace:WH.Controls.Properties"
    xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2"
    Name="window"
    Title="{Binding [UserManagement], Source={x:Static prop:LangManager.instance}}"
    Width="320"
    Height="425"
    d:DataContext="{d:DesignInstance Type=local:SettingViewModel}"
    AllowsTransparency="True"
    Background="{x:Null}"
    MouseLeftButtonDown="WinMove_LeftButtonDown"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WH.Controls;component/ControlDictionary.xaml" />

            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource lbText}" TargetType="TextBlock" />
            <Style BasedOn="{StaticResource PageButton}" TargetType="Button" />
            <entity:Enums2StringsConverter x:Key="Enums2StringsConverter" />
            <entity:StringAttrEnumConverter x:Key="StringAttrEnumConverter" />
            <entity:EnumProviderConverter x:Key="EnumProviderConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard x:Name="OnLoaded1_BeginStoryboard" Storyboard="{StaticResource OnLoaded1}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="UIElement.MouseEnter" SourceName="btn_Close">
            <BeginStoryboard x:Name="OnMouseEnter1_BeginStoryboard" Storyboard="{StaticResource OnMouseEnter1}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="UIElement.MouseLeave" SourceName="btn_Close">
            <BeginStoryboard x:Name="OnMouseLeave1_BeginStoryboard" Storyboard="{StaticResource OnMouseLeave1}" />
        </EventTrigger>
    </Window.Triggers>



    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="/WH.Controls;component/Controls/UserLogin/Imgs/欢迎页.png" />
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5.5*" />

        </Grid.ColumnDefinitions>
        <Border
            Margin="10,30,8,0"
            VerticalAlignment="Center"
            BorderBrush="DarkCyan"
            BorderThickness="0,0,0,1" />
        <TextBlock
            Width="200"
            Height="15"
            Margin="20,210,0,0"
            VerticalAlignment="Top"
            Foreground="DarkGray"
            Text="{Binding ErrorMsg}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="18"
                Foreground="LightGray"
                Text="{Binding [UserManagement], Source={x:Static prop:LangManager.instance}}" />

            <Button
                x:Name="btn_Close"
                Grid.Row="0"
                Margin="0,6,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                Click="btn_Close_Click"
                Content="✖"
                Foreground="#33FFFFFF"
                RenderTransformOrigin="0.5,0.5"
                Style="{StaticResource CloseButton}">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <ComboBox
                Grid.Row="0"
                Width="180"
                Height="25"
                Margin="85,40,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                FontSize="14"
                ItemsSource="{Binding ItemList}"
                SelectedItem="{Binding SelectItem}"
                Style="{StaticResource comboxStyle}" />
            <hc:PasswordBox
                Grid.Row="0"
                Width="180"
                Height="25"
                Margin="85,80,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                BorderBrush="DarkCyan"
                FontSize="14"
                IsSafeEnabled="False"
                ShowEyeButton="True"
                UnsafePassword="{Binding LoginPerson.PassWord}" />

            <ComboBox
                Grid.Row="0"
                Width="180"
                Height="25"
                Margin="85,120,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                FontSize="14"
                ItemsSource="{Binding LoginPerson.PrivileageLevel, Converter={StaticResource EnumProviderConverter}}"
                SelectedItem="{Binding LoginPerson.PrivileageLevel, Converter={StaticResource StringAttrEnumConverter}}"
                Style="{StaticResource comboxStyle}" />
            <Button
                Name="btn_ChangeButton"
                Grid.Row="0"
                Width="75"
                Height="30"
                Margin="60,170,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding ChangeButtonCommand}"
                Content="{Binding [Adjust], Source={x:Static prop:LangManager.instance}}" />
            <Button
                Name="btn_DeleteButton"
                Grid.Row="0"
                Width="75"
                Height="30"
                Margin="200,170,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding DeleteButtonCommand}"
                Content="{Binding [Delete], Source={x:Static prop:LangManager.instance}}" />
            <TextBlock
                Grid.Row="0"
                Width="64"
                Height="17"
                Margin="16,45,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="{Binding [UserName], Source={x:Static prop:LangManager.instance}}" />
            <TextBlock
                Grid.Row="0"
                Width="64"
                Height="17"
                Margin="16,87,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="{Binding [PassWord], Source={x:Static prop:LangManager.instance}}" />
            <TextBlock
                Grid.Row="0"
                Width="64"
                Height="18"
                Margin="16,126,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#43FFFFFF"
                Text="{Binding [Permission], Source={x:Static prop:LangManager.instance}}" />

            <TextBox
                Grid.Row="1"
                Width="180"
                Height="25"
                Margin="85,35,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderBrush="DarkCyan"
                FontSize="14"
                Foreground="#FFFFFFFF"
                Text="{Binding AddUserName}" />
            <TextBox
                Grid.Row="1"
                Width="180"
                Height="25"
                Margin="85,75,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderBrush="DarkCyan"
                FontSize="14"
                Foreground="#FFFFFFFF"
                Text="{Binding AddPassword}" />
            <ComboBox
                Grid.Row="1"
                Width="180"
                Height="25"
                Margin="85,115,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                FontSize="14"
                ItemsSource="{Binding PrivileageList, Converter={StaticResource Enums2StringsConverter}}"
                SelectedItem="{Binding AddPrivlege, Converter={StaticResource StringAttrEnumConverter}}"
                Style="{StaticResource comboxStyle}" />
            <TextBlock
                Grid.Row="1"
                Width="64"
                Height="18"
                Margin="16,40,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#43FFFFFF"
                Text="{Binding [UserName], Source={x:Static prop:LangManager.instance}}" />
            <TextBlock
                Grid.Row="1"
                Width="64"
                Height="14"
                Margin="16,84,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#43FFFFFF"
                Text="{Binding [PassWord], Source={x:Static prop:LangManager.instance}}" />
            <TextBlock
                Grid.Row="1"
                Width="64"
                Height="14"
                Margin="16,122,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="#43FFFFFF"
                Text="{Binding [Permission], Source={x:Static prop:LangManager.instance}}" />
            <Button
                Name="btn_register"
                Grid.Row="1"
                Width="150"
                Height="30"
                Margin="20,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Command="{Binding AddButtonCommand}"
                Content="{Binding [Register], Source={x:Static prop:LangManager.instance}}" />
        </Grid>

    </Grid>



</Window>
