<hc:Window
    x:Class="WH.Controls.CollectionEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WH.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prop="clr-namespace:WH.Controls.Properties"
    Title="{Binding [CollectionEditor], Source={x:Static prop:LangManager.instance}}"
    Width="600"
    Height="350"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <UniformGrid Columns="2">
            <Button
                Width="80"
                Click="BtnAdd_Click"
                Content="{Binding [Add], Source={x:Static prop:LangManager.instance}}"
                Style="{DynamicResource ButtonPrimary}" />
            <Button
                Width="80"
                Click="BtnDelete_Click"
                Content="{Binding [Remove], Source={x:Static prop:LangManager.instance}}"
                Style="{DynamicResource ButtonDanger}" />
        </UniformGrid>
        <TextBlock
            Grid.Column="1"
            Style="{StaticResource TextBlockDefault}"
            Text="{Binding ElementName=listBox, Path=SelectedItem.Name}" />
        <ListBox
            x:Name="listBox"
            Grid.Row="1"
            SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <local:CPropertyGridLang
            Grid.Row="1"
            Grid.Column="1"
            SelectedObject="{Binding ElementName=listBox, Path=SelectedItem}"
            lang="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:CollectionEditor}}, Path=Lang}" />
    </Grid>
</hc:Window>
