<hc:Window
    x:Class="CommunicationModule.OpenCommunication"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:CommunicationModule"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
    Title="{Binding [CommSet], Source={x:Static local:CLang.s_Instance}}"
    Width="1000"
    Height="650"
    Icon="/CommunicationModule;component/Resources/外接通讯数据.png"
    mc:Ignorable="d"
    ResizeMode="NoResize"
WindowStartupLocation="CenterScreen"
    Background="{DynamicResource SecondaryRegionBrush}">
    <hc:Window.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </hc:Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.7*"/>
        </Grid.ColumnDefinitions>
        <UniformGrid Columns="2">
            <Button Content="{Binding [Connect], Source={x:Static local:CLang.s_Instance}}" Width="200"/>
            <Button Content="{Binding [Close], Source={x:Static local:CLang.s_Instance}}" Width="200"/>
        </UniformGrid>
        <GroupBox Grid.Row="1" Style="{StaticResource GroupBoxTab}" Header="{Binding [SendData], Source={x:Static local:CLang.s_Instance}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <RichTextBox Grid.RowSpan="2"/>
                <Button Grid.Column="1" Content="{Binding [Send], Source={x:Static local:CLang.s_Instance}}" Width="100" Height="40"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Ping" Width="100" Height="40"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource GroupBoxTab}" Header="{Binding [RecvData], Source={x:Static local:CLang.s_Instance}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <RichTextBox/>
                <TextBlock Grid.Row="1" Text="{Binding [ConvertData], Source={x:Static local:CLang.s_Instance}}" Style="{StaticResource TextBlockDefault}" Margin="5"/>
                <RichTextBox Grid.Row="2"/>
            </Grid>
        </GroupBox>
        <wh:CPropertyGridLang Grid.Column="1" Grid.RowSpan="4"/>
        <GroupBox Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource GroupBoxTab}" Header="{Binding [Tips], Source={x:Static local:CLang.s_Instance}}">
            <RichTextBox/>
        </GroupBox>
    </Grid>
</hc:Window>
