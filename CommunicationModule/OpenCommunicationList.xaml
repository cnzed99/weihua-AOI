<hc:Window
    x:Class="CommunicationModule.OpenCommunicationList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:CommunicationModule"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding [CommList], Source={x:Static local:CLang.s_Instance}}"
    Width="800"
    Height="300"
    Icon="/CommunicationModule;component/Resources/外接通讯数据.png"
    Background="{DynamicResource SecondaryRegionBrush}"
    mc:Ignorable="d"
    ResizeMode="NoResize"
WindowStartupLocation="CenterScreen">
    <hc:Window.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </hc:Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <UniformGrid Rows="1">
            <Button
                Width="80"
                Content="{Binding [Add], Source={x:Static local:CLang.s_Instance}}"
                Style="{DynamicResource ButtonPrimary}" />
            <Button
                Width="80"
                Content="{Binding [Set], Source={x:Static local:CLang.s_Instance}}"
                Style="{DynamicResource ButtonPrimary}" />
            <Button
                Width="80"
                Content="{Binding [Del], Source={x:Static local:CLang.s_Instance}}"
                Style="{DynamicResource ButtonDanger}" />
        </UniformGrid>
        <DataGrid Grid.Row="1" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [Order], Source={x:Static local:CLang.s_Instance}}" />
                <DataGridTextColumn Header="{Binding [Name], Source={x:Static local:CLang.s_Instance}}" />
                <DataGridTextColumn Header="{Binding [Type], Source={x:Static local:CLang.s_Instance}}" />
                <DataGridTextColumn Header="{Binding [Machine], Source={x:Static local:CLang.s_Instance}}" />
                <DataGridTextColumn Header="{Binding [IP], Source={x:Static local:CLang.s_Instance}}" />
                <DataGridTextColumn Header="{Binding [State], Source={x:Static local:CLang.s_Instance}}" />
                <DataGridTextColumn Header="GUID" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</hc:Window>
