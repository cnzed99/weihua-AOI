<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Autofac" Version="7.1.0" />
    <PackageVersion Include="EasyModbusTCP" Version="5.6.0" />
    <PackageVersion Include="HalconDotNet" Version="19.11.0" />
    <PackageVersion Include="HandyControl.Lang.en" Version="3.5.1" />
    <PackageVersion Include="iTextSharp" Version="5.5.13.4" />
    <PackageVersion Include="log4net" Version="2.0.17" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.19.2" />
    <PackageVersion Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
    <PackageVersion Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageVersion Include="MySql.Data" Version="9.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageVersion Include="DotNetProjects.SVGImage" Version="5.2.1" />
    <PackageVersion Include="HandyControl" Version="3.5.1" />
    <PackageVersion Include="NModbus" Version="3.0.81" />
    <PackageVersion Include="NModbus.Serial" Version="3.0.81" />
    <PackageVersion Include="NModbus4" Version="2.1.0" />
    <PackageVersion Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageVersion Include="OpenCvSharp4.Extensions" Version="4.9.0.20240103" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
    <PackageVersion Include="OpenVINO.CSharp.API" Version="2024.3.0.2" />
    <PackageVersion Include="OpenVINO.CSharp.API.Extensions" Version="1.0.2" />
    <PackageVersion Include="OpenVINO.CSharp.API.Extensions.OpenCvSharp" Version="1.0.6.3" />
    <PackageVersion Include="OpenVINO.CSharp.Windows" Version="2024.0.0.1" />
    <PackageVersion Include="SharpCompress" Version="0.39.0" />
    <PackageVersion Include="Spire.XLS" Version="15.1.3" />
    <PackageVersion Include="System.Drawing.Common" Version="9.0.5" />
    <PackageVersion Include="System.IO.Ports" Version="8.0.0" />
    <PackageVersion Include="System.Management" Version="8.0.0" />
    <PackageVersion Include="System.Reactive" Version="6.0.1-preview.1" />
    <PackageVersion Include="System.Threading.Channels" Version="9.0.0-preview.3.24172.9" />
    <PackageVersion Include="ValueConverters" Version="3.0.26" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageVersion Include="Mapster" Version="7.2.0" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageVersion Include="Mapster" Version="7.4.1-pre01" />
  </ItemGroup>
</Project>