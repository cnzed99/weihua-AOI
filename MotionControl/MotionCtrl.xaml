<UserControl
    x:Class="MotionControl.MotionCtrl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cov="clr-namespace:ValueConverters;assembly=ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:MotionControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wh="http://whzn.com/rjkf/2024/xaml"
    d:DesignHeight="650"
    d:DesignWidth="550"
    mc:Ignorable="d">
    <d:UserControl.DataContext>
        <local:CMotionCtrlVM />
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <Style BasedOn="{StaticResource TextBlockDefault}" TargetType="TextBlock" />
            <Style BasedOn="{StaticResource LabelDefault}" TargetType="Label">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Margin" Value="5" />
            </Style>
            <cov:BoolToBrushConverter
                x:Key="SuccessToBrushConverter"
                FalseValue="{x:Null}"
                TrueValue="{DynamicResource SuccessBrush}" />
            <cov:BoolToStringConverter
                x:Key="BoolToStringConverter"
                FalseValue="{Binding [Connect], Source={x:Static local:CLang.s_Instance}}"
                TrueValue="{Binding [Connected], Source={x:Static local:CLang.s_Instance}}" />
            <cov:BoolToStringConverter
                x:Key="FocusToStringConverter"
                FalseValue="{Binding [AutoFocus], Source={x:Static local:CLang.s_Instance}}"
                TrueValue="{Binding [Focusing], Source={x:Static local:CLang.s_Instance}}" />
            <cov:BoolToBrushConverter
                x:Key="StatusConverter"
                FalseValue="{StaticResource BorderBrush}"
                TrueValue="Lime" />
            <cov:BoolToBrushConverter
                x:Key="StatusReConverter"
                FalseValue="Lime"
                TrueValue="{StaticResource BorderBrush}" />
            <cov:BoolToBrushConverter
                x:Key="GotMaxDisConverter"
                FalseValue="Red"
                TrueValue="{StaticResource BorderBrush}" />
            <Style
                x:Key="DataGrid1"
                BasedOn="{StaticResource DataGrid.Small}"
                TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl Style="{StaticResource TabControlInLine}">
        <TabItem Header="{Binding [AxisControl], Source={x:Static local:CLang.s_Instance}}">
            <DockPanel IsEnabled="{Binding IsRuning, Converter={StaticResource Boolean2BooleanReConverter}}">
                <UniformGrid
                    Margin="5"
                    Columns="2"
                    DockPanel.Dock="Top">
                    <Button
                        Width="100"
                        wh:StatusDotElement.DotBrush="{Binding Connected, Converter={StaticResource StatusConverter}}"
                        Command="{Binding ConnectCommand}"
                        Content="{Binding Connected, Converter={StaticResource BoolToStringConverter}}"
                        IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsTechnologist}"
                        Style="{DynamicResource StatusDotButton}" />
                    <Button
                        Width="100"
                        Margin="20,0"
                        wh:StatusDotElement.DotBrush="{Binding IsFocused, Converter={StaticResource StatusConverter}}"
                        Command="{Binding AutoFocusCommand}"
                        Content="{Binding IsFocusing, Converter={StaticResource FocusToStringConverter}}"
                        DockPanel.Dock="Right"
                        IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsTechnologist}"
                        Style="{DynamicResource StatusDotButton}" />
                </UniformGrid>
                <GroupBox
                    Margin="5"
                    DockPanel.Dock="Top"
                    Header="{Binding [OperateAxis], Source={x:Static local:CLang.s_Instance}}"
                    IsEnabled="{Binding IsFocusing, Converter={StaticResource Boolean2BooleanReConverter}}"
                    Style="{StaticResource GroupBoxTab}">
                    <GroupBox.Resources>
                        <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </GroupBox.Resources>
                    <StackPanel IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsTechnologist}">
                        <UniformGrid Columns="5">
                            <Button
                                Width="100"
                                wh:StatusDotElement.DotBrush="{Binding IsEnable, Converter={StaticResource StatusConverter}}"
                                Command="{Binding EnableCommand}"
                                Content="{Binding [Enable], Source={x:Static local:CLang.s_Instance}}"
                                Style="{DynamicResource StatusDotButton}" />
                            <Button
                                Width="100"
                                wh:StatusDotElement.DotBrush="{Binding MotionConfig.SignalIns[2].HasSignal, Converter={StaticResource StatusReConverter}}"
                                Content="{Binding [GoHome], Source={x:Static local:CLang.s_Instance}}"
                                Style="{DynamicResource StatusDotButton}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseDown">
                                        <i:InvokeCommandAction Command="{Binding MouseDownCommand}" CommandParameter="{Binding MotionConfig.AddrGoHome}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseUp">
                                        <i:InvokeCommandAction Command="{Binding MouseUpCommand}" CommandParameter="{Binding MotionConfig.AddrGoHome}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                            <Button
                                Width="100"
                                wh:StatusDotElement.DotBrush="{Binding MotionConfig.SignalIns[1].HasSignal, Converter={StaticResource GotMaxDisConverter}}"
                                Content="{Binding [Forward], Source={x:Static local:CLang.s_Instance}}"
                                Style="{DynamicResource StatusDotButton}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseDown">
                                        <i:InvokeCommandAction Command="{Binding MouseDownCommand}" CommandParameter="{Binding MotionConfig.AddrFoward}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseUp">
                                        <i:InvokeCommandAction Command="{Binding MouseUpCommand}" CommandParameter="{Binding MotionConfig.AddrFoward}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                            <Button
                                Width="100"
                                wh:StatusDotElement.DotBrush="{Binding MotionConfig.SignalIns[0].HasSignal, Converter={StaticResource GotMaxDisConverter}}"
                                Content="{Binding [Reverse], Source={x:Static local:CLang.s_Instance}}"
                                Style="{DynamicResource StatusDotButton}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseDown">
                                        <i:InvokeCommandAction Command="{Binding MouseDownCommand}" CommandParameter="{Binding MotionConfig.AddrBackward}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseUp">
                                        <i:InvokeCommandAction Command="{Binding MouseUpCommand}" CommandParameter="{Binding MotionConfig.AddrBackward}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                            <Button
                                Width="100"
                                BorderBrush="{StaticResource DangerBrush}"
                                Content="{Binding [Stop], Source={x:Static local:CLang.s_Instance}}"
                                Style="{DynamicResource ButtonDefault}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseDown">
                                        <i:InvokeCommandAction Command="{Binding MouseDownCommand}" CommandParameter="{Binding MotionConfig.AddrStop}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseUp">
                                        <i:InvokeCommandAction Command="{Binding MouseUpCommand}" CommandParameter="{Binding MotionConfig.AddrStop}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>

                            <!--<Label
                                Width="80"
                                Background="{Binding IsEnable, Converter={StaticResource SuccessToBrushConverter}}"
                                Content="{Binding [Enable], Source={x:Static local:CLang.s_Instance}}" />
                            <Label Width="80" Content="{Binding [Home], Source={x:Static local:CLang.s_Instance}}" />-->
                            <!--<Label Width="80" Content="{Binding [PosLimitP], Source={x:Static local:CLang.s_Instance}}" />
                            <Label Width="80" Content="{Binding [PosLimitN], Source={x:Static local:CLang.s_Instance}}" />-->
                            <!--<Label
                                Width="80"
                                Background="{Binding IsAlarmAxis, Converter={StaticResource AlarmToBrushConverter}}"
                                Content="{Binding [Alarm], Source={x:Static local:CLang.s_Instance}}" />
                            <Label
                                Width="80"
                                Background="{Binding IsDriveAlarm, Converter={StaticResource AlarmToBrushConverter}}"
                                Content="{Binding [DriveAlarm], Source={x:Static local:CLang.s_Instance}}" />-->
                        </UniformGrid>
                        <StackPanel>
                            <DockPanel Margin="50,5">

                                <Button
                                    Width="100"
                                    Margin="5,0"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    Command="{Binding AbsMoveCommand}"
                                    CommandParameter="{Binding ElementName=num_abs, Path=Value}"
                                    Content="{Binding [Move], Source={x:Static local:CLang.s_Instance}}"
                                    DockPanel.Dock="Right"
                                    Style="{DynamicResource ButtonDefault}" />
                                <TextBlock
                                    Margin="5,0"
                                    DockPanel.Dock="Right"
                                    Text="mm" />
                                <hc:NumericUpDown
                                    Name="num_abs"
                                    hc:TitleElement.Title="{Binding [AbsPos], Source={x:Static local:CLang.s_Instance}, StringFormat={}{0}:}"
                                    hc:TitleElement.TitlePlacement="Left"
                                    DockPanel.Dock="Left"
                                    Maximum="{Binding MotionConfig.SoftLimitP}"
                                    Minimum="{Binding MotionConfig.SoftLimitN}"
                                    Style="{StaticResource NumericUpDownExtend}" />
                            </DockPanel>
                            <DockPanel Margin="50,5">
                                <Button
                                    Width="50"
                                    Margin="5,0"
                                    BorderBrush="{StaticResource SuccessBrush}"
                                    Command="{Binding RelaMoveNCommand}"
                                    CommandParameter="{Binding ElementName=num_rela, Path=Value}"
                                    Content="{Binding [后退], Source={x:Static local:CLang.s_Instance}}"
                                    DockPanel.Dock="Right"
                                    Style="{DynamicResource ButtonDefault}" />
                                <Button
                                    Width="50"
                                    Margin="5,0"
                                    BorderBrush="{StaticResource SuccessBrush}"
                                    Command="{Binding RelaMovePCommand}"
                                    CommandParameter="{Binding ElementName=num_rela, Path=Value}"
                                    Content="{Binding [前进], Source={x:Static local:CLang.s_Instance}}"
                                    DockPanel.Dock="Right"
                                    Style="{DynamicResource ButtonDefault}" />
                                <TextBlock
                                    Margin="2,0"
                                    DockPanel.Dock="Right"
                                    Text="mm" />
                                <hc:NumericUpDown
                                    Name="num_rela"
                                    hc:TitleElement.Title="{Binding [RelaPos], Source={x:Static local:CLang.s_Instance}, StringFormat={}{0}:}"
                                    hc:TitleElement.TitlePlacement="Left"
                                    DockPanel.Dock="Left"
                                    Minimum="0"
                                    Style="{StaticResource NumericUpDownExtend}" />
                            </DockPanel>

                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Margin="5"
                    DockPanel.Dock="Top"
                    Header="{Binding [ObserveAxis], Source={x:Static local:CLang.s_Instance}}"
                    Style="{StaticResource GroupBoxTab}">
                    <GroupBox.Resources>
                        <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </GroupBox.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBox
                            Margin="3"
                            hc:TitleElement.Title="{Binding [CurPos], Source={x:Static local:CLang.s_Instance}, StringFormat={}{0}:}"
                            hc:TitleElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            IsEnabled="False"
                            Text="{Binding CurPos, StringFormat={}{0:F3}}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Text="mm" />
                        <TextBox
                            Grid.Row="1"
                            Margin="3"
                            hc:TitleElement.Title="{Binding [CurSpeed], Source={x:Static local:CLang.s_Instance}, StringFormat={}{0}:}"
                            hc:TitleElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            IsEnabled="False"
                            Text="{Binding CurSpeed, StringFormat={}{0:F3}}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Text="mm/s" />
                        <TextBox
                            Grid.Row="2"
                            Margin="3"
                            hc:TitleElement.Title="{Binding [CurTorque], Source={x:Static local:CLang.s_Instance}, StringFormat={}{0}:}"
                            hc:TitleElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            IsEnabled="False"
                            Text="{Binding CurTarque, StringFormat={}{0:F3}}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Text="%" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="3"
                            hc:TitleElement.Title="{Binding [FocusPos], Source={x:Static local:CLang.s_Instance}, StringFormat={}{0}:}"
                            hc:TitleElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            IsEnabled="False"
                            Text="{Binding FocusPos, StringFormat={}{0:F3}}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="4"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Text="mm" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="3"
                            Margin="3"
                            hc:TitleElement.Title="{Binding [FocusDst], Source={x:Static local:CLang.s_Instance}, StringFormat={}{0}:}"
                            hc:TitleElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            IsEnabled="False"
                            Text="{Binding FocusPosDst, StringFormat={}{0:F3}}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Text="mm" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="3"
                            Margin="3"
                            hc:TitleElement.Title="{Binding [SensorPos], Source={x:Static local:CLang.s_Instance}, StringFormat={}{0}:}"
                            hc:TitleElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            IsEnabled="False"
                            Text="{Binding SensorPos, StringFormat={}{0:F3}}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="4"
                            Margin="4"
                            HorizontalAlignment="Left"
                            Text="mm" />
                    </Grid>
                </GroupBox>
                <GroupBox
                    Margin="5"
                    Header="{Binding [FocusData], Source={x:Static local:CLang.s_Instance}}"
                    Style="{StaticResource GroupBoxTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TextBlockDefault}" Text="{Binding [CoarseData], Source={x:Static local:CLang.s_Instance}}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource TextBlockDefault}"
                            Text="{Binding [FineData], Source={x:Static local:CLang.s_Instance}}" />
                        <DataGrid
                            Grid.Row="1"
                            Margin="3,0"
                            hc:DataGridAttach.ShowRowNumber="True"
                            AutoGenerateColumns="False"
                            HeadersVisibility="All"
                            ItemsSource="{Binding FocusDatas}"
                            RowHeaderWidth="30"
                            Style="{StaticResource DataGrid.Small}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding pos, StringFormat={}{0:F2}}"
                                    Header="{Binding [Pos], Source={x:Static local:CLang.s_Instance}}"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Binding="{Binding distinct, StringFormat={}{0:F2}}"
                                    Header="{Binding [Distinct], Source={x:Static local:CLang.s_Instance}}"
                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="3,0"
                            hc:DataGridAttach.ShowRowNumber="True"
                            AutoGenerateColumns="False"
                            HeadersVisibility="All"
                            ItemsSource="{Binding FineFocusDatas}"
                            RowHeaderWidth="30"
                            Style="{StaticResource DataGrid.Small}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding pos, StringFormat={}{0:F2}}"
                                    Header="{Binding [Pos], Source={x:Static local:CLang.s_Instance}}"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Binding="{Binding distinct, StringFormat={}{0:F2}}"
                                    Header="{Binding [Distinct], Source={x:Static local:CLang.s_Instance}}"
                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </DockPanel>
        </TabItem>
        <TabItem Header="{Binding [IO], Source={x:Static local:CLang.s_Instance}}">
            <UniformGrid Columns="1">
                <GroupBox Style="{StaticResource GroupBoxTab}">
                    <GroupBox.Header>
                        <DockPanel Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type GroupBox}}, Path=ActualWidth}" LastChildFill="False">
                            <TextBlock Text="{Binding [InputIO], Source={x:Static local:CLang.s_Instance}}" />
                            <Button
                                Width="80"
                                Margin="20,2"
                                Command="{Binding DelInputCommand}"
                                CommandParameter="{Binding ElementName=dataGrid1, Path=SelectedItems}"
                                Content="{Binding [Del], Source={x:Static local:CLang.s_Instance}}"
                                DockPanel.Dock="Right"
                                IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                                Style="{DynamicResource ButtonDanger}" />
                            <Button
                                Width="80"
                                Margin="10,2"
                                Command="{Binding AddInputCommand}"
                                Content="{Binding [Add], Source={x:Static local:CLang.s_Instance}}"
                                DockPanel.Dock="Right"
                                IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                                Style="{DynamicResource ButtonPrimary}" />
                        </DockPanel>
                    </GroupBox.Header>
                    <DataGrid
                        x:Name="dataGrid1"
                        hc:DataGridAttach.ShowRowNumber="True"
                        AutoGenerateColumns="False"
                        HeadersVisibility="All"
                        ItemsSource="{Binding MotionConfig.SignalIns}"
                        RowHeaderWidth="30"
                        Style="{StaticResource DataGrid1}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Binding="{Binding Name}"
                                Header="{Binding [Name], Source={x:Static local:CLang.s_Instance}}"
                                IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                            <DataGridTextColumn
                                Binding="{Binding Addr}"
                                Header="{Binding [Addr], Source={x:Static local:CLang.s_Instance}}"
                                IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                            <DataGridTemplateColumn Header="{Binding [State], Source={x:Static local:CLang.s_Instance}}" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <wh:StatusLight Fill="{Binding HasSignal, Converter={StaticResource StatusConverter}}" Radius="10" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding Description}"
                                Header="{Binding [Description], Source={x:Static local:CLang.s_Instance}}"
                                IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GroupBox Style="{StaticResource GroupBoxTab}">
                    <GroupBox.Header>
                        <DockPanel Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type GroupBox}}, Path=ActualWidth}" LastChildFill="False">
                            <TextBlock Text="{Binding [OutputIO], Source={x:Static local:CLang.s_Instance}}" />
                            <Button
                                Width="80"
                                Margin="20,2"
                                Command="{Binding DelOutputCommand}"
                                CommandParameter="{Binding ElementName=dataGrid2, Path=SelectedItems}"
                                Content="{Binding [Del], Source={x:Static local:CLang.s_Instance}}"
                                DockPanel.Dock="Right"
                                IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                                Style="{DynamicResource ButtonDanger}" />
                            <Button
                                Width="80"
                                Margin="10,2"
                                Command="{Binding AddOutputCommand}"
                                Content="{Binding [Add], Source={x:Static local:CLang.s_Instance}}"
                                DockPanel.Dock="Right"
                                IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                                Style="{DynamicResource ButtonPrimary}" />
                        </DockPanel>
                    </GroupBox.Header>
                    <DataGrid
                        x:Name="dataGrid2"
                        hc:DataGridAttach.ShowRowNumber="True"
                        HeadersVisibility="All"
                        ItemsSource="{Binding MotionConfig.SignalOuts}"
                        RowHeaderWidth="30"
                        Style="{DynamicResource DataGrid1}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Binding="{Binding Addr}"
                                Header="{Binding [Addr], Source={x:Static local:CLang.s_Instance}}"
                                IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                            <DataGridTemplateColumn Header="{Binding [State], Source={x:Static local:CLang.s_Instance}}" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <wh:StatusLight Fill="{Binding HasSignal, Converter={StaticResource StatusConverter}}" Radius="10" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--<DataGridCheckBoxColumn
                                Binding="{Binding HasSignal}"
                                Header="{Binding [State], Source={x:Static local:CLang.s_Instance}}"
                                IsReadOnly="True" />-->
                            <DataGridTextColumn
                                Binding="{Binding Name}"
                                Header="{Binding [Name], Source={x:Static local:CLang.s_Instance}}"
                                IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                            <DataGridTemplateColumn Header="{Binding [OpenOrClose], Source={x:Static local:CLang.s_Instance}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton
                                            Width="30"
                                            hc:VisualElement.HighlightBrush="Lime"
                                            Background="{StaticResource SecondaryRegionBrush}"
                                            Command="{Binding ElementName=dataGrid2, Path=DataContext.SetOutputCommand}"
                                            CommandParameter="{Binding}"
                                            IsChecked="{Binding Set, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                                            Style="{StaticResource ToggleButtonSwitch.Small}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Binding="{Binding AddrM, UpdateSourceTrigger=PropertyChanged}"
                                Header="{Binding [WriteAddrM], Source={x:Static local:CLang.s_Instance}}"
                                IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding Description}"
                                Header="{Binding [Description], Source={x:Static local:CLang.s_Instance}}"
                                IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </UniformGrid>
        </TabItem>
        <TabItem Header="{Binding [RegisterInfo], Source={x:Static local:CLang.s_Instance}}">
            <GroupBox Style="{StaticResource GroupBoxTab}">
                <GroupBox.Header>
                    <DockPanel Width="{Binding RelativeSource={RelativeSource AncestorType=GroupBox}, Path=ActualWidth}" LastChildFill="False">
                        <TextBlock Text="{Binding [RegisterInfo], Source={x:Static local:CLang.s_Instance}}" />
                        <Button
                            Width="80"
                            Margin="10,2"
                            Command="{Binding WriteRegisterCommand}"
                            Content="{Binding [WriteAll], Source={x:Static local:CLang.s_Instance}}"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                            Style="{DynamicResource ButtonPrimary}" />
                        <Button
                            Width="80"
                            Margin="10,2"
                            Command="{Binding AddRegisterCommand}"
                            Content="{Binding [Add], Source={x:Static local:CLang.s_Instance}}"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                            Style="{DynamicResource ButtonPrimary}" />

                    </DockPanel>
                </GroupBox.Header>
                <DataGrid
                    Name="dataGrid3"
                    hc:DataGridAttach.ShowRowNumber="True"
                    AutoGenerateColumns="False"
                    HeadersVisibility="All"
                    ItemsSource="{Binding MotionConfig.RegisterSets}"
                    RowHeaderWidth="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding Name}"
                            Header="{Binding [Name], Source={x:Static local:CLang.s_Instance}}"
                            IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                        <DataGridTextColumn
                            Binding="{Binding Addr}"
                            Header="{Binding [Addr], Source={x:Static local:CLang.s_Instance}}"
                            IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                        <DataGridTextColumn
                            Binding="{Binding ValueRead}"
                            Header="{Binding [Read], Source={x:Static local:CLang.s_Instance}}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Binding="{Binding ValueWrite}"
                            Header="{Binding [Write], Source={x:Static local:CLang.s_Instance}}"
                            IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                        <DataGridTemplateColumn Width="70" Header="{Binding [Write], Source={x:Static local:CLang.s_Instance}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding ElementName=dataGrid3, Path=DataContext.WriteSingleRegisterCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding [Write], Source={x:Static local:CLang.s_Instance}}"
                                        IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                                        Style="{DynamicResource ButtonSuccess}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="70" Header="{Binding [Del], Source={x:Static local:CLang.s_Instance}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding ElementName=dataGrid3, Path=DataContext.DelRegisterCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding [Del], Source={x:Static local:CLang.s_Instance}}"
                                        IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                                        Style="{DynamicResource ButtonDanger}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Description}"
                            Header="{Binding [Description], Source={x:Static local:CLang.s_Instance}}"
                            IsReadOnly="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer, Converter={StaticResource Boolean2BooleanReConverter}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </TabItem>
        <TabItem Header="{Binding [AxisConfig], Source={x:Static local:CLang.s_Instance}}">
            <GroupBox Style="{StaticResource GroupBoxTab}">
                <GroupBox.Header>
                    <DockPanel Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type GroupBox}}, Path=ActualWidth}" LastChildFill="False">
                        <Button
                            Width="80"
                            Margin="20,2"
                            Command="{Binding WriteRegisterFixCommand}"
                            Content="{Binding [Write], Source={x:Static local:CLang.s_Instance}}"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                            Style="{DynamicResource ButtonPrimary}" />
                        <TextBlock Text="{Binding [AxisConfig], Source={x:Static local:CLang.s_Instance}}" />
                    </DockPanel>
                </GroupBox.Header>
                <wh:CPropertyGridLang
                    IsEditable="{Binding Source={x:Static wh:CLoginViewModel.SloinPerson}, Path=IsEngineer}"
                    SelectedObject="{Binding MotionConfig}"
                    lang="{x:Static local:CLang.s_Instance}" />
            </GroupBox>
        </TabItem>
    </TabControl>
</UserControl>
