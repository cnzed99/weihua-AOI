<hc:Window x:Class="ZipperInfo.AutoFinshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZipperInfo"
           xmlns:hc="https://handyorg.github.io/handycontrol"
            xmlns:wh="http://whzn.com/rjkf/2024/xaml"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
             d:DataContext="{d:DesignInstance Type=local:ZipperInfoVM}"
           x:Name="window" WindowStyle="None"
        Title="自动识别结果" Height="500" Width="700">
    <Border BorderBrush="#FF9E9C9C" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
             
                <Border Grid.Row="0" Margin="4,0,0,0"
                          Background="{DynamicResource RegionBrush}"
                          BorderThickness="1">
                    <wh:ImageView  Grid.Row="0" Source="{Binding ZipperInfo.TempData1.ZipperDownmssImg}"
                                   ClearButtonVisibility="Collapsed"  LabelVisibility="Collapsed"/>
                    
                </Border>
                <TextBlock Grid.Row="0" Text="低爆图片" Margin="10,5"  FontSize="16"
                 Foreground="AliceBlue"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"/>

                <Border Grid.Row="1" Margin="4,0,0,0"
                        Background="{DynamicResource RegionBrush}"
                        BorderThickness="1">
                    <wh:ImageView   Grid.Row="0" Source="{Binding ZipperInfo.TempData1.ZipperUpmssImg}"
                                    ClearButtonVisibility="Collapsed" LabelVisibility="Collapsed"/>
                </Border>
                <TextBlock Grid.Row="1"  Text="高曝图片" Margin="10,5"  FontSize="16"
                 Foreground="AliceBlue"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"/>
                <Border Grid.Row="2" Margin="4,0,0,0"
                        Background="{DynamicResource RegionBrush}"
                        BorderThickness="1">
                    <wh:ImageView  Grid.Row="0" Source="{Binding ZipperInfo.TempData1.ZipperLogoImg}"
                                   ClearButtonVisibility="Collapsed" LabelVisibility="Collapsed"/>
                </Border>
                <TextBlock Grid.Row="2"  Text="Logo图片" Margin="10,5"  FontSize="16"
   Foreground="AliceBlue"
   HorizontalAlignment="Left"
   VerticalAlignment="Top"/>
                <Border Grid.Row="3" Margin="4,0,0,0"
                        Background="{DynamicResource RegionBrush}"
                        BorderThickness="1">
                    <wh:ImageView  Grid.Row="0"  Source="{Binding ZipperInfo.TempData1.ZipperUpmssImg}"
                                   ClearButtonVisibility="Collapsed" LabelVisibility="Collapsed"/>
                </Border>
                <TextBlock Grid.Row="3"  Text="上止图片" Margin="10,5"  FontSize="16"
   Foreground="AliceBlue"
   HorizontalAlignment="Left"
   VerticalAlignment="Top"/>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!--<wh:CPropertyGridLang FontSize="14" SelectedObject="{Binding ZipperInfo}"/>-->
                <local:ZipperInfoUserControl x:Name="InfoUserCol"/>
                <Border Grid.Row="1"  Background="{DynamicResource RegionBrush}" BorderThickness="1">
                    <Grid >
                        <!--<Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>-->
                        <!--<Button Grid.Column="0" Width="120" Height="50"  Margin="2" Content="测试" />-->
                        <Button Grid.Column="1" FontSize="40" Width="180" Height="80"  Content="确认" Command="{Binding saveCommand}" CommandParameter="{Binding ElementName=window}"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</hc:Window>
