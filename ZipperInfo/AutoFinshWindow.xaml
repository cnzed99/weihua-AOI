<hc:Window x:Class="ZipperInfo.AutoFinshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZipperInfo"
           xmlns:hc="https://handyorg.github.io/handycontrol"
            xmlns:wh="http://whzn.com/rjkf/2024/xaml"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
             d:DataContext="{d:DesignInstance Type=local:ZipperInfoVM}"
        Title="自动识别结果" Height="800" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
              Background="{DynamicResource RegionBrush}"
              BorderThickness="1">
                <wh:ImageView  Grid.Row="0" Source="{Binding ZipperInfo.ZipperDownmssImg}"/>
            </Border>

            <Border Grid.Row="1"
                Background="{DynamicResource RegionBrush}"
                BorderThickness="1">
                <wh:ImageView  Grid.Row="0" Source="{Binding ZipperInfo.ZipperPullerImg}"/>
            </Border>
            <Border Grid.Row="2"
                Background="{DynamicResource RegionBrush}"
                BorderThickness="1">
                <wh:ImageView  Grid.Row="0" Source="{Binding ZipperInfo.ZipperPullsImg}"/>
            </Border>

            <Border Grid.Row="3"
            Background="{DynamicResource RegionBrush}"
            BorderThickness="1">
                <wh:ImageView  Grid.Row="0"  Source="{Binding ZipperInfo.ZipperUpmssImg}"/>
            </Border>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <wh:CPropertyGridLang FontSize="14" SelectedObject="{Binding ZipperInfo}"/>
            <Border Grid.Row="1"  Background="{DynamicResource RegionBrush}" BorderThickness="1">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Width="120" Height="50"  Margin="2" Content="重新识别" />
                    <Button Grid.Column="1" Width="120" Height="50"  Margin="2" Content="确认" />
                </Grid>
            </Border>
        </Grid>
       
    </Grid>
</hc:Window>
