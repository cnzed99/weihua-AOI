<hc:Window x:Class="ZipperInfo.ZipperAutomaticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZipperInfo"
        xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:keyboard="clr-namespace:KeyBoard.WPF.Behavior;assembly=KeyBoard.WPF"
           xmlns:wh="http://whzn.com/rjkf/2024/xaml"
        mc:Ignorable="d"
           WindowStartupLocation="CenterScreen"
           Name="win" WindowStyle="None"
        d:DataContext="{d:DesignInstance Type=local:CZipperAutomaticVM}"
        Title="换料识别" Height="150" Width="700" >

    <hc:Window.Resources>
        <wh:Bool2VisiblityConverter x:Key="Bool2VisiblityConverter" />
    </hc:Window.Resources>
    <Border BorderBrush="#FF9E9C9C" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <!--<RowDefinition/>
            <RowDefinition/>-->
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.ColumnSpan="2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                 <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                        <TextBlock Margin="10,25,0,0" Text="拉链长度(mm)"  FontSize="22"/>
                    <hc:NumericUpDown Margin="10,35,0,0"  Value="{Binding AutoData.ZipperLenght, UpdateSourceTrigger=PropertyChanged}"
                                      DecimalPlaces="1" Minimum="0" Maximum="2000"
                    Width="150" Height="45" FontSize="30">
                        <i:Interaction.Behaviors>
                            <keyboard:NumericKeyboardBehavior/>
                        </i:Interaction.Behaviors>
                    </hc:NumericUpDown>

                    <TextBlock Margin="10,25,0,0"  Grid.Column="1" 
                               Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}, Converter={StaticResource Bool2VisiblityConverter}}"
                               Text="中心距离(mm)"  FontSize="22" />
                    <hc:NumericUpDown   Grid.Column="1"
                                Value="{Binding AutoData.DaoDitance, UpdateSourceTrigger=PropertyChanged}" 
                                        Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}, Converter={StaticResource Bool2VisiblityConverter}}"
                            Margin="10,35,0,0" DecimalPlaces="1" Minimum="0" Maximum="2000" hc:InfoElement.ShowClearButton="True"
                            Width="150" Height="45" FontSize="30" >
                        <i:Interaction.Behaviors>
                            <keyboard:NumericKeyboardBehavior/>
                        </i:Interaction.Behaviors>
                    </hc:NumericUpDown>


                    <TextBlock Margin="10,25,0,0"  Grid.Column="2"
                               Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}, Converter={StaticResource Bool2VisiblityConverter}}"
                               Text="相机视野(mm)"  FontSize="22"/>
                    <hc:NumericUpDown Margin="10,35,0,0" Grid.Column="2"
                                      Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}, Converter={StaticResource Bool2VisiblityConverter}}"
                                      Value="{Binding AutoData.CcdWidth, UpdateSourceTrigger=PropertyChanged}" 
                                  DecimalPlaces="1" Minimum="0" Maximum="1000" hc:InfoElement.ShowClearButton="True" 
                                  Width="150" Height="45" FontSize="30" >
                        <i:Interaction.Behaviors>
                            <keyboard:NumericKeyboardBehavior/>
                        </i:Interaction.Behaviors>
                    </hc:NumericUpDown>

                </Grid>

                <Grid Grid.Column="1" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.3*"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button  Grid.Row="0" 
                       Width="150"
                        Height="70"
                       FontSize="30"
                       Command="{Binding SendPointsCommand}" CommandParameter="{Binding ElementName=win}"
                       Content="开始" />
                    <Button  Grid.Row="1"  
                     Width="150"
                      Height="50"
                     FontSize="30"
                     Command="{Binding CloseWinCommand}" CommandParameter="{Binding ElementName=win}"
                     Content="关闭" />
                </Grid>
            </Grid>
