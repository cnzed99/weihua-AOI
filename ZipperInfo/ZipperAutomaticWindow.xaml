<hc:Window x:Class="ZipperInfo.ZipperAutomaticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZipperInfo"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
           WindowStartupLocation="CenterScreen"
           Name="win"
        d:DataContext="{d:DesignInstance Type=local:CZipperAutomaticVM}"
        Title="换料识别" Height="120" Width="700" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="139*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <!--<RowDefinition/>
            <RowDefinition/>-->
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel  Orientation="Horizontal" >
                <hc:NumericUpDown Value="{Binding AutoData.ZipperLenght, UpdateSourceTrigger=PropertyChanged}" Margin="10" DecimalPlaces="1" Minimum="0" Maximum="2000" hc:InfoElement.ShowClearButton="True" Width="150" Height="65" FontSize="16"  hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="拉链长度(mm)" Style="{StaticResource NumericUpDownPlus}"  />
                <hc:NumericUpDown Value="{Binding AutoData.DaoDitance, UpdateSourceTrigger=PropertyChanged}" Margin="10" DecimalPlaces="1" Minimum="0" Maximum="2000" hc:InfoElement.ShowClearButton="True" Width="150" Height="65" FontSize="16"  hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="中心距离(mm)" Style="{StaticResource NumericUpDownPlus}" />
                <hc:NumericUpDown Value="{Binding AutoData.CcdWidth, UpdateSourceTrigger=PropertyChanged}" Margin="10" DecimalPlaces="1" Minimum="0" Maximum="1000" hc:InfoElement.ShowClearButton="True" Width="150" Height="65" FontSize="16"  hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="视野范围(mm)" Style="{StaticResource NumericUpDownPlus}" />

            </StackPanel>
            <Button Grid.Column="1" 
              Width="150"
               Height="80"
              FontSize="30"
              Command="{Binding SendPointsCommand}" CommandParameter="{Binding ElementName=win}"
              Content="开始" />

        </Grid>
