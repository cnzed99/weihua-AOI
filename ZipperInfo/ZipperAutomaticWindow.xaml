<hc:Window x:Class="ZipperInfo.ZipperAutomaticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZipperInfo"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:keyboard="clr-namespace:KeyBoard.WPF.Behavior;assembly=KeyBoard.WPF"
        xmlns:wh="http://whzn.com/rjkf/2024/xaml"
        mc:Ignorable="d"
           WindowStartupLocation="CenterScreen"
           Name="win" WindowStyle="None"
        d:DataContext="{d:DesignInstance Type=local:CZipperAutomaticVM}"
        Title="换料识别" Height="650" Width="750" >

    <hc:Window.Resources>
        <wh:Bool2VisiblityConverter x:Key="Bool2VisiblityConverter" />
        <ObjectDataProvider x:Key="BoltTypeProvider" 
                        MethodName="GetValues" 
                        ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:BOLTDIRECTION"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="HaveSabProvider" 
                      MethodName="GetValues" 
                      ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:HAVESAB"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </hc:Window.Resources>
    <Border BorderBrush="#FF9E9C9C" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1.8*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>
            <GroupBox>
                <Grid Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                     <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Margin="10,10"  Text="拉链长度(cm)"  FontSize="30"/>
                            <hc:NumericUpDown  
                           Margin="10,0" Value="{Binding ShowZipperLenght, UpdateSourceTrigger=PropertyChanged}"
                            DecimalPlaces="2" Increment="0.05" Minimum="0" Maximum="2000" Width="250" Height="55" FontSize="40">
                                <i:Interaction.Behaviors>
                                    <keyboard:NumericKeyboardBehavior/>
                                </i:Interaction.Behaviors>
                            </hc:NumericUpDown>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock  Grid.Row="1" Margin="10,10" Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                                        Text="刀口长度(cm)"  FontSize="30" />
                            <hc:NumericUpDown  Grid.Row="1" Margin="10,0" Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}}" 
                                           Value="{Binding QuekouLenght, UpdateSourceTrigger=PropertyChanged}" DecimalPlaces="2" Increment="0.05" 
                                           Minimum="0" Maximum="2000" Width="250" Height="55" FontSize="40">
                                <i:Interaction.Behaviors>
                                    <keyboard:NumericKeyboardBehavior/>
                                </i:Interaction.Behaviors>
                            </hc:NumericUpDown>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock  Grid.Row="1" Margin="10,10" Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                               Text="插   销   方  向"  FontSize="30" />
                            <hc:ComboBox  Margin="5" SelectedItem="{Binding AutoData[0].BoltDiretion}" Width="250" Height="55"
                                         ItemsSource="{Binding Source={StaticResource  BoltTypeProvider}}" FontSize="35"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <TextBlock  Grid.Row="1" Margin="10,10" Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                   Text="插 销 有 无  字"  FontSize="30" />
                            <hc:ComboBox  Margin="5" SelectedItem="{Binding AutoData[0].HaveSAB}" Width="250" Height="55"
                             ItemsSource="{Binding Source={StaticResource  HaveSabProvider}}" FontSize="35"/>
                        </StackPanel>
                    </Grid>
           
                <Grid Grid.Column="1" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.3*"/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                <Button  Grid.Row="0" 
                       Width="150"
                        Height="70"
                       FontSize="30"
                       Command="{Binding SendPointsCommand}" CommandParameter="{Binding ElementName=win}"
                       Content="开始" >
                </Button>
                <Button  Grid.Row="1"  
                     Width="150"
                      Height="70"
                     FontSize="30"
                     Command="{Binding CloseWinCommand}" CommandParameter="{Binding ElementName=win}"
                     Content="关闭" />

                    <Button  Grid.Row="2" 
                  Width="150"
                   Height="70"
                  FontSize="30"
                  Command="{Binding SendPoints2Command}" CommandParameter="{Binding ElementName=win}"
                  Content="测试" >
                    </Button>
                </Grid>
            </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" >
                <StackPanel  Orientation="Vertical" VerticalAlignment="Center" >
                    <ItemsControl  ItemsSource="{Binding AutoData[0].LinghtValueInfos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding ColorName}" Margin="22,1" FontSize="30" GroupName="ColorGroup"
                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding AutoData[0].LinghtValueInfos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <hc:NumericUpDown Width="120" Maximum="110"  Minimum="30" Value="{Binding ClothLinghtValue}" Margin="12,5" FontSize="30"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding AutoData[0].LinghtValueInfos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <hc:NumericUpDown Width="120"  Maximum="255"  Minimum="1" Value="{Binding UpMassLinghtValue}" Margin="12,5" FontSize="30"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition Height="1.5*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"  Orientation="Horizontal">
                        <TextBlock   Margin="10" Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                           Text="相机视野(mm)"  FontSize="30" />
                        <hc:NumericUpDown   Margin="2" Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}}" 
                              Value="{Binding AutoData[0].CcdWidth, UpdateSourceTrigger=PropertyChanged}" DecimalPlaces="2" Increment="1" 
                              Minimum="0" Maximum="500" Width="250" Height="55" FontSize="40">
                            <i:Interaction.Behaviors>
                                <keyboard:NumericKeyboardBehavior/>
                            </i:Interaction.Behaviors>
                        </hc:NumericUpDown>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <!--Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}, Converter={StaticResource Bool2VisiblityConverter}}"-->
                        <TextBlock 
                            Margin="10"   Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                            Text="中心距离(mm)"  FontSize="30" />
                        <hc:NumericUpDown   
                            Value="{Binding AutoData[0].DaoDitance, UpdateSourceTrigger=PropertyChanged}" 
                            Visibility="{Binding Path=IsEngineer,Source={x:Static wh:CLoginViewModel.SloinPerson}}"
                            Margin="1,0" DecimalPlaces="1" Minimum="0" Maximum="2000" hc:InfoElement.ShowClearButton="True"
                             Width="250" Height="55" FontSize="40" >
                            <i:Interaction.Behaviors>
                                <keyboard:NumericKeyboardBehavior/>
                            </i:Interaction.Behaviors>
                        </hc:NumericUpDown>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <hc:NumericUpDown Value="{Binding AutoData[0].ZipperMinBgMean, UpdateSourceTrigger=PropertyChanged}" Margin="10,1" DecimalPlaces="1" Minimum="0" Maximum="2000" hc:InfoElement.ShowClearButton="True" Width="150" Height="85" FontSize="30"  hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="背景下限" Style="{StaticResource NumericUpDownPlus}"  />
                        <hc:NumericUpDown Value="{Binding AutoData[0].ZipperMaxBgMean, UpdateSourceTrigger=PropertyChanged}" Margin="10,1" DecimalPlaces="1" Minimum="0" Maximum="2000" hc:InfoElement.ShowClearButton="True" Width="150" Height="85" FontSize="30"  hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="背景上限" Style="{StaticResource NumericUpDownPlus}"  />
                        <hc:NumericUpDown Value="{Binding AutoData[0].ZipperMinMean, UpdateSourceTrigger=PropertyChanged}" Margin="10,1" DecimalPlaces="1" Minimum="0" Maximum="2000" hc:InfoElement.ShowClearButton="True" Width="150" Height="85" FontSize="30"  hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="前景下限" Style="{StaticResource NumericUpDownPlus}"  />
                        <hc:NumericUpDown Value="{Binding AutoData[0].ZipperMaxMean, UpdateSourceTrigger=PropertyChanged}" Margin="10,1" DecimalPlaces="1" Minimum="0" Maximum="2000" hc:InfoElement.ShowClearButton="True" Width="150" Height="85" FontSize="30"  hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="前景上限" Style="{StaticResource NumericUpDownPlus}"  />
                    </StackPanel>
                </Grid>
            </GroupBox>
       

        </Grid>
    </Border>

</hc:Window>
