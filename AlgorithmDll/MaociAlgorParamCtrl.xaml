<UserControl x:Class="AlgorithmDll.MaociAlgorParamCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlgorithmDll"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:wh="clr-namespace:WH.Controls;assembly=WH.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <d:UserControl.DataContext>
        <local:MaociAlgorParamCtrlVm/>
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <local:GridHeigth2ExpanderHeight x:Key="GridHeigth2ExpanderHeight"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GroupBox Style="{StaticResource GroupBoxTab}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding [PCParam], Source={x:Static local:Lang.instance}}" VerticalAlignment="Center"/>
                    <ComboBox DockPanel.Dock="Left" Name="cmb_pcParam" Width="150" Margin="5,3" DataContext="{Binding Config}" ItemsSource="{Binding PcParams}" >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.SelectedItem>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <local:string2ComboxSelectItemPc/>
                                </MultiBinding.Converter>
                                <Binding Path="PcSelect"/>
                                <Binding Path="PcParams"/>
                            </MultiBinding>
                        </ComboBox.SelectedItem>
                    </ComboBox>
                    <Button Content="{Binding [Add], Source={x:Static local:Lang.instance}}" DockPanel.Dock="Right" Margin="10,0" Width="70" Style="{DynamicResource ButtonPrimary}" Command="{Binding AddPcParamCommand}"/>
                    <Button Content="{Binding [Delete], Source={x:Static local:Lang.instance}}"  DockPanel.Dock="Right" Width="70" Style="{DynamicResource ButtonDanger}" Command="{Binding RemovePcParamCommand}"
                            CommandParameter="{Binding ElementName=cmb_pcParam, Path=SelectedItem}"/>
                </StackPanel>
            </GroupBox.Header>
            <wh:PropertyGridLang Lang="{x:Static local:Lang.instance}" SelectedObject="{Binding ElementName=cmb_pcParam, Path=SelectedItem}"/>
        </GroupBox>
        <GroupBox Grid.Row="2" Style="{StaticResource GroupBoxTab}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding [FPGAParam], Source={x:Static local:Lang.instance}}" VerticalAlignment="Center"/>
                    <ComboBox DockPanel.Dock="Left" Name="cmb_fpgaParam" Width="150" Margin="5,3" DataContext="{Binding Config}" ItemsSource="{Binding FpgaParams}" >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.SelectedItem>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <local:string2ComboxSelectItemFpga/>
                                </MultiBinding.Converter>
                                <Binding Path="FpgaSelect"/>
                                <Binding Path="FpgaParams"/>
                            </MultiBinding>
                        </ComboBox.SelectedItem>
                    </ComboBox>
                    <Button Content="{Binding [Add], Source={x:Static local:Lang.instance}}" DockPanel.Dock="Right" Margin="10,0" Width="70" Style="{DynamicResource ButtonPrimary}" Command="{Binding AddFpgaParamCommand}"/>
                    <Button Content="{Binding [Delete], Source={x:Static local:Lang.instance}}"  DockPanel.Dock="Right" Width="70" Style="{DynamicResource ButtonDanger}" Command="{Binding RemoveFpgaParamCommand}"
                            CommandParameter="{Binding ElementName=cmb_fpgaParam, Path=SelectedItem}"/>
                    <Button Content="{Binding [WriteFpga], Source={x:Static local:Lang.instance}}" DockPanel.Dock="Right" Margin="10,0" Width="100" Style="{DynamicResource ButtonWarning}"
                            Command="{Binding WriteFpgaCommand}" CommandParameter="{Binding ElementName=cmb_fpgaParam, Path=SelectedItem}"/>
                </StackPanel>
            </GroupBox.Header>
            <wh:PropertyGridLang Lang="{x:Static local:Lang.instance}" SelectedObject="{Binding ElementName=cmb_fpgaParam, Path=SelectedItem}"/>
        </GroupBox>
    </Grid>
</UserControl>
