<UserControl
    x:Class="ProjProduceData.ProduceData"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:ProjProduceData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <d:UserControl.DataContext>
        <local:DefectsDataVM />
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style
            x:Key="tblock"
            BasedOn="{StaticResource TextBlockDefaultBold}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <UniformGrid
            Columns="3"
            DataContext="{Binding DefectsProduce}"
            Rows="2">
            <TextBox
                Width="100"
                hc:TitleElement.Title="All"
                Text="{Binding Total}" />
            <TextBox Width="100" hc:TitleElement.Title="OK">
                <TextBox.Text>
                    <MultiBinding ConverterParameter="OK" StringFormat="{}{0}">
                        <MultiBinding.Converter>
                            <local:MultiCalcConverter />
                        </MultiBinding.Converter>
                        <Binding Path="Total" />
                        <Binding Path="Ng" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
            <TextBox
                Width="100"
                hc:TitleElement.Title="NG"
                Text="{Binding Ng}" />
            <hc:SimplePanel />
            <TextBox Width="100" hc:TitleElement.Title="OK">
                <TextBox.Text>
                    <MultiBinding ConverterParameter="OK%" StringFormat="{}{0:P2}">
                        <MultiBinding.Converter>
                            <local:MultiCalcConverter />
                        </MultiBinding.Converter>
                        <Binding NotifyOnSourceUpdated="False" Path="Total" />
                        <Binding NotifyOnSourceUpdated="True" Path="Ng" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>

            <TextBox Width="100" hc:TitleElement.Title="NG">
                <TextBox.Text>
                    <MultiBinding ConverterParameter="NG%" StringFormat="{}{0:P2}">
                        <MultiBinding.Converter>
                            <local:MultiCalcConverter />
                        </MultiBinding.Converter>
                        <Binding Path="Total" />
                        <Binding Path="Ng" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </UniformGrid>
        <hc:Divider
            Grid.Column="1"
            LineStroke="DarkCyan"
            LineStrokeThickness="1"
            Orientation="Vertical" />
        <ItemsControl Grid.Column="2" ItemsSource="{Binding DefectsProduce.QualityNumbersList}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Foreground="{Binding ShowColor.Brush}"
                            Style="{StaticResource tblock}"
                            Text="{Binding Name}" />
                        <TextBlock
                            Width="100"
                            Style="{StaticResource tblock}"
                            Text="{Binding Number}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
