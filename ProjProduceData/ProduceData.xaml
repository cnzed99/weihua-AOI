<UserControl x:Class="ProjProduceData.ProduceData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjProduceData"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <d:UserControl.DataContext>
        <local:DefectsDataVM/>
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <UniformGrid Rows="2" DataContext="{Binding DefectsProduce}">
            <TextBlock Text="All" Style="{StaticResource TextBlockDefault}"/>
            <TextBlock Text="{Binding Total}"  Style="{StaticResource TextBlockDefaultBold}"/>
            <TextBlock Text="OK"  Style="{StaticResource TextBlockDefault}"/>
            <TextBlock  Style="{StaticResource TextBlockDefaultBold}">
                <TextBlock.Text>
                    <MultiBinding ConverterParameter="OK" StringFormat="{}{0}">
                        <MultiBinding.Converter>
                            <local:MultiCalcConverter/>
                        </MultiBinding.Converter>
                        <Binding Path="Total"/>
                        <Binding Path="Ng"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Text="NG"  Style="{StaticResource TextBlockDefault}"/>
            <TextBlock Text="{Binding Ng}"  Style="{StaticResource TextBlockDefaultBold}"/>
            <TextBlock/>
            <TextBlock/>
            <TextBlock Text="OK%"  Style="{StaticResource TextBlockDefault}"/>
            <TextBlock  Style="{StaticResource TextBlockDefaultBold}">
                <TextBlock.Text>
                    <MultiBinding ConverterParameter="OK%" StringFormat="{}{0:P2}">
                        <MultiBinding.Converter>
                            <local:MultiCalcConverter/>
                        </MultiBinding.Converter>
                        <Binding Path="Total"/>
                        <Binding Path="Ng"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Text="NG%"  Style="{StaticResource TextBlockDefault}"/>
            <TextBlock  Style="{StaticResource TextBlockDefaultBold}">
                <TextBlock.Text>
                    <MultiBinding ConverterParameter="NG%" StringFormat="{}{0:P2}">
                        <MultiBinding.Converter>
                            <local:MultiCalcConverter/>
                        </MultiBinding.Converter>
                        <Binding Path="Total"/>
                        <Binding Path="Ng"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </UniformGrid>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding DefectsProduce.QualityNumbersList}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <UniformGrid Rows="1">
                        <TextBlock Text="{Binding Name}" Foreground="{Binding ShowColor.brush}" Style="{StaticResource TextBlockDefault}"/>
                        <TextBlock Text="{Binding Number}" Style="{StaticResource TextBlockDefaultBold}"/>
                    </UniformGrid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
