<UserControl
    x:Class="ProjProduceData.ProduceData"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:ProjProduceData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <d:UserControl.DataContext>
        <local:CDefectsDataVM />
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <Style BasedOn="{StaticResource TextBoxExtend}" TargetType="TextBox">
            <Setter Property="hc:TitleElement.TitlePlacement" Value="Left" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="hc:BorderElement.CornerRadius" Value="0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style
            x:Key="tblock"
            BasedOn="{StaticResource TextBlockDefaultBold}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <UniformGrid
            Margin="10,0"
            Columns="2"
            DataContext="{Binding DefectsProduce}"
            Rows="2">
            <TextBox hc:TitleElement.Title="{Binding [总数], Source={x:Static local:CLang.s_Instance}}" Text="{Binding Total}" FontSize="24"/>
            <TextBox hc:TitleElement.Title="{Binding [良品], Source={x:Static local:CLang.s_Instance}}" Text="{Binding OK}" FontSize="24"/>
            <TextBox hc:TitleElement.Title="{Binding [良率], Source={x:Static local:CLang.s_Instance}}" Text="{Binding OKPercent, Mode=OneWay, StringFormat=P2}"  FontSize="24"/>
            <TextBox hc:TitleElement.Title="{Binding [不良], Source={x:Static local:CLang.s_Instance}}" Text="{Binding Ng}" FontSize="24"/>
            <!--<hc:SimplePanel />
            <TextBox
                Width="100"
                hc:TitleElement.Title="NG"
                Text="{Binding NGPercent, Mode=OneWay, StringFormat=P2}" />-->
        </UniformGrid>
        <hc:Divider
            Grid.Column="1"
            LineStroke="DarkCyan"
            LineStrokeThickness="1"
            Orientation="Vertical" />
        <ItemsControl Grid.Column="2" ItemsSource="{Binding DefectsProduce.QualityNumbersList}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Left"
                            Foreground="{Binding ShowColor.Brush}"
                            Style="{StaticResource tblock}"
                            Text="{Binding Name}" />
                        <TextBlock
                            Margin="10,0"
                            Style="{StaticResource tblock}"
                            Text="{Binding Number}" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
